      .glossary-link { color: inherit; text-decoration: none; border-bottom: 1px dotted #94a3b8; transition: color 0.15s ease, border-color 0.15s ease; }
      .glossary-link:hover { color: var(--teal-text); border-bottom-color: var(--teal-text); }
      body.dark-mode .glossary-link { border-bottom-color: #52525b; }
      body.dark-mode .glossary-link:hover { color: #22d3ee; border-bottom-color: #22d3ee; }
      ::selection { background: rgba(37, 99, 235, 0.22); }
