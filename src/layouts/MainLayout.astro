---
import '@fontsource-variable/inter';
// Preload af latin-varianten (den eneste teksten faktisk bruger ved første
// maling): PageSpeed 27/8 viste fonten sidst i den kritiske kæde (412 ms på
// langsom 4G). font-display:swap er allerede sat, så preload fjerner kun
// swap-blinket — teksten males straks i systemfont og skifter hurtigere.
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import RelatedTools from '../components/RelatedTools.astro';
import { findTool } from '../lib/tools';
import { ikonIndhold } from '../lib/logo.mjs';

// nocanonical: kun til 404-siden. Den bliver serveret på hver eneste adresse,
// der ikke findes, så en canonical ville pege alle døde adresser hen på
// /404/ — en side der ikke selv findes. Ingen canonical er det ærlige svar.
const { title, description, image, imageWidth, imageHeight, schema, noindex, nocanonical } = Astro.props;
const currentPath = Astro.url.pathname;

// Værktøjssider får automatisk relaterede værktøjer nederst. Kun rigtige
// værktøjer rammes — /tools og kategorisiderne har ikke et slug i TOOLS,
// så findTool() giver undefined og blokken springes over.
const toolMatch = currentPath.match(/^\/tools\/([a-z0-9-]+)\/?$/);
const toolSlug = toolMatch && findTool(toolMatch[1]) ? toolMatch[1] : null;
const toolData = toolSlug ? findTool(toolSlug) : null;

// SoftwareApplication er den type Google forstår for et gratis webværktøj.
// price: "0" er ikke pynt — uden en offers-blok med en pris afvises markeringen.
// Vi lover ikke stjerner eller anmeldelser: opdigtede ratings er præcis den
// slags påstand sitet er ved at komme af med.
const toolSchema = toolData ? {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": toolData.title,
  "url": `https://techfeedwatch.com/tools/${toolData.slug}`,
  "description": toolData.description,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Any browser",
  "browserRequirements": "Requires JavaScript",
  "isAccessibleForFree": true,
  // Kun når værktøjet har en rigtig ændringsdato (`updated` i tools.ts).
  ...(toolData.updated ? { "dateModified": toolData.updated } : {}),
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "publisher": { "@type": "Organization", "name": "TechFeedWatch", "url": "https://techfeedwatch.com/" }
} : null;

// Standard SEO beskrivelse hvis ingen er angivet
const defaultDesc = "Straight answers on AI, tech, fintech and crypto. Every article answers a question people actually search for, in plain language. Updated daily.";

// Standard OG-delebillede hvis siden ikke selv angiver et (fx bruger videosider deres thumbnail)
const ogImage = image || "https://techfeedwatch.com/og-default-v3.png";
const ogImageWidth = imageWidth || 1200;
const ogImageHeight = imageHeight || 630;
// Brandsuffikset tilføjes kun hvis der er plads. Google klipper omkring 60-65
// tegn, og artikeltitlerne er allerede søgeords-forrest og lange — med suffiks
// blev 338 sider klippet af, hvilket kostede rigtige ord i søgeresultatet.
const BRAND = "TechFeedWatch";
const TITLE_LIMIT = 60;
const ogTitle = !title
  ? BRAND
  : (title.length + BRAND.length + 3 <= TITLE_LIMIT ? `${title} | ${BRAND}` : title);

// Canonical URL - fortæller Google den originale adresse for hver side (undgår duplikat-fortynding)
const canonicalURL = `https://techfeedwatch.com${currentPath}`;

// og:type = article på artikel- og guide-sider, ellers website
const ogType = (currentPath.startsWith('/video/') || currentPath.startsWith('/guides/')) ? 'article' : 'website';

// NYT: Automatisk Breadcrumb Schema til Google
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Frontpage", "item": "https://techfeedwatch.com/" }
  ]
};

// Bygger dynamisk stien til Google ud fra hvor vi er
if (currentPath.startsWith('/video/')) {
  breadcrumbSchema.itemListElement.push({ "@type": "ListItem", "position": 2, "name": "Video Archive", "item": "https://techfeedwatch.com/library/" });
  if (title) breadcrumbSchema.itemListElement.push({ "@type": "ListItem", "position": 3, "name": title, "item": `https://techfeedwatch.com${currentPath}` });
} else if (currentPath.startsWith('/tag/')) {
  breadcrumbSchema.itemListElement.push({ "@type": "ListItem", "position": 2, "name": "Tags", "item": "https://techfeedwatch.com/" });
  if (title) breadcrumbSchema.itemListElement.push({ "@type": "ListItem", "position": 3, "name": title, "item": `https://techfeedwatch.com${currentPath}` });
} else if (currentPath.startsWith('/tools/')) {
  // Uden denne gren blev brødkrummen "Tools/json formatter" på alle værktøjssider,
  // fordi den generiske gren nedenfor kun fjerner den første skråstreg.
  breadcrumbSchema.itemListElement.push({ "@type": "ListItem", "position": 2, "name": "Free Tools", "item": "https://techfeedwatch.com/tools" });
  if (title) breadcrumbSchema.itemListElement.push({ "@type": "ListItem", "position": 3, "name": title, "item": `https://techfeedwatch.com${currentPath}` });
} else if (currentPath !== '/') {
  // Gør f.eks. '/watch-later' til 'Watch later'
  let sectionName = currentPath === '/watch-later' ? 'read later' : currentPath.replace('/', '').replace(/-/g, ' ');
  sectionName = sectionName.charAt(0).toUpperCase() + sectionName.slice(1);
  breadcrumbSchema.itemListElement.push({ "@type": "ListItem", "position": 2, "name": sectionName, "item": `https://techfeedwatch.com${currentPath}` });
}

// WebSite- + Organization-schema (kun forside): giver Google mulighed for søgefelt-udvidelse (sitelinks searchbox)
const siteSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "TechFeedWatch",
    "alternateName": "Tech Feed Watch",
    "description": "Straight answers on AI, tech, fintech and crypto. Every article answers a question people actually search for, in plain language. Updated daily.",
    "url": "https://techfeedwatch.com/",
    "potentialAction": {
      "@type": "SearchAction",
      "target": { "@type": "EntryPoint", "urlTemplate": "https://techfeedwatch.com/search?q={search_term_string}" },
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@context": "https://schema.org",
    // NewsMediaOrganization frem for Organization (20/9-2026). Hvorfor: de fire
    // politik-felter nedenfor findes kun på denne type, og det er dem, Google
    // bruger til at vurdere, om en udgiver er til at stole på. Sitet udgiver
    // dateret redaktionelt indhold dagligt, krediterer sine kilder og har en
    // offentlig rettelsespolitik — felterne peger på sider, der findes og er sande.
    "@type": "NewsMediaOrganization",
    "@id": "https://techfeedwatch.com/#organization",
    "name": "TechFeedWatch",
    "alternateName": "Tech Feed Watch",
    "url": "https://techfeedwatch.com/",
    "logo": "https://techfeedwatch.com/icon-512.png",
    "email": "info@techfeedwatch.com",
    "address": { "@type": "PostalAddress", "addressCountry": "DK" },
    // sameAs er dét felt Google bruger til at knytte sitet til en profil andre
    // steder. Uden det står sitet som en anonym adresse.
    "sameAs": ["https://x.com/JacobStubbeJS"],
    // Metoden står i prosa på about-siden ("A system I built picks a question…
    // Those articles publish automatically — I do not read every one before it
    // goes live"). Disse fire felter gør den prosa maskinlæsbar.
    "publishingPrinciples": "https://techfeedwatch.com/about",
    "ownershipFundingInfo": "https://techfeedwatch.com/about",
    "correctionsPolicy": "https://techfeedwatch.com/corrections",
    "actionableFeedbackPolicy": "https://techfeedwatch.com/contact",
    "founder": {
      "@type": "Person",
      "name": "Jacob S. Olsen",
      "url": "https://techfeedwatch.com/about",
      "sameAs": ["https://x.com/JacobStubbeJS"]
    }
  }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Mørk tilstand sættes FØR siden tegnes.

        Blinket skyldtes at klassen blev sat af scriptet nederst i dokumentet:
        browseren nåede at tegne en hel lys side, og først derefter blev
        baggrunden mørk. Ved hvert sideskift.

        Dette script er is:inline og står øverst i head, så det kører før
        noget som helst er tegnet. Ingen import, ingen ventetid — derfor
        heller ingen blink. Fejler localStorage (privat tilstand i nogle
        browsere), falder vi tilbage til lys uden at vælte siden. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark') document.documentElement.classList.add('dark-mode-preload');
        } catch (e) {}
      })();
    </script>
    <style is:inline>
      /* Farverne skal gælde allerede før body findes, så den første optegning
         er mørk. Derfor sættes de på html-elementet og arves nedad. */
      html.dark-mode-preload { background: #0b1020; color-scheme: dark; }
      html.dark-mode-preload body { background: #0b1020; color: #f4f2f0; }
    </style>

    <script is:inline>
      /* Én delt, cachet hentning af det slanke videokatalog (videos-lite.json, ~52 KiB gzip; summary afkortet til kortenes 145 tegn).
         PageSpeed 27/8: forsiden hentede den TO gange i den kritiske kæde —
         klokke-badgen og emne-filtret hver sin kopi. Alle forbrugere deler
         nu ét promise; første kald henter, resten genbruger. */
      window.tfwVideos = function () {
        if (!window.__tfwVideosP) window.__tfwVideosP = fetch('/videos-lite.json').then(function (r) { return r.json(); });
        return window.__tfwVideosP;
      };
    </script>
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1020" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={interLatinWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico?v=3" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Forhåndshentning (18/10, Jacob, forslag 2): når fingeren rammer et link, eller musen hviler på det,
        begynder browseren at hente næste side, så den er der næsten med det samme. "prefetch" (kun hente),
        IKKE "prerender" (bygge siden færdig i baggrunden): en forudbygget artikel ville køre sine scripts og
        markere sig som læst/i historikken, selvom man aldrig åbnede den. Chrome/Edge; Safari og Firefox
        ignorerer det. Filer, der ikke er sider (xml/json/feeds), og links i nye faner springes over. */}
    <script type="speculationrules" is:inline set:html={JSON.stringify({
      prefetch: [{
        where: { and: [
          { href_matches: '/*' },
          { not: { href_matches: '/*.xml' } },
          { not: { href_matches: '/*.json' } },
          { not: { href_matches: '/*.txt' } },
          { not: { href_matches: '/cdn-cgi/*' } },
          { not: { selector_matches: '[target=_blank], [download], [rel~=nofollow]' } },
        ] },
        eagerness: 'moderate',
      }],
    })}></script>
    <link rel="preconnect" href="https://img.youtube.com" />
    <link rel="dns-prefetch" href="https://img.youtube.com" />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <title>{ogTitle}</title>
    
    {/*
      Google Consent Mode v2 — SKAL stå før alle Google-tags.
      Alt afvises som udgangspunkt, så AdSense-scriptet nedenfor ikke skriver
      annonce-cookies før brugeren har taget stilling. Et tidligere valg
      genindlæses her, så der ikke går et øjeblik med forkert tilstand.
      Sitet har IKKE sit eget banner. Dialogen kommer fra Googles certificerede
      CMP (Funding Choices). Byg ikke et banner mere — det gav to dialoger oven
      på hinanden sidst. Tilbagetrækning sker via "Cookie settings" i footeren.
    */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500
      });
    </script>

    {/*
      GA4 indlæses først når Googles CMP (Funding Choices, TCF cmpId 300) melder
      at brugeren har givet samtykke til lagring på enheden — TCF-formål 1.
      Sitet har ikke sit eget samtykkebanner: to dialoger oven på hinanden er
      både forvirrende og unødvendigt, når den certificerede allerede kører.
    */}
    <script is:inline>
      (function () {
        var GA_ID = 'G-2C7N1GP697';
        var loaded = false;

        function loadAnalytics() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);
          gtag('js', new Date());
          gtag('config', GA_ID);
        }

        function watchConsent() {
          if (typeof window.__tcfapi !== 'function') return;
          window.__tcfapi('addEventListener', 2, function (tcData, success) {
            if (!success || !tcData) return;
            if (tcData.eventStatus !== 'tcloaded' && tcData.eventStatus !== 'useractioncomplete') return;

            // Uden for GDPR-området gælder ingen samtykkekrav via TCF
            if (tcData.gdprApplies === false) { loadAnalytics(); return; }

            var p = tcData.purpose && tcData.purpose.consents;
            if (p && p[1]) {
              gtag('consent', 'update', { analytics_storage: 'granted' });
              loadAnalytics();
            }
          });
        }

        if (typeof window.__tcfapi === 'function') watchConsent();
        else {
          // CMP'en indlæses asynkront — vent kort på den, og giv så op i stilhed
          var tries = 0;
          var t = setInterval(function () {
            if (typeof window.__tcfapi === 'function') { clearInterval(t); watchConsent(); }
            else if (++tries > 40) clearInterval(t);
          }, 250);
        }
      })();
    </script>

    {/* Scroll- og klikmåling. Svarer på det vi ellers gætter om: når nogen ned
        til bunden af artiklerne, og bliver de relaterede artikler brugt eller
        er de spildplads? Ingen fremmede værktøjer — begivenhederne sendes til
        den Google Analytics der allerede ligger her.

        Alt er stille hvis gtag ikke findes: uden samtykke indlæses den ikke, og
        en måling må aldrig blive årsag til en fejl i konsollen. */}
    <script is:inline>
      (function () {
        function send(navn, data) {
          if (typeof gtag === 'function') gtag('event', navn, data);
        }

        function sidetype(p) {
          if (p === '/' || /^\/page\/\d+/.test(p)) return 'forside';
          if (p.startsWith('/video/')) return 'artikel';
          if (p.startsWith('/tools/')) return 'vaerktoej';
          if (p.startsWith('/guides/')) return 'guide';
          if (p.startsWith('/glossary/')) return 'glossar';
          if (p.startsWith('/tag/')) return 'tag';
          return 'andet';
        }

        document.addEventListener('DOMContentLoaded', function () {
          var type = sidetype(location.pathname);

          // Sitet ruller i en INDRE beholder, ikke i dokumentet. En lytter på
          // window ville aldrig blive kaldt, og målingen ville lydløst vise nul.
          // Beholderen findes ved at spørge hvilken der faktisk KAN rulle.
          function rulleBeholder() {
            var kandidater = [document.scrollingElement].concat(
              [].slice.call(document.querySelectorAll('main, .main-layout, .content-area, body > div'))
            );
            for (var i = 0; i < kandidater.length; i++) {
              var c = kandidater[i];
              if (c && c.scrollHeight > c.clientHeight + 60) return c;
            }
            return document.scrollingElement;
          }

          var beholder = rulleBeholder();
          var vinduet = beholder === document.scrollingElement;
          var naaet = {};
          var maerker = [25, 50, 75, 100];

          function maalScroll() {
            var top = vinduet ? (window.scrollY || document.documentElement.scrollTop) : beholder.scrollTop;
            var hoejde = beholder.scrollHeight - beholder.clientHeight;
            if (hoejde < 200) return;   // for kort side til at sige noget
            var pct = Math.round((top / hoejde) * 100);
            // Bunden måles som "er jeg nede ved den", ikke som 100 procent.
            // Billeder indlæses mens man ruller, så siden vokser undervejs og
            // bunden flytter sig hurtigere end man når den — 100 blev aldrig
            // sendt, selv når læseren stod nederst.
            if (top + beholder.clientHeight >= beholder.scrollHeight - 4) pct = 100;
            for (var i = 0; i < maerker.length; i++) {
              var m = maerker[i];
              // Hvert mærke sendes ÉN gang. Uden det ville én læser der ruller
              // op og ned tælle som tyve.
              if (pct >= m && !naaet[m]) {
                naaet[m] = true;
                send('scroll_depth', { percent: m, page_type: type });
              }
            }
          }

          var venter = false;
          function paaScroll() {
            if (venter) return;
            venter = true;
            requestAnimationFrame(function () { venter = false; maalScroll(); });
          }

          (vinduet ? window : beholder).addEventListener('scroll', paaScroll, { passive: true });
          maalScroll();   // korte sider er allerede "læst" ved indlæsning

          // Siden vokser mens billeder indlæses. Står læseren nederst og
          // kommer der mere til, er hun ikke længere ved bunden — og der
          // kommer aldrig et nyt scroll-event til at måle igen. Derfor måles
          // der også når højden ændrer sig.
          if (typeof ResizeObserver === 'function') {
            new ResizeObserver(paaScroll).observe(beholder);
          }
          window.addEventListener('load', maalScroll);

          // --- Klik, opdelt efter HVOR på siden ---
          // Rækkefølgen betyder noget: den første der passer, vinder. De
          // snævre områder står derfor før de brede, ellers ville alt inde i
          // artiklen blive kaldt "brødtekst".
          var omraader = [
            ['op_naest', '.video-secondary'],
            ['relaterede_artikler', '.related-articles'],
            ['inline_anbefaling', '.tfw-inline-recs, [id*="inline-rec"]'],
            ['relaterede_guides', '.related-guides'],
            ['relaterede_vaerktoejer', '.rt-section, .try-this-tool'],
            ['forfatterboks', '.author-box'],
            ['brodkrumme', '.breadcrumbs-bar, .guide-breadcrumbs'],
            ['emne_chip', '.tag-container, .explore-chips'],
            ['glossar_link', 'a.glossary-link'],
            ['sidemenu', '#sidebar'],
            ['topbar', '.top-navbar'],
            ['sidefod', 'footer'],
            ['broedtekst', '.video-content, .guide-body'],
          ];

          document.addEventListener('click', function (e) {
            var a = e.target.closest ? e.target.closest('a[href]') : null;
            if (!a) return;

            var omraade = 'andet';
            for (var i = 0; i < omraader.length; i++) {
              if (a.closest(omraader[i][1])) { omraade = omraader[i][0]; break; }
            }

            var href = a.getAttribute('href') || '';
            // Udgående links er interessante for sig: et klik til YouTube er et
            // klik VÆK, og det er netop det sitet lover at hjælpe folk med at
            // beslutte. Det er ikke et tab.
            var udgaaende = /^https?:\/\//.test(href) && href.indexOf(location.hostname) === -1;

            send('content_click', {
              area: omraade,
              page_type: type,
              outbound: udgaaende ? 1 : 0,
              link_url: href.slice(0, 100),
            });
          }, { passive: true, capture: true });
        });
      })();
    </script>

    {/* Google AdSense. Bliver i HTML'en så AdSense kan verificere sitet;
        Consent Mode ovenfor forhindrer cookies indtil der er givet samtykke. */}
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9695260339642032" crossorigin="anonymous"></script>


    <meta name="description" content={description || defaultDesc} />
    {!nocanonical && <link rel="canonical" href={canonicalURL} />}
    <link rel="alternate" type="application/rss+xml" title="TechFeedWatch RSS" href="https://techfeedwatch.com/rss.xml" />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="TechFeedWatch" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description || defaultDesc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description || defaultDesc} />
    <meta name="twitter:image" content={ogImage} />

    {/* Indsætter video schema hvis det findes på siden */}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    
    {/* Indsætter vores nye Breadcrumb Schema på alle sider */}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

    {/* WebSite + Organization schema, kun på forsiden */}
    {currentPath === '/' && <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />}
    {toolSchema && <script type="application/ld+json" set:html={JSON.stringify(toolSchema)} />}

    <style is:global>
      /* --teal er brandfarven og bruges til baggrunde, kanter og accenter.
         --teal-text er ét trin mørkere og bruges hvor farven er TEKST: #1d4ed8
         giver 6,4:1 på lys baggrund (WCAG AA kræver 4,5:1).
         I mørk tilstand vendes forholdet, så der bruges en lysere tone. */
      :root { --bg-color: #f8fafc; --text-color: #111; --card-bg: #fff; --border-color: #e5e7eb; --sidebar-bg: #fff; --hover-bg: #f1f5f9; --teal: #2563eb; --teal-text: #1d4ed8; --btn: #6d28d9; --btn-hover: #5b21b6; }
      /* 17/10-2026 nyt farvesæt (Jacob): --teal/--teal-text hedder det samme som før, men er nu sitets BLÅ (links, valgt,
         dekoration). --btn = violet til knapper der gør noget. Hvid tekst på --btn: 7,2:1 (lys) / 5,7:1 (mørk). */
      /* Fintech-blå (#1e3a8a) forsvinder på mørk baggrund; lysere variant kun i mørk tilstand. */
    body.dark-mode [style*="#1e3a8a"] { --tag-accent: #6d9eff !important; --accent: #6d9eff !important; } /* !important: farven står inline på knappen og vinder ellers */
    body.dark-mode { --bg-color: #0b1020; --text-color: #f1f5f9; --card-bg: #121a30; --border-color: #1f2a44; --sidebar-bg: #0b1020; --hover-bg: #18223d; --teal: #2563eb; --teal-text: #67e8f9; --btn: #7c3aed; --btn-hover: #6d28d9; }
      body { background: var(--bg-color); color: var(--text-color); margin: 0; font-family: "Inter Variable", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; transition: background 0.3s, color 0.3s; display: flex; flex-direction: column; height: 100vh; height: 100dvh; overflow: hidden; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; text-rendering: optimizeLegibility; }
      * { -webkit-tap-highlight-color: transparent; }
