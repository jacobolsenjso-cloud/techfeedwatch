      .tfw-progress { position: fixed; top: 0; left: 0; height: 3px; width: 0%; background: linear-gradient(90deg, #2563eb, #22d3ee); z-index: 1100; transition: width 0.1s linear; pointer-events: none; box-shadow: 0 0 8px rgba(37, 99, 235, 0.5); }
      body.shorts-mode .tfw-progress { display: none; }
