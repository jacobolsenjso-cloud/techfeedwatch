    <script is:inline>
      (function () {
        var SLUT = Date.parse('2026-10-24T22:00:00Z'); // = 25/10 kl. 00:00 dansk tid; derefter gør koden intet
        if (!(Date.now() < SLUT)) return;
        var N = 'tfw_nytlogo'; // 'vis' = kendt læser, ikke vist endnu · 'set' = har set den · 'ny' = ny læser
        try {
          var s = localStorage.getItem(N);
          if (s === null) {
            // Første gang koden kører hos læseren. Den kører før klokken gemmer noget, så sporene herunder
            // stammer fra et TIDLIGERE besøg - altså én der har set det gamle logo.
            var spor = ['tfw_notif_since', 'tfw_notif_seen', 'tfw_read', 'tfw_follow', 'videoHistory', 'watchLater'];
            s = spor.some(function (k) { return localStorage.getItem(k) !== null; }) ? 'vis' : 'ny';
            localStorage.setItem(N, s);
          }
          if (s !== 'vis') return;
        } catch (e) { return; } // ingen adgang til lager (fx privat vindue) -> ingen boble
        var logo = document.querySelector('#mainHeader .logo');
