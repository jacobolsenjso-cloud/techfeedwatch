          '.nytlogo-boble::before{content:"";position:absolute;top:-6px;left:12px;width:12px;height:12px;background:inherit;transform:rotate(45deg);border-radius:2px}' +
          '.nytlogo-boble button{flex-shrink:0;width:28px;height:28px;border:0;border-radius:8px;background:rgba(255,255,255,.15);color:#fff;font-size:1.1rem;line-height:1;cursor:pointer}' +
          '.nytlogo-boble button:hover,.nytlogo-boble button:focus-visible{background:rgba(255,255,255,.3)}' +
          '@keyframes nytlogoInd{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}' +
          '@media (prefers-reduced-motion:reduce){.nytlogo-boble{animation:none}}';
        document.head.appendChild(st);
        var b = document.createElement('div');
        b.className = 'nytlogo-boble';
        b.setAttribute('role', 'status');
        b.innerHTML = '<span>&#128075; New look &mdash; same TechFeedWatch.</span><button type="button" aria-label="Dismiss">&times;</button>';
        b.style.left = logo.offsetLeft + 'px'; // pilen peger på ikonet, også på mobil hvor ☰ står før logoet
        b.style.maxWidth = 'min(380px, calc(100vw - ' + Math.round(logo.getBoundingClientRect().left + 16) + 'px))'; // aldrig ud over skærmkanten
        logo.parentNode.appendChild(b);
        var luk = function () { b.remove(); document.removeEventListener('keydown', esc); };
        var esc = function (e) { if (e.key === 'Escape') luk(); };
        b.querySelector('button').addEventListener('click', luk);
        document.addEventListener('keydown', esc);
      })();
    </script>

