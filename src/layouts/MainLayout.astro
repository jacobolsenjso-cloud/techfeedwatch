    <script is:inline>
      (function () {
        var link = document.getElementById('cookieSettingsLink');
        var sep = document.getElementById('cookieSettingsSep');
        if (!link) return;

        function enable() {
          link.hidden = false;
          if (sep) sep.hidden = false;
          link.addEventListener('click', function (e) {
            e.preventDefault();
            try { window.googlefc.showRevocationMessage(); } catch (err) {}
          });
        }

        if (window.googlefc && typeof window.googlefc.showRevocationMessage === 'function') enable();
        else {
          var tries = 0;
          var t = setInterval(function () {
            if (window.googlefc && typeof window.googlefc.showRevocationMessage === 'function') {
              clearInterval(t); enable();
            } else if (++tries > 40) clearInterval(t);
          }, 250);
        }
      })();
    </script>

    {/* Googles privatliv-ikon (skjoldet nederst til venstre) kommer med en
        talebobble, "Indstillinger for privatliv og cookies", som Google folder
        ud på hver side efter samtykke. Google husker ikke at man har lukket den,
        og i Brave folder den aldrig sammen. Vi skjuler kun boblen — skjoldet
        bliver, så brugeren stadig kan fortryde sit samtykke via Googles egen vej.
        Ikonet ligger i en åben shadow DOM på en anonym <div> sidst i <body>, så
        almindelig CSS når det ikke; stilen skal ind i selve shadow-roden. */}
    <script is:inline>
      (function () {
        var CSS = '#ft-reg-bubble{display:none!important}';
        var done = false;

        function tryHost(el) {
          if (done || !el || el.nodeType !== 1 || !el.shadowRoot) return false;
          if (!el.shadowRoot.querySelector('#ft-floating-toolbar')) return false;
          var s = document.createElement('style');
          s.textContent = CSS;
          el.shadowRoot.appendChild(s);
          done = true;
          return true;
        }

        function scan() {
          var kids = document.body ? document.body.children : [];
          for (var i = kids.length - 1; i >= 0; i--) if (tryHost(kids[i])) return true;
          return false;
        }

        // Google hænger shadow-roden på lidt efter at div'en er sat ind, så en
        // enkelt observation er ikke nok — vi kigger igen et par gange.
        function watch(el) {
          var n = 0;
          var t = setInterval(function () {
            if (tryHost(el) || ++n > 20) clearInterval(t);
          }, 250);
        }

        if (!scan() && 'MutationObserver' in window) {
          var mo = new MutationObserver(function (muts) {
            if (done) { mo.disconnect(); return; }
            muts.forEach(function (m) {
              Array.prototype.forEach.call(m.addedNodes, function (node) {
                if (node.nodeType === 1 && node.tagName === 'DIV' && node.parentNode === document.body) watch(node);
              });
            });
          });
          mo.observe(document.body, { childList: true });
          setTimeout(function () { mo.disconnect(); }, 30000);
        }
      })();
    </script>

    {/* Service worker: giver den installerede app en offline-side i stedet for
        browserens fejlside. Registreres efter load, så den ikke konkurrerer med
        sidens egne ressourcer om båndbredden. */}
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          // updateViaCache: 'none' — hent ALTID sw.js fra netværket, aldrig fra
          // HTTP-cachen. Cloudflare Pages lader os ikke sætte Cache-Control på
          // statiske filer via _headers (den bliver overskrevet til 4 timer),
          // så uden det her kunne en bruger sidde fast på en gammel worker.
          navigator.serviceWorker
            .register('/sw.js', { scope: '/', updateViaCache: 'none' })
            .catch(function () { /* uden service worker fungerer sitet fint */ });
        });
      }
    </script>

    {/* Push-beskeder (17/10-2026, Jacob: A = højst 1 om dagen). Tegner knappen i alle [data-push-felt]
        (klokken + emnesider). iPhone/iPad kan kun få beskeder fra en installeret app (Apples regel),
        så dér vises en trin-for-trin-guide til "Add to Home Screen" i stedet for knappen. */}
    <script is:inline>
      (function () {
        var API = 'https://tfw-push.jacobolsenjso.workers.dev';
        var VAPID = 'BNhpaYf1xBOH0e0xaHoFpvv6XPePgbpRCIFZvbk5yo4pjQPkcFK4joNGzkHRfGlKpGWKkksUSpvsWxvq7pPdF_g';
        var laes = function (k) { try { return JSON.parse(localStorage.getItem(k)); } catch (e) { return null; } };
        var iOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
        var installeret = (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) || navigator.standalone === true;
        var kan = 'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window;
        var travl = false, fejltekst = '';

        function tilstand() {
          if (iOS && !installeret) return 'ios';
          if (!kan) return 'ikke';
          if (Notification.permission === 'denied') return 'blokeret';
          return laes('tfw_push') ? 'til' : 'fra';
        }
        function noegle() {
          var s = VAPID.replace(/-/g, '+').replace(/_/g, '/'); s += '='.repeat((4 - s.length % 4) % 4);
          var r = atob(s), u = new Uint8Array(r.length); for (var i = 0; i < r.length; i++) u[i] = r.charCodeAt(i); return u;
        }
        function sw() {
          // ready venter på service workeren - men aldrig for evigt, hvis den ikke kunne registreres.
          return Promise.race([navigator.serviceWorker.ready, new Promise(function (_, nej) { setTimeout(function () { nej(new Error('sw')); }, 8000); })]);
        }
        function send(sti, data) {
          return fetch(API + sti, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(data) })
            .then(function (r) { if (!r.ok) throw new Error(sti + ' ' + r.status); });
        }
        function tilmeld() {
          return Notification.requestPermission().then(function (svar) {
            if (svar !== 'granted') return;
            return sw().then(function (reg) {
              return reg.pushManager.getSubscription().then(function (s) {
                return s || reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: noegle() });
              });
            }).then(function (s) {
              return send('/subscribe', { subscription: s.toJSON(), topics: laes('tfw_follow') || [] });
            }).then(function () { localStorage.setItem('tfw_push', '1'); husk(); });
          });
        }
        // Husk hvilken push-adresse tfw-push kender, og hvornår (review 17/10: browsere kan skifte adressen).
        function husk() {
          return sw().then(function (reg) { return reg.pushManager.getSubscription(); }).then(function (s) {
            if (s) localStorage.setItem('tfw_push_synk', JSON.stringify({ ep: s.endpoint, t: Date.now() }));
          }).catch(function () {});
        }
        function synk() {
          if (!kan || !laes('tfw_push') || Notification.permission !== 'granted') return;
          sw().then(function (reg) { return reg.pushManager.getSubscription(); }).then(function (s) {
            if (!s) { localStorage.removeItem('tfw_push'); tegn(); return; }
            var sidst = laes('tfw_push_synk') || {};
            if (sidst.ep === s.endpoint && Date.now() - (sidst.t || 0) < 7 * 864e5) return;
            return send('/subscribe', { subscription: s.toJSON(), topics: laes('tfw_follow') || [] }).then(husk);
          }).catch(function () {});
        }
        function afmeld() {
          return sw().then(function (reg) { return reg.pushManager.getSubscription(); }).then(function (s) {
            if (!s) return;
            return send('/unsubscribe', { endpoint: s.endpoint }).catch(function () {}).then(function () { return s.unsubscribe(); });
          }).then(function () { localStorage.removeItem('tfw_push'); localStorage.removeItem('tfw_push_synk'); });
        }
        // Når læseren følger/afmelder emner, får tfw-push den nye liste (kun hvis beskeder er slået til).
        function opdaterEmner() {
          if (!laes('tfw_push') || !kan) return;
          sw().then(function (reg) { return reg.pushManager.getSubscription(); }).then(function (s) {
            if (!s) { localStorage.removeItem('tfw_push'); tegn(); return; }
            return send('/subscribe', { subscription: s.toJSON(), topics: laes('tfw_follow') || [] }).then(husk);
          }).catch(function () {});
        }
        var TEKST = {
          fra: '<button type="button" class="push-knap" data-push-handling="til">🔔 Get a daily notification</button><span class="push-note">At most one a day, from the topics you follow. Turn it off anytime.</span>',
          til: '<span class="push-on">✓ Daily notification is on</span><button type="button" class="push-link" data-push-handling="fra">Turn off</button>',
          blokeret: '<span class="push-note">Notifications are blocked for this site. Allow them in your browser\'s site settings to get a daily notification.</span>',
          ikke: '<span class="push-note">This browser can\'t show notifications. They work in Chrome, Edge, Firefox and Safari (macOS 13 or newer).</span>',
          ios: '<details class="push-ios"><summary>📲 Get notifications on iPhone or iPad</summary><p>Apple only allows notifications from installed apps. Install TechFeedWatch as an app in three steps - it\'s free and takes 10 seconds:</p><ol><li>Tap the <strong>Share</strong> button (the square with an arrow) at the bottom of Safari.</li><li>Choose <strong>Add to Home Screen</strong>, then tap <strong>Add</strong>.</li><li>Open <strong>TechFeedWatch</strong> from your home screen, tap 🔔 and choose <strong>Get a daily notification</strong>.</li></ol></details>',
        };
        function tegn() {
          var t = tilstand(), html = TEKST[t] + (fejltekst ? '<span class="push-fejl">' + fejltekst + '</span>' : '');
          document.querySelectorAll('[data-push-felt]').forEach(function (el) { el.innerHTML = html; el.setAttribute('data-push-tilstand', t); el.hidden = false; });
        }
        document.addEventListener('click', function (e) {
          var k = e.target.closest && e.target.closest('[data-push-handling]'); if (!k || travl) return;
          e.stopPropagation();
          travl = true; fejltekst = ''; k.disabled = true;
          (k.getAttribute('data-push-handling') === 'til' ? tilmeld() : afmeld())
            .catch(function () { fejltekst = 'Something went wrong - please try again.'; })
            .then(function () { travl = false; tegn(); });
        });
        document.addEventListener('tfw-follow-aendret', opdaterEmner);
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', tegn); else tegn();
        // Har læseren slået beskeder fra i browseren, rydder vi op, så knappen viser det rigtige.
        if (kan && laes('tfw_push') && Notification.permission !== 'granted') { localStorage.removeItem('tfw_push'); }
        setTimeout(synk, 5000); // efter siden er færdig - konkurrerer ikke med indholdet
      })();
    </script>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const themeBtn = document.getElementById('themeToggle');
        const body = document.body;
        const updateIcon = () => { if(themeBtn) themeBtn.textContent = body.classList.contains('dark-mode') ? '☀️' : '🌙'; };
        // Klassen er allerede sat af scriptet lige efter <body>. Her sættes kun
        // ikonet, så knappen viser den rigtige tilstand.
        updateIcon();
        if (themeBtn) {
          themeBtn.addEventListener('click', () => {
            const dark = body.classList.toggle('dark-mode');
            localStorage.setItem('theme', dark ? 'dark' : 'light');
            // html-klassen holdes i sync, så NÆSTE sideskift starter i den
            // rigtige farve. Uden det ville et skift til mørk stadig blinke
            // hvidt på den efterfølgende side.
            document.documentElement.classList.toggle('dark-mode-preload', dark);
            updateIcon();
          });
        }
        
        const searchBtn = document.getElementById('searchBtn');
        const closeSearchBtn = document.getElementById('closeSearchBtn');
        const searchOverlay = document.getElementById('searchOverlay');
        if(searchBtn && closeSearchBtn && searchOverlay) {
          searchBtn.addEventListener('click', () => {
            searchOverlay.classList.add('active');
            searchBtn.setAttribute('aria-expanded', 'true');
          });
          closeSearchBtn.addEventListener('click', () => {
            searchOverlay.classList.remove('active');
            searchBtn.setAttribute('aria-expanded', 'false');
          });
        }

        // Global søgning: instant-forslag i dropdown lige under søgefeltet (+ Enter = fuld søgeside)
        const topSearchInput = document.getElementById('topSearchInput');
        const searchSuggest = document.getElementById('searchSuggest');
        if (searchBtn && topSearchInput) {
          searchBtn.addEventListener('click', () => setTimeout(() => topSearchInput.focus(), 30));
        }
        if (topSearchInput && searchSuggest) {
          let sData = null, sLoading = false, activeIdx = -1;
          // Værktøjer, glossar, guides og emner (search-pages.json). Uden dem fandt
          // søgningen fx aldrig "Hreflang Generator" (Jacob, 24/9-2026).
          let sPages = [];
          const sNorm = (s) => String(s || '').toLowerCase().replace(/&/g, ' and ').replace(/[^a-z0-9#+.]+/g, ' ');
          const sPasser = (tekst, ord) => { const h = sNorm(tekst); return ord.every((w) => h.includes(w)); };
          const escHtml = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
          const hideSuggest = () => { searchSuggest.classList.remove('active'); searchSuggest.innerHTML = ''; activeIdx = -1; };
          const goSearch = () => { const q = topSearchInput.value.trim(); if (q) window.location.href = '/search?q=' + encodeURIComponent(q); };

          const loadData = () => {
            if (sData || sLoading) return;
            sLoading = true;
            Promise.all([
              window.tfwVideos(),
              fetch('/search-pages.json').then((r) => r.json()).catch(() => []),
            ]).then(([d, p]) => { sData = d; sPages = Array.isArray(p) ? p : []; sLoading = false; if (document.activeElement === topSearchInput) renderSuggest(); }).catch(() => { sLoading = false; });
          };

          const renderSuggest = () => {
            activeIdx = -1;
            const q = topSearchInput.value.toLowerCase().trim();
            if (!q) { hideSuggest(); return; }
            if (!sData) { loadData(); searchSuggest.innerHTML = '<div class="search-suggest-empty">Searching…</div>'; searchSuggest.classList.add('active'); return; }
            // Alle ord skal findes, i vilkårlig rækkefølge.
            const ord = sNorm(q).split(' ').filter(Boolean);
            const sideHits = sPages.filter((p) => sPasser(p.title + ' ' + p.text + ' ' + p.type, ord))
              .sort((a, b) => (sPasser(a.title, ord) ? 0 : 1) - (sPasser(b.title, ord) ? 0 : 1)).slice(0, 3);
            const matches = sData.filter((v) => sPasser((v.title || '') + ' ' + (v.summary || '') + ' ' + (v.tags || []).join(' '), ord)).slice(0, 7 - sideHits.length);
            if (!matches.length && !sideHits.length) { searchSuggest.innerHTML = '<div class="search-suggest-empty">No matches. Press Enter to search anyway.</div>'; searchSuggest.classList.add('active'); return; }
            let html = sideHits.map((p) => (
              '<a class="search-suggest-item" href="' + p.url + '">' +
                '<span class="search-suggest-icon" aria-hidden="true">' + escHtml(p.icon || '') + '</span>' +
                '<span class="search-suggest-body">' +
                  '<span class="search-suggest-title">' + escHtml(p.title) + '</span>' +
                  '<span class="search-suggest-badge">' + escHtml(p.type === 'Tools' ? 'Tool category' : p.type) + '</span>' +
                '</span>' +
              '</a>'
            )).join('') + matches.map((v) => (
              '<a class="search-suggest-item" href="/video/' + v.slug + '/">' +
                '<img class="search-suggest-thumb" src="/kort/' + v.slug + '.webp" alt="" loading="lazy">' +
                '<span class="search-suggest-body">' +
                  '<span class="search-suggest-title">' + escHtml(v.title) + '</span>' +
                  (v.isShort ? '<span class="search-suggest-badge">⚡ Short</span>' : '') +
                '</span>' +
              '</a>'
            )).join('');
            html += '<a class="search-suggest-footer" href="/search?q=' + encodeURIComponent(topSearchInput.value.trim()) + '">See all results →</a>';
            searchSuggest.innerHTML = html;
            searchSuggest.classList.add('active');
          };

          topSearchInput.addEventListener('focus', loadData);
          topSearchInput.addEventListener('input', renderSuggest);
          topSearchInput.addEventListener('keydown', (e) => {
            const items = Array.from(searchSuggest.querySelectorAll('.search-suggest-item, .search-suggest-footer'));
            if (e.key === 'ArrowDown' && items.length) { e.preventDefault(); activeIdx = Math.min(activeIdx + 1, items.length - 1); items.forEach((el, i) => el.classList.toggle('is-active', i === activeIdx)); items[activeIdx].scrollIntoView({ block: 'nearest' }); }
            else if (e.key === 'ArrowUp' && items.length) { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, 0); items.forEach((el, i) => el.classList.toggle('is-active', i === activeIdx)); items[activeIdx].scrollIntoView({ block: 'nearest' }); }
            else if (e.key === 'Enter') { if (activeIdx >= 0 && items[activeIdx]) { window.location.href = items[activeIdx].getAttribute('href'); } else { goSearch(); } }
            else if (e.key === 'Escape') { hideSuggest(); }
          });
          document.addEventListener('click', (e) => { if (!searchSuggest.contains(e.target) && e.target !== topSearchInput) hideSuggest(); });
        }

        // Notifikations-klokke (ny 17/10-2026, A-D): rigtigt "ulæst", følg emner, grupperet liste, første besøg.
        // Alt gemmes i læserens egen browser (localStorage) - ingen login, intet sendes til os.
        //  tfw_read         = artikler læseren har ÅBNET (læst). Åbning af panelet markerer ikke længere alt som læst.
        //  tfw_follow       = emner læseren følger. Tallet tæller kun dem (tom liste = alle emner).
        //  tfw_notif_since  = dato fra hvornår artikler kan tælle som nye for denne læser.
        //  tfw_follow_hint  = "1" når læseren har lukket "Follow topics?"-tippet.
        const notifBtn = document.getElementById('notifBtn');
        const notifPanel = document.getElementById('notifPanel');
        const notifList = document.getElementById('notifList');
        const notifBadge = document.getElementById('notifBadge');
        const notifMarkRead = document.getElementById('notifMarkRead');
        const notifTopicsBtn = document.getElementById('notifTopicsBtn');
        const notifTopics = document.getElementById('notifTopics');
        const notifHint = document.getElementById('notifHint');
        const nLaes = (k, std) => { try { const v = JSON.parse(localStorage.getItem(k)); return v === null ? std : v; } catch (e) { return std; } };
        const nGem = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} };
        const nMarkerLaest = (slug) => { const r = nLaes('tfw_read', []); if (r.indexOf(slug) === -1) { r.unshift(slug); nGem('tfw_read', r.slice(0, 300)); } };
        // A: åbner man en artikel, er den læst - også uden at have åbnet klokken.
        const nSti = location.pathname.match(/^\/video\/([^/]+)\/?$/);
        if (nSti) nMarkerLaest(decodeURIComponent(nSti[1]));

        if (notifBtn && notifPanel && notifList && notifBadge) {
          const nEsc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
          const nIdag = () => { const d = new Date(); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); };
          const nDageSiden = (dato) => Math.round((new Date(nIdag() + 'T00:00:00') - new Date(String(dato).slice(0, 10) + 'T00:00:00')) / 86400000);
          const nDato = (d) => { try { return new Date(String(d).slice(0, 10) + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' }); } catch (e) { return ''; } };
          const nEmne = (a) => (a.tags && a.tags[0]) || '';
          // Følger læseren et af artiklens mærker? (alle mærker tæller - Automation står fx altid som 2. mærke)
          const nFulgtMaerke = (a, folg) => (a.tags || []).filter((x) => folg.indexOf(x) !== -1)[0] || '';
          let nArtikler = [], nUlaest = [], nEmner = [];

          const nBeregn = () => {
            const laest = nLaes('tfw_read', []);
            const since = nLaes('tfw_notif_since', '');
            const folg = nLaes('tfw_follow', []);
            // Kun de sidste 14 dage kan tælle som nye - ellers vokser tallet uendeligt hos en sjælden gæst.
            nUlaest = nArtikler.filter((a) => laest.indexOf(a.slug) === -1 && String(a.date).slice(0, 10) >= since && nDageSiden(a.date) <= 14)
              .filter((a) => !folg.length || nFulgtMaerke(a, folg)).map((a) => a.slug);
            if (nUlaest.length) { notifBadge.textContent = nUlaest.length > 9 ? '9+' : String(nUlaest.length); notifBadge.hidden = false; }
            else notifBadge.hidden = true;
            notifBtn.setAttribute('aria-label', nUlaest.length ? nUlaest.length + ' unread articles' : 'New articles');
          };

          const nTegnEmner = () => {
            if (!notifTopics) return;
            const folg = nLaes('tfw_follow', []);
            notifTopics.innerHTML = '<p class="notif-topics-lead">Count only articles from topics you follow:</p><div class="notif-chips">' +
              nEmner.concat(folg.filter((e) => nEmner.indexOf(e) === -1)).map((e) => '<button type="button" class="notif-chip" data-emne="' + nEsc(e) + '" aria-pressed="' + (folg.indexOf(e) !== -1) + '">' + nEsc(e) + '</button>').join('') + '</div>';
            if (notifTopicsBtn) notifTopicsBtn.textContent = folg.length ? 'Topics (' + folg.length + ')' : 'Topics';
          };

          const nTegn = () => {
            const laest = nLaes('tfw_read', []);
            const folg = nLaes('tfw_follow', []);
            if (notifHint) notifHint.hidden = !!folg.length || nLaes('tfw_follow_hint', '') === '1';
            if (!nArtikler.length) { notifList.innerHTML = '<div class="notif-empty">No new articles yet - check back soon!</div>'; return; }
            const grupper = [['Today', []], ['This week', []], ['Earlier', []]];
            nArtikler.slice(0, 15).forEach((a) => { const d = nDageSiden(a.date); grupper[d <= 0 ? 0 : d <= 7 ? 1 : 2][1].push(a); });
            // B: inden for hver gruppe står de emner, man følger, øverst.
            const fulgt = (a) => (folg.length && nFulgtMaerke(a, folg) ? 0 : 1);
            notifList.innerHTML = grupper.filter((g) => g[1].length).map((g) =>
              '<div class="notif-group">' + g[0] + '</div>' + g[1].slice().sort((x, y) => fulgt(x) - fulgt(y)).map((a) => {
                const ny = laest.indexOf(a.slug) === -1 && nUlaest.indexOf(a.slug) !== -1;
                const uFulgt = folg.length && fulgt(a) === 1;
                const meta = [nFulgtMaerke(a, folg) || nEmne(a), a.minutesRead ? a.minutesRead + ' min read' : '', nDato(a.date)].filter(Boolean).map(nEsc).join(' · ');
                return '<a class="notif-item' + (ny ? ' is-new' : '') + (uFulgt ? ' is-other' : '') + '" href="/video/' + encodeURIComponent(a.slug) + '/">' +
                  '<img class="notif-thumb" src="/kort/' + encodeURIComponent(a.slug) + '.webp" alt="" loading="lazy" width="72" height="44">' +
                  '<span class="notif-body"><span class="notif-title">' + nEsc(a.title) + '</span><span class="notif-date">' + meta + '</span></span>' +
                  (ny ? '<span class="notif-newdot" aria-label="Unread"></span>' : '') + '</a>';
              }).join('')).join('');
          };

          const startNotifData = () => window.tfwVideos().then((all) => {
            nArtikler = all.filter((v) => !v.isShort).sort((a, b) => new Date(b.date) - new Date(a.date)).slice(0, 40);
            const taelle = {};
            all.forEach((v) => (v.tags || []).forEach((e) => { if (e) taelle[e] = (taelle[e] || 0) + 1; }));
            nEmner = Object.keys(taelle).sort((x, y) => taelle[y] - taelle[x]);
            if (!nLaes('tfw_notif_since', '')) {
              const gammel = nLaes('tfw_notif_seen', null);
              if (gammel) {
                // Læser fra før 17/10: det, de allerede har set i den gamle klokke, tæller som læst.
                nGem('tfw_read', gammel.concat(nLaes('tfw_read', [])).slice(0, 300));
                nGem('tfw_notif_since', '2000-01-01');
              } else {
                // D: første besøg - den seneste udgivelsesdags artikler tæller som nye.
                nGem('tfw_notif_since', nArtikler.length ? String(nArtikler[0].date).slice(0, 10) : nIdag());
              }
            }
            nBeregn(); nTegnEmner(); nTegn();
          }).catch(() => {});
          if ('requestIdleCallback' in window) requestIdleCallback(() => startNotifData(), { timeout: 4000 });
          else setTimeout(startNotifData, 2500);

          notifBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const open = notifPanel.classList.toggle('active');
            notifBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
            if (open) nTegn(); // A: at åbne panelet markerer IKKE længere alt som læst
          });
          if (notifMarkRead) notifMarkRead.addEventListener('click', (e) => {
            e.stopPropagation();
            nGem('tfw_read', nUlaest.concat(nLaes('tfw_read', [])).slice(0, 300));
            nBeregn(); nTegn();
          });
          const aabnEmner = (vis) => { if (!notifTopics || !notifTopicsBtn) return; notifTopics.hidden = !vis; notifTopicsBtn.setAttribute('aria-expanded', vis ? 'true' : 'false'); if (vis && notifHint) { nGem('tfw_follow_hint', '1'); notifHint.hidden = true; } };
          if (notifTopicsBtn) notifTopicsBtn.addEventListener('click', (e) => { e.stopPropagation(); aabnEmner(notifTopics.hidden); });
          if (notifTopics) notifTopics.addEventListener('click', (e) => {
            e.stopPropagation();
            const knap = e.target.closest('.notif-chip'); if (!knap) return;
            const emne = knap.getAttribute('data-emne'); let folg = nLaes('tfw_follow', []);
            folg = folg.indexOf(emne) === -1 ? folg.concat(emne) : folg.filter((x) => x !== emne);
            nGem('tfw_follow', folg); nBeregn(); nTegnEmner(); nTegn();
            document.dispatchEvent(new CustomEvent('tfw-follow-aendret')); // push-tilmeldingen får de nye emner
          });
          if (notifHint) notifHint.addEventListener('click', (e) => {
            e.stopPropagation();
            if (e.target.closest('.notif-hint-ja')) aabnEmner(true);
            if (e.target.closest('.notif-hint-ja') || e.target.closest('.notif-hint-luk')) { nGem('tfw_follow_hint', '1'); notifHint.hidden = true; }
          });
          document.addEventListener('click', (e) => {
            if (!notifPanel.contains(e.target) && !notifBtn.contains(e.target)) { notifPanel.classList.remove('active'); notifBtn.setAttribute('aria-expanded', 'false'); }
          });
          // Følg-knappen på en emneside (17/10) siger til her, så tallet og knapperne passer med det samme.
          document.addEventListener('tfw-follow-aendret', () => { if (nArtikler.length) { nBeregn(); nTegnEmner(); nTegn(); } });
          // Læser man en artikel i en anden fane, opdateres tallet, når man kommer tilbage.
          document.addEventListener('visibilitychange', () => { if (!document.hidden && nArtikler.length) { nBeregn(); nTegn(); } });
        }
        
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const sidebar = document.getElementById('sidebar');
        if (mobileMenuBtn && sidebar) {
          mobileMenuBtn.addEventListener('click', () => {
            const isOpen = sidebar.classList.toggle('open');
            mobileMenuBtn.setAttribute('aria-expanded', isOpen);
          });
        }

        // "Til toppen"-knap: kun mobil, kun når der er scrollet forbi 400px.
        // Siden scroller i .content-area, ikke window - lyt/scroll på det rigtige element.
        const scrollTopBtn = document.getElementById('scrollTopBtn');
        const scrollContainer = document.querySelector('.content-area') || window;
        if (scrollTopBtn) {
          const getScrollTop = () => (scrollContainer === window ? window.scrollY : scrollContainer.scrollTop);
          const getScrollHeight = () => (scrollContainer === window ? document.documentElement.scrollHeight : scrollContainer.scrollHeight);
          const getClientHeight = () => (scrollContainer === window ? window.innerHeight : scrollContainer.clientHeight);
          const updateScrollTopBtn = () => {
            const scrollTop = getScrollTop();
            // Skjul knappen når footeren er inden for synsvidde, så den ikke overlapper footer-teksten
            const nearBottom = scrollTop + getClientHeight() >= getScrollHeight() - 120;
            const shouldShow = scrollTop > 400 && !nearBottom;
            scrollTopBtn.classList.toggle('visible', shouldShow);
          };
          scrollContainer.addEventListener('scroll', updateScrollTopBtn);
          window.addEventListener('resize', updateScrollTopBtn);
          updateScrollTopBtn();

          scrollTopBtn.addEventListener('click', () => {
            scrollContainer.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }

        // Læse-progressbar i toppen: fyldes ud fra hvor langt der er scrollet i indholdet.
        const progressBar = document.getElementById('tfwProgress');
        if (progressBar) {
          const updateProgress = () => {
            const st = scrollContainer === window ? window.scrollY : scrollContainer.scrollTop;
            const sh = scrollContainer === window ? document.documentElement.scrollHeight : scrollContainer.scrollHeight;
            const ch = scrollContainer === window ? window.innerHeight : scrollContainer.clientHeight;
            const max = sh - ch;
            const pct = max > 0 ? (st / max) * 100 : 0;
            progressBar.style.width = pct + '%';
          };
          scrollContainer.addEventListener('scroll', updateProgress, { passive: true });
          window.addEventListener('resize', updateProgress);
          updateProgress();
        }

        // Subtile scroll-reveals: kort fader blidt ind når de scrolles i syne. Kun sikre kort-selektorer (ingen fixed/sticky).
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if ('IntersectionObserver' in window && !prefersReduced) {
          const revealEls = document.querySelectorAll('.watch-card, .glossary-card, .guide-index-card, .related-guide-card, .guide-card');
          if (revealEls.length) {
            const revealRoot = (scrollContainer && scrollContainer !== window) ? scrollContainer : null;
            const revObserver = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  const el = entry.target;
                  el.classList.add('is-visible');
                  revObserver.unobserve(el);
                  setTimeout(() => el.classList.remove('tfw-reveal', 'is-visible'), 450);
                }
              });
            }, { root: revealRoot, rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
            // 18/10 (forslag 4): kort, der allerede er på skærmen, når siden åbner, vises med det samme. Før blev
            // de gjort usynlige og tonet frem bagefter - et blink lige efter hvert sideskift, og under en blød
            // overgang tonede siden over i tomme felter. Kun kort længere nede toner frem, når man ruller.
            const skaermBund = window.innerHeight;
            revealEls.forEach((el) => {
              if (el.getBoundingClientRect().top < skaermBund) return;
              el.classList.add('tfw-reveal');
              revObserver.observe(el);
            });
          }
        }

        // Skeleton: fjern shimmer når et thumbnail er hentet. Capture-fasen fanger også dynamisk tilføjede kort (søgning, history, watch-later).
        const markThumbLoaded = (img) => {
          const t = img.closest && img.closest('.watch-card-thumb, .short-card-thumb');
          if (t) t.classList.add('is-loaded');
        };
        document.addEventListener('load', (e) => { if (e.target && e.target.tagName === 'IMG') markThumbLoaded(e.target); }, true);
        document.addEventListener('error', (e) => { if (e.target && e.target.tagName === 'IMG') markThumbLoaded(e.target); }, true);
        document.querySelectorAll('.watch-card-thumb img, .short-card-thumb img').forEach((img) => {
          if (img.complete && img.naturalWidth > 0) markThumbLoaded(img);
        });
      });
    </script>
    <script is:inline>
      document.addEventListener('click', (event) => {
        const sidebar = document.getElementById('sidebar');
        const menuButton = document.getElementById('mobileMenuBtn');

        // Hvis vi klikker uden for sidebaren og knappen
        if (sidebar && !sidebar.contains(event.target) && menuButton && !menuButton.contains(event.target)) {
          
          // Luk menuen ved at fjerne 'open' classen
          sidebar.classList.remove('open'); 
          menuButton.setAttribute('aria-expanded', 'false');
        }
      });
      // Selve siden må aldrig rulle — kun .content-area (14/10). På telefoner er 100vh højere end
      // skærmen (adresselinjen), og et hop til en overskrift rullede så hele siden ~56 px op, så
      // overskriften gemte sig under topbaren. body bruger nu 100dvh; dette er sikringen til ældre browsere.
      // Nulstil først når AL rulning er stoppet (capture fanger også .content-area): midt i et blødt
      // hop afbryder en nulstilling ellers hoppet (målt 14/10).
      let rodTimer;
      document.addEventListener('scroll', () => {
        const s = document.scrollingElement;
        if (!s || s.scrollTop === 0) return;
        clearTimeout(rodTimer);
        rodTimer = setTimeout(() => { s.scrollTop = 0; }, 250);
      }, { passive: true, capture: true });

      // Tryk-effekt på kort (18/10, Jacob): på telefon løfter kortet sig blødt under fingeren (CSS: .tryk).
      // 60 ms forsinkelse: begynder fingeren at rulle i stedet, melder browseren pointercancel først, og
      // kortet bliver liggende - ellers ville hvert kort, man ruller forbi, hoppe. Et hurtigt tryk (pointerup
      // før de 60 ms) løfter med det samme, så effekten også ses, mens den nye side indlæses.
      // Kun berøring og pen: computeren har allerede sit eget løft ved hover.
      (() => {
        const KORT = '.watch-card, .cinema-card, .inline-recs-card';
        let kort = null, timer = 0;
        const slip = () => { clearTimeout(timer); timer = 0; if (kort) kort.classList.remove('tryk'); kort = null; };
        document.addEventListener('pointerdown', (e) => {
          if (e.pointerType === 'mouse') return;
          slip();
          kort = e.target.closest ? e.target.closest(KORT) : null;
          if (kort) { const k = kort; timer = setTimeout(() => { timer = 0; k.classList.add('tryk'); }, 60); }
        }, { passive: true });
        document.addEventListener('pointerup', () => {
          if (kort && timer) { clearTimeout(timer); timer = 0; kort.classList.add('tryk'); }
          const k = kort; kort = null;
          // Fjernes igen efter et øjeblik, hvis trykket ikke åbnede en ny side (fx et kort der kun skifter filter).
          if (k) setTimeout(() => k.classList.remove('tryk'), 450);
        }, { passive: true });
        document.addEventListener('pointercancel', slip, { passive: true });
        // Tilbage-knappen kan vise siden fra hukommelsen (bfcache) med kortet stadig løftet.
        window.addEventListener('pageshow', () => document.querySelectorAll('.tryk').forEach((el) => el.classList.remove('tryk')));
      })();

      // Kortbillede -> artiklens topbillede (18/10, forslag 1). Ved klik på et artikelkort får kun DETTE korts
      // billede navnet tfw-hero, og sidens eget topbillede (hvis man står i en artikel) mister sit, så navnet
      // findes præcis én gang. Ruller man tilbage (bfcache), ryddes navnene, så næste klik starter forfra.
      (() => {
        if (!('onpagereveal' in window)) return; // browseren kan ikke glidende sideskift - intet at gøre
        const ryd = () => {
          document.querySelectorAll('.tfw-vt-hero').forEach((el) => el.classList.remove('tfw-vt-hero'));
          document.documentElement.classList.remove('tfw-vt-kort');
        };
        document.addEventListener('click', (e) => {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const a = e.target.closest && e.target.closest('a[href^="/video/"]');
          if (!a) return;
          const img = a.querySelector('.watch-card-thumb img, .cinema-card-thumb img, .inline-recs-thumb img');
          if (!img || !img.complete || !img.naturalWidth) return;
          ryd();
          img.classList.add('tfw-vt-hero');
          document.documentElement.classList.add('tfw-vt-kort');
        });
        window.addEventListener('pageshow', ryd);
      })();
    </script>
  </body>
</html>