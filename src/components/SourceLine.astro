---
// Lille meta-linje under kort og overskrifter: krediterer den oprindelige
// YouTube-kanal og viser datoen. Falder tilbage til kun dato, hvis kilden
// endnu ikke er backfillet på artiklen.
interface Props {
  channel?: string | null;
  date: string;
  className?: string;
}
const { channel, date, className = 'tma-grid-meta' } = Astro.props;

const formatted = (() => {
  const parsed = new Date(date);
  return isNaN(parsed.getTime())
    ? date
    : parsed.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
})();
---
<p class={className}>
  {channel ? (
    <>
      <span class="card-source">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/></svg>
        {channel}
      </span>
      <span aria-hidden="true"> · </span>
    </>
  ) : null}
  <span>{formatted}</span>
</p>
