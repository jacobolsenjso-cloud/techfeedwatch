---
// Stort første kort på emne- og listesider (19/10). Samme form som forsidens hovedhistorie:
// titlen ligger OVEN PÅ billedet med en mørk toning, uddrag og kilde står ved siden af
// (desktop) eller under (mobil). Det bryder rækken af ens kort, så siden får en tydelig start.
// Emnefarven bruges kun som prik i mærket - aldrig som tekst eller bag hvid tekst (farvereglen).
import fs from 'node:fs';
import SourceLine from './SourceLine.astro';
import { TAG_COLORS } from '../lib/tags';

interface Props {
  /** Artiklen som import.meta.glob giver den (har .file og .frontmatter) */
  video: any;
  /** Emnet på mærket; standard = artiklens første emne */
  maerke?: string;
  /** Vis "New"-mærke (fx på /latest for i dags artikler) */
  ny?: boolean;
}
const { video, maerke, ny = false } = Astro.props;
const slug: string = video.file.split('/').pop().replace('.md', '');
const fm = video.frontmatter;
const emner = fm.tags || fm.tag || [];
const visEmne: string | undefined = maerke ?? (Array.isArray(emner) ? emner[0] : emner);
// Stort billede (960x540), hvis artiklen har et AI-billede (samme regel som src/lib/aibillede.mjs).
// Ellers INTET billede: det gamle abstrakte emnekort forstørret gav emnenavnet to gange og streger
// bag titlen (set på /tag/robotics/ 19/10). I stedet en mørk flade med svag emnetoning.
const harAi = fs.existsSync(`public/billeder/${slug}.webp`);
const billede = `/billeder/${slug}.webp`;
const emneFarve = (visEmne && TAG_COLORS[visEmne]) || '#2563eb';
const uddrag = (() => {
  const s = (fm.summary || '').trim();
  if (s.length <= 260) return s;
  return s.slice(0, 260).replace(/\s+\S*$/, '').replace(/[.,;:!?—-]+$/, '').trim() + '…';
})();
---
<a href={`/video/${slug}`} class="stort-kort">
  <div class={harAi ? 'stort-kort-billede watch-card-thumb' : 'stort-kort-billede stort-kort-uden-billede'} style={harAi ? undefined : `--emne: ${emneFarve}`}>
    {harAi && <img src={billede} alt="" width="960" height="540" loading="eager" fetchpriority="high" />}
    <div class="stort-kort-tekst">
      {(ny || visEmne) && (
        <div class="stort-kort-maerker">
          {ny && <span class="stort-pill">New</span>}
          {visEmne && <span class="stort-pill stort-pill-emne" style={`--tag-accent: ${TAG_COLORS[visEmne] || '#2563eb'}`}>{visEmne}</span>}
        </div>
      )}
      <h2 class="stort-kort-titel">{fm.title}</h2>
    </div>
  </div>
  <div class="stort-kort-side">
    {uddrag && <p class="stort-kort-uddrag">{uddrag}</p>}
    <SourceLine channel={fm.channelTitle} date={fm.date} minutesRead={fm.minutesRead} />
    <span class="stort-kort-laes" aria-hidden="true">Read the article →</span>
  </div>
</a>

<style is:global>
  .stort-kort { display: grid; grid-template-columns: 1.5fr 1fr; gap: 28px; align-items: center; margin: 0 0 40px; padding: 14px; border-radius: 20px; background: var(--card-bg); border: 1px solid var(--border-color); color: inherit; text-decoration: none; transition: box-shadow 0.2s ease, transform 0.2s ease; }
  .stort-kort:hover { box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08); transform: translateY(-2px); }
  .stort-kort:focus-visible { outline: 3px solid var(--teal-text); outline-offset: 3px; }
  /* .stort-kort foran: sidernes egne .watch-card-thumb-regler (margin, radius) må ikke vinde */
  .stort-kort .stort-kort-billede { position: relative; aspect-ratio: 16 / 9; border-radius: 14px; overflow: hidden; margin: 0; }
  .stort-kort-billede img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* Uden AI-billede: mørk flade, kun 22 % emnefarve blandet i (titlen står hvidt på en MØRK flade,
     ikke på emnefarven), plus en svag cirkel som pynt */
  .stort-kort .stort-kort-uden-billede { background: #0b1020; background: radial-gradient(circle at 85% 20%, color-mix(in srgb, var(--emne) 30%, #0b1020) 0%, #0b1020 60%), linear-gradient(135deg, color-mix(in srgb, var(--emne) 22%, #0b1020), #0b1020); background-color: color-mix(in srgb, var(--emne) 22%, #0b1020); }
  .stort-kort-uden-billede .stort-kort-tekst { background: none; padding-bottom: 22px; }
  /* Toningen er svagere i den nederste stribe, og bundluften (7 % af bredden) holder
     titlen over vandmærket "TechFeedWatch.com" nederst til højre - som på forsiden */
  .stort-kort-tekst { position: absolute; left: 0; right: 0; bottom: 0; padding: 70px 22px max(22px, 7%); background: linear-gradient(to top, rgba(2, 6, 23, 0.3) 0%, rgba(2, 6, 23, 0.88) 22%, rgba(2, 6, 23, 0.6) 62%, rgba(2, 6, 23, 0) 100%); }
  .stort-kort-maerker { display: flex; flex-wrap: wrap; gap: 6px; }
  .stort-pill { display: inline-flex; align-items: center; gap: 6px; background: rgba(255, 255, 255, 0.95); color: #111827; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; line-height: 1.3; }
  .stort-pill-emne::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--tag-accent, #2563eb); flex: none; }
  .stort-kort-titel { margin: 9px 0 0; color: #fff; font-size: 1.85rem; line-height: 1.2; font-weight: 800; letter-spacing: -0.02em; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .stort-kort:hover .stort-kort-titel { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .stort-kort-side { padding: 6px 14px 6px 0; }
  .stort-kort-uddrag { margin: 0 0 14px; font-size: 1.02rem; line-height: 1.65; color: #4b5563; display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
  body.dark-mode .stort-kort-uddrag { color: #a1a1aa; }
  .stort-kort-laes { display: inline-block; margin-top: 12px; font-weight: 700; font-size: 0.92rem; color: var(--teal-text); }
  @media (max-width: 900px) {
    .stort-kort { grid-template-columns: 1fr; gap: 12px; }
    .stort-kort-side { padding: 0 6px 6px; }
  }
  @media (max-width: 768px) {
    .stort-kort { padding: 10px; margin-bottom: 30px; border-radius: 16px; }
    .stort-kort .stort-kort-billede { border-radius: 12px; }
    .stort-kort-tekst { padding: 50px 14px max(18px, 7%); }
    .stort-kort-titel { font-size: 1.32rem; }
    .stort-kort-uddrag { font-size: 0.95rem; -webkit-line-clamp: 3; margin-bottom: 8px; }
    .stort-kort-laes { display: none; }
  }
</style>
