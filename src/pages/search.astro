---
import MainLayout from '../layouts/MainLayout.astro';

const title = "Search";
const description = "Search every article, free tool, glossary term and guide on Tech Feed Watch.";
---

<MainLayout noindex title={title} description={description}>
  <style is:global>
    .search-page { max-width: 1200px; margin: 0 auto; padding: 30px 20px; flex: 1; width: 100%; box-sizing: border-box; }
    .search-page h1 { font-size: 1.8rem; margin: 0 0 18px 0; }
    .search-page-box { display: flex; gap: 10px; margin-bottom: 12px; }
    .search-page-input { flex: 1; padding: 14px 16px; border-radius: 10px; border: 1px solid var(--border-color); background: var(--card-bg); color: var(--text-color); font-size: 1.05rem; box-sizing: border-box; }
    .search-page-input:focus { outline: none; border-color: var(--teal-text); }
    .search-count { color: #6b7280; font-size: 0.95rem; margin: 0 0 22px 0; }
    body.dark-mode .search-count { color: #9ca3af; }

    .search-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 22px; }
    .search-empty { color: #6b7280; font-size: 1.05rem; padding: 30px 0; }
    body.dark-mode .search-empty { color: #9ca3af; }

    /* Artikelkortene. Søgesiden manglede denne CSS helt (fundet 24/9-2026):
       kortene blev vist som blå, understregede links. Samme regler som de
       andre kortlister (history, watch-later, tag-siderne). */
    .watch-card { text-decoration: none; color: inherit; display: block; transition: transform 0.2s; }
    .watch-card:hover { transform: translateY(-3px); }
    .watch-card-thumb { aspect-ratio: 16/9; border-radius: 12px; margin-bottom: 10px; overflow: hidden; position: relative; background: #e6e8eb; }
    body.dark-mode .watch-card-thumb { background: #26242c; }
    .watch-card-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .search-grid .tma-grid-title { margin: 0 0 5px 0; font-size: 15px; line-height: 1.4; font-weight: 600; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .watch-card:hover .tma-grid-title { color: var(--teal-text); }
    .search-grid .tma-grid-meta { font-size: 13px; color: #6b7280; margin: 0; }
    body.dark-mode .search-grid .tma-grid-meta { color: #9ca3af; }

    /* Værktøjer, glossar, guides og emner — vises før artiklerne */
    .search-section { font-size: 1.05rem; margin: 6px 0 12px 0; color: var(--text-color); }
    .search-section:empty { display: none; }
    .search-pages { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; margin-bottom: 30px; }
    .search-pages:empty { display: none; margin: 0; }
    .search-hit { display: flex; gap: 12px; align-items: flex-start; padding: 14px; border: 1px solid var(--border-color); border-radius: 12px; background: var(--card-bg); color: var(--text-color); text-decoration: none; }
    .search-hit:hover { border-color: var(--teal-text); }
    .search-hit-icon { font-size: 1.4rem; line-height: 1; width: 32px; text-align: center; flex-shrink: 0; }
    .search-hit-type { display: block; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--teal-text); }
    .search-hit-title { display: block; font-weight: 700; font-size: 0.98rem; margin: 2px 0 4px 0; }
    .search-hit-text { display: block; font-size: 0.85rem; color: #6b7280; line-height: 1.45; }
    body.dark-mode .search-hit-text { color: #9ca3af; }

    @media (max-width: 768px) {
      .search-page { padding: 20px 15px; }
      .search-pages { grid-template-columns: 1fr; }
      .search-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 16px; }
    }
  </style>

  <div class="search-page">
    <h1>Search</h1>
    <div class="search-page-box">
      <input type="text" id="searchPageInput" class="search-page-input" placeholder="Search articles, tools, glossary..." autocomplete="off" />
    </div>
    <p class="search-count" id="searchCount"></p>
    <h2 class="search-section" id="searchPagesHead"></h2>
    <div class="search-pages" id="searchPages"></div>
    <h2 class="search-section" id="searchGridHead"></h2>
    <div class="search-grid" id="searchGrid"></div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('searchPageInput');
      const grid = document.getElementById('searchGrid');
      const count = document.getElementById('searchCount');
      let data = [];
      let ready = false;

      const params = new URLSearchParams(window.location.search);
      const initialQ = (params.get('q') || '').trim();
      if (input) input.value = initialQ;

      const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

      const fmtDate = (d) => {
        try { return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }); }
        catch (e) { return ''; }
      };

      const buildCard = (v) => {
        return (
          '<a href="/video/' + v.slug + '/" class="watch-card">' +
            '<div class="watch-card-thumb">' +
              '<img src="https://img.youtube.com/vi/' + v.youtubeId + '/mqdefault.jpg" alt="" loading="lazy">' +
              '<span class="watch-card-play" aria-hidden="true">▶</span>' +
            '</div>' +
            '<div>' +
              '<h2 class="tma-grid-title">' + esc(v.title) + '</h2>' +
              '<p class="tma-grid-meta">' +
                (v.channelTitle ? '<span class="card-source">' + esc(v.channelTitle) + '</span> · ' : '') +
                esc(fmtDate(v.date)) +
              '</p>' +
            '</div>' +
          '</a>'
        );
      };

      const pagesBox = document.getElementById('searchPages');
      const pagesHead = document.getElementById('searchPagesHead');
      const gridHead = document.getElementById('searchGridHead');
      let pages = [];

      // Alle ord skal findes, men ikke nødvendigvis i rækkefølge: "hreflang generator"
      // finder "Hreflang Tags Generator". Før krævede søgningen hele frasen ordret.
      const norm = (s) => String(s || '').toLowerCase().replace(/&/g, ' and ').replace(/[^a-z0-9#+.]+/g, ' ');
      const ord = (q) => norm(q).split(' ').filter(Boolean);
      const passer = (tekst, ordliste) => { const h = norm(tekst); return ordliste.every((w) => h.includes(w)); };

      const TYPE_ORDEN = { Tool: 0, Glossary: 1, Guide: 2, Topic: 3, Tools: 4, Page: 5 };
      const buildHit = (p) => (
        '<a href="' + p.url + '" class="search-hit">' +
          '<span class="search-hit-icon" aria-hidden="true">' + esc(p.icon || '') + '</span>' +
          '<span>' +
            '<span class="search-hit-type">' + esc(p.type === 'Tools' ? 'Tool category' : p.type) + '</span>' +
            '<span class="search-hit-title">' + esc(p.title) + '</span>' +
            (p.desc ? '<span class="search-hit-text">' + esc(p.desc.length > 140 ? p.desc.slice(0, 140).replace(/\s+\S*$/, '') + '…' : p.desc) + '</span>' : '') +
          '</span>' +
        '</a>'
      );

      const render = () => {
        const q = (input ? input.value : '').trim();
        if (!ready) { count.textContent = 'Loading...'; return; }
        pagesBox.innerHTML = ''; pagesHead.textContent = ''; gridHead.textContent = '';
        if (!q) {
          grid.innerHTML = '';
          count.textContent = 'Type a word to search articles, tools, the glossary and guides.';
          return;
        }
        const w = ord(q);
        const pageHits = pages
          .filter((p) => passer(p.title + ' ' + p.text + ' ' + p.type, w))
          .map((p) => ({ p, s: (passer(p.title, w) ? 0 : 10) + (TYPE_ORDEN[p.type] ?? 9) }))
          .sort((a, b) => a.s - b.s)
          .map((x) => x.p);
        const matches = data.filter((v) => passer((v.title || '') + ' ' + (v.summary || '') + ' ' + (v.tags || []).join(' '), w));
        const n = pageHits.length + matches.length;
        count.textContent = n + (n === 1 ? ' result' : ' results') + ' for "' + q + '"';
        if (pageHits.length) {
          pagesHead.textContent = 'Tools, glossary and guides (' + pageHits.length + ')';
          pagesBox.innerHTML = pageHits.map(buildHit).join('');
        }
        if (matches.length) {
          if (pageHits.length) gridHead.textContent = 'Articles (' + matches.length + ')';
          grid.innerHTML = matches.map(buildCard).join('');
        } else {
          grid.innerHTML = n ? '' : '<p class="search-empty">Nothing found. Try a different word.</p>';
        }
      };

      // Artikler og de øvrige sider hentes samtidig. Fejler sideindekset, virker
      // artikelsøgningen stadig som før.
      Promise.all([
        fetch('/videos.json').then((r) => r.json()), // fuldt katalog: søgning matcher og viser hele resuméer
        fetch('/search-pages.json').then((r) => r.json()).catch(() => []),
      ])
        .then(([all, sider]) => {
          // Kun rigtige artikler (ikke Shorts), nyeste først
          data = all.filter((v) => !v.isShort).sort((a, b) => new Date(b.date) - new Date(a.date));
          pages = Array.isArray(sider) ? sider : [];
          ready = true;
          render();
        })
        .catch(() => { ready = true; count.textContent = 'Could not load the search index.'; });

      if (input) {
        input.addEventListener('input', () => {
          render();
          const q = input.value.trim();
          const url = q ? ('/search?q=' + encodeURIComponent(q)) : '/search';
          window.history.replaceState(null, '', url);
        });
        input.focus();
      }
    });
  </script>
</MainLayout>
