---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Page Not Found" description="The page you were looking for could not be found on Tech Feed Watch." noindex={true}>
  <style is:global>
    .notfound-wrapper { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 60px 20px; width: 100%; box-sizing: border-box; }
    .notfound-code { font-size: clamp(5rem, 18vw, 9rem); font-weight: 800; line-height: 1; letter-spacing: -0.04em; margin: 0; background: linear-gradient(135deg, #0891b2, #22d3ee); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .notfound-title { font-size: 1.6rem; font-weight: 700; margin: 12px 0 10px 0; }
    .notfound-sub { font-size: 1.05rem; line-height: 1.6; color: #6b7280; margin: 0 0 32px 0; max-width: 460px; }
    body.dark-mode .notfound-sub { color: #9ca3af; }
    .notfound-links { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
    .notfound-link { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; font-weight: 600; font-size: 0.95rem; padding: 11px 22px; border-radius: 999px; transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease; }
    .notfound-link.primary { background: #0891b2; color: #fff; border: 1px solid #0891b2; }
    .notfound-link.primary:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(8, 145, 178,0.35); }
    .notfound-link.ghost { background: var(--card-bg); color: var(--text-color); border: 1px solid var(--border-color); }
    .notfound-link.ghost:hover { transform: translateY(-2px); border-color: #0891b2; box-shadow: 0 6px 24px rgba(0,0,0,0.06), 0 2px 8px rgba(0,0,0,0.04); }
  </style>

  <div class="notfound-wrapper">
    <p class="notfound-code">404</p>
    <h1 class="notfound-title">This page went off the grid.</h1>
    <p class="notfound-sub">The page you were looking for doesn't exist or may have been moved. Let's get you back to something useful.</p>
    <div class="notfound-links">
      <a href="/" class="notfound-link primary">🏠 Back to Home</a>
      <a href="/guides" class="notfound-link ghost">🧭 Guides</a>
      <a href="/library" class="notfound-link ghost">📚 Video Archive</a>
    </div>
  </div>
</MainLayout>
