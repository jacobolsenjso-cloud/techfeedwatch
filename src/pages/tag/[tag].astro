---
import SourceLine from '../../components/SourceLine.astro';
import MainLayout from '../../layouts/MainLayout.astro'; 
import FAQ from '../../components/FAQ.astro';
import { tagSlug } from '../../lib/tags';

const PAGE_SIZE = 24;

export async function getStaticPaths() {
  const videos = Object.values(import.meta.glob('../../content/videos/*.md', { eager: true }));
  
  const uniqueTags = [...new Set(videos.flatMap((v: any) => {
    const t = v.frontmatter.tags || v.frontmatter.tag || [];
    return Array.isArray(t) ? t : [t];
  }))].filter(Boolean);
  
  return uniqueTags.map((tag: any) => {
    const filteredVideos = videos
      .filter((v: any) => {
        const vTags = v.frontmatter.tags || v.frontmatter.tag || [];
        const tagsArray = Array.isArray(vTags) ? vTags : [vTags];
        return tagsArray.includes(tag);
      })
      .sort((a: any, b: any) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
    return {
      params: { tag: tagSlug(tag) },
      props: { tagName: tag, videos: filteredVideos },
    };
  });
}

const { tagName, videos } = Astro.props;
const currentSlug = tagSlug(tagName);
const totalCount = videos.length;
const lastPage = Math.max(1, Math.ceil(totalCount / PAGE_SIZE));
const pageVideos = videos.slice(0, PAGE_SIZE);
const nextUrl = lastPage > 1 ? `/tag/${currentSlug}/page/2` : null;

const descriptionDictionary: Record<string, string> = {
  "AI & Tech": "AI and technology news, tools, and analysis — from ChatGPT, Claude, and Gemini to chips, robotics, and the trends shaping how we work and build.",
  "SEO": "SEO and generative engine optimization (GEO): practical strategies, tools, and tips to rank in Google and AI search and grow your organic traffic.",
  "Automation": "Automation and no-code workflows — n8n, Zapier, AI agents, and SaaS tips to automate repetitive work and scale your business faster.",
  "Coding": "Coding and software development — Python, JavaScript, AI coding tools, and developer tutorials for building software faster and smarter.",
  "Business & Money": "Business and money in tech — startups, making money with AI, monetization, and practical strategies to grow revenue online.",
  "AI Video": "AI video and image generation — Sora, Runway, Veo, Kling, and Midjourney tools, tutorials, and news for AI filmmaking and content creation.",
  "Productivity": "Productivity tools and AI assistants — Notion, NotebookLM, and workflows to get more done and build a smarter second brain.",
  "Fintech": "Fintech news and analysis — digital banking, payments, open banking, stablecoins, and how AI is reshaping money and finance.",
  "Crypto": "Crypto news and analysis — Bitcoin, Ethereum, Solana, DeFi, Web3, and blockchain trends, explained for investors and builders.",
  "Cybersecurity": "Cybersecurity news and analysis — ransomware, zero trust, data breaches, cloud security, and how AI is reshaping digital defense.",
  "Default": `The latest ${tagName} news, tools, and analysis — curated tech videos turned into clear, readable articles you can absorb in minutes.`
};

const currentDescription = descriptionDictionary[tagName] || descriptionDictionary["Default"];

const faqDictionary: Record<string, {question: string, answer: string}[]> = {
  "AI & Tech": [
    { question: "What is Artificial Intelligence (AI)?", answer: "AI refers to computer systems designed to perform tasks that typically require human intelligence, such as visual perception, speech recognition, and decision-making. Our videos cover the latest breakthroughs in this fast-moving field." },
    { question: "How often do you update your AI content?", answer: "We curate and post the most relevant AI and tech videos daily to ensure you stay ahead of the curve in a rapidly evolving industry." },
    { question: "Can I use AI tools for my own business?", answer: "Absolutely. Many of the tools featured in our videos, such as ChatGPT and Midjourney, offer accessible tiers for beginners and businesses looking to automate workflows." }
  ],
  "SEO": [
    { question: "What does SEO stand for?", answer: "SEO stands for Search Engine Optimization. It is the practice of increasing both the quality and quantity of website traffic, as well as exposure to your brand, through non-paid search engine results." },
    { question: "Is SEO still relevant with AI search engines?", answer: "Yes, but it is evolving. Traditional SEO is shifting towards 'Generative Engine Optimization' (GEO), meaning content must be structured to be easily understood by AI models like Google's AI Overviews." },
    { question: "How long does it take to see SEO results?", answer: "SEO is a long-term strategy. While technical fixes can show improvements in weeks, content-driven ranking changes typically take 3 to 6 months to mature." }
  ],
  "Default": [
    { question: "How often are new videos added to the archive?", answer: "Our library is updated continuously. We curate the best tech and AI videos daily to keep our archive fresh and highly relevant." },
    { question: "Are these videos free to watch?", answer: "Yes, all videos embedded on Tech Feed Watch are completely free to watch." },
    { question: "Can I save videos to watch later?", answer: "Yes! Click the 'Save' button under any video, and it will be added to your personal 'Watch Later' list in the sidebar." }
  ]
};

const currentFAQs = faqDictionary[tagName] || faqDictionary["Default"];

// Emne-farvesystem, defineret lokalt (samme palette som forsiden og sitemap)
const TAG_COLORS: Record<string, string> = {
  "AI & Tech": "#06b6d4", "SEO": "#6366f1", "Automation": "#14b8a6",
  "Coding": "#2563eb", "Business & Money": "#059669", "AI Video": "#d926c8",
  "Productivity": "#8b5cf6", "Fintech": "#1e3a8a", "Crypto": "#f59e0b",
  "Cybersecurity": "#dc2626"
};
const tagAccent = TAG_COLORS[tagName] || "#6b7280";

const formatDate = (d: string) => {
  const parsed = new Date(d);
  return isNaN(parsed.getTime()) ? d : parsed.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
};
---

<MainLayout title={`${tagName} Archive`} description={currentDescription}>
  
  <style is:global>
    .tag-page-wrapper { padding: 30px 20px; max-width: 1600px; margin: 0 auto; width: 100%; box-sizing: border-box; }
    .breadcrumbs-bar { background: var(--hover-bg); padding: 10px 18px; border-radius: 8px; font-size: 0.9rem; margin-bottom: 25px; color: #6b7280; display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--border-color); }
    .breadcrumbs-bar a { color: #0891b2; text-decoration: none; font-weight: 500; }
    body.dark-mode .breadcrumbs-bar a { color: #22d3ee; }
    .breadcrumbs-bar span { opacity: 0.5; }
    .header-title { font-size: 2rem; margin-top: 0; margin-bottom: 15px; padding-bottom: 12px; border-bottom: 3px solid var(--tag-accent, #6b7280); }
    .header-title span { color: var(--tag-accent, #6b7280); }
    .tag-description { font-size: 1.1rem; line-height: 1.6; color: #4b5563; margin-top: 0; margin-bottom: 40px; padding-bottom: 20px; border-bottom: 1px solid var(--border-color); max-width: 1000px; }
    body.dark-mode .tag-description { color: #9ca3af; }

    .video-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-bottom: 30px; }
    .watch-card { text-decoration: none; color: inherit; display: block; transition: transform 0.2s; }
    .watch-card:hover { transform: translateY(-3px); }
    
    .watch-card-thumb { aspect-ratio: 16/9; border-radius: 12px; margin-bottom: 10px; position: relative; overflow: hidden; }
    .watch-card-thumb img { width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0; border: none; }
    .duration-badge { position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.8); color: white; padding: 2px 6px; border-radius: 4px; font-size: 12px; font-weight: 600; letter-spacing: 0.5px; z-index: 2; }

    .tma-grid-title { margin: 0 0 5px 0; font-size: 15px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;}
    .watch-card:hover .tma-grid-title { color: #0891b2; }
    .tma-grid-meta { font-size: 13px; color: #6b7280; margin: 0; }
    body.dark-mode .tma-grid-meta { color: #9ca3af; }

    .pagination { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 10px 0 45px 0; flex-wrap: wrap; }
    .pagination-btn, .pagination-num { display: inline-flex; align-items: center; justify-content: center; min-width: 40px; height: 40px; padding: 0 16px; border-radius: 20px; background: var(--hover-bg); color: var(--text-color); text-decoration: none; font-size: 0.9rem; font-weight: 600; transition: background 0.2s; border: none; box-sizing: border-box; }
    .pagination-num { min-width: 40px; padding: 0; }
    .pagination-btn:hover, .pagination-num:hover { background: #e5e7eb; }
    body.dark-mode .pagination-btn:hover, body.dark-mode .pagination-num:hover { background: #334155; }
    .pagination-num.active { background: #111; color: #fff; }
    body.dark-mode .pagination-num.active { background: #f1f5f9; color: #111; }
    .pagination-disabled { opacity: 0.4; pointer-events: none; }

    @media (max-width: 768px) { 
      .tag-page-wrapper { padding: 15px; }
      .header-title { font-size: 1.5rem; }
      .tag-description { font-size: 1rem; }
      .video-grid { grid-template-columns: 1fr; gap: 20px; }
      .watch-card-thumb { border-radius: 8px; }
      .pagination { gap: 6px; }
      .pagination-btn, .pagination-num { min-width: 36px; height: 36px; padding: 0 12px; font-size: 0.85rem; }
    }
  </style>

  <div class="tag-page-wrapper">
    
    <div class="breadcrumbs-bar">
      <a href="/">Frontpage</a> <span>/</span> 
      <a href="/library">Library</a> <span>/</span> 
      <span>{tagName}</span>
    </div>

    <h1 class="header-title" style={`--tag-accent: ${tagAccent}`}>Videos in <span>#{tagName}</span></h1>
    <p class="tag-description">{currentDescription}</p>
    
    <div class="video-grid">
      {pageVideos.map((video: any) => (
        <a href={`/video/${video.file.split('/').pop().replace('.md', '')}`} class="watch-card">
          <div class="watch-card-thumb">
            <img src={`https://img.youtube.com/vi/${video.frontmatter.youtubeId}/mqdefault.jpg`} alt={video.frontmatter.title} loading="lazy" />
            <div class="duration-badge">{video.frontmatter.duration || (video.frontmatter.isShort ? 'Short' : '0:00')}</div>
            <span class="watch-card-play" aria-hidden="true">▶</span>
          </div>
          <div>
            <h2 class="tma-grid-title">{video.frontmatter.title}</h2>
            <SourceLine channel={video.frontmatter.channelTitle} date={video.frontmatter.date} />
          </div>
        </a>
      ))}
    </div>

    {lastPage > 1 && (
      <nav class="pagination" aria-label="Sidenavigation">
        <span class="pagination-btn pagination-disabled" aria-disabled="true">← Previous</span>
        {Array.from({ length: lastPage }, (_, i) => i + 1).map((n: number) => (
          n === 1 ? (
            <span class="pagination-num active" aria-current="page">{n}</span>
          ) : (
            <a href={`/tag/${currentSlug}/page/${n}`} class="pagination-num">{n}</a>
          )
        ))}
        {nextUrl ? (
          <a href={nextUrl} class="pagination-btn">Next →</a>
        ) : (
          <span class="pagination-btn pagination-disabled" aria-disabled="true">Next →</span>
        )}
      </nav>
    )}
    
    <FAQ faqs={currentFAQs} />
    
  </div>
</MainLayout>
