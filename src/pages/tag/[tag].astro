---
import { TAG_COLORS } from '../../lib/tags';
import SourceLine from '../../components/SourceLine.astro';
import MainLayout from '../../layouts/MainLayout.astro'; 
import FAQ from '../../components/FAQ.astro';
import { tagSlug } from '../../lib/tags';
import { ALLE_EMNER, INDEX_GRAENSE } from '../../lib/emner.mjs';

const PAGE_SIZE = 24;

export async function getStaticPaths() {
  const videos = Object.values(import.meta.glob('../../content/videos/*.md', { eager: true }));
  
  const uniqueTags = [...new Set(videos.flatMap((v: any) => {
    const t = v.frontmatter.tags || v.frontmatter.tag || [];
    return Array.isArray(t) ? t : [t];
  }))].filter(Boolean);
  // 17/10: alle sitets emner får en side - også nye emner, der endnu har 0 artikler.
  for (const emne of ALLE_EMNER) if (!uniqueTags.includes(emne)) uniqueTags.push(emne);
  
  return uniqueTags.map((tag: any) => {
    const filteredVideos = videos
      .filter((v: any) => {
        const vTags = v.frontmatter.tags || v.frontmatter.tag || [];
        const tagsArray = Array.isArray(vTags) ? vTags : [vTags];
        return tagsArray.includes(tag);
      })
      .sort((a: any, b: any) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
    return {
      params: { tag: tagSlug(tag) },
      props: { tagName: tag, videos: filteredVideos },
    };
  });
}

const { tagName, videos } = Astro.props;
const currentSlug = tagSlug(tagName);
const totalCount = videos.length;
const lastPage = Math.max(1, Math.ceil(totalCount / PAGE_SIZE));
const pageVideos = videos.slice(0, PAGE_SIZE);
const nextUrl = lastPage > 1 ? `/tag/${currentSlug}/page/2` : null;

const descriptionDictionary: Record<string, string> = {
  "AI & Tech": "AI and technology news, tools, and analysis — from ChatGPT, Claude, and Gemini to chips, robotics, and the trends shaping how we work and build.",
  "SEO": "SEO and generative engine optimization (GEO): practical strategies, tools, and tips to rank in Google and AI search and grow your organic traffic.",
  "Automation": "Automation and no-code workflows — n8n, Zapier, AI agents, and SaaS tips to automate repetitive work and scale your business faster.",
  "Coding": "Coding and software development — Python, JavaScript, AI coding tools, and developer tutorials for building software faster and smarter.",
  "Business & Money": "Business and money in tech — startups, making money with AI, monetization, and practical strategies to grow revenue online.",
  "AI Video": "AI video and image generation — Sora, Runway, Veo, Kling, and Midjourney tools, tutorials, and news for AI filmmaking and content creation.",
  "Productivity": "Productivity tools and AI assistants — Notion, NotebookLM, and workflows to get more done and build a smarter second brain.",
  "Fintech": "Fintech news and analysis — digital banking, payments, open banking, stablecoins, and how AI is reshaping money and finance.",
  "Crypto": "Crypto news and analysis — Bitcoin, Ethereum, Solana, DeFi, Web3, and blockchain trends, explained for investors and builders.",
  "Cybersecurity": "Cybersecurity news and analysis — ransomware, zero trust, data breaches, cloud security, and how AI is reshaping digital defense.",
  "AI Agents": "AI agents explained — agentic AI, autonomous assistants, multi-agent systems and the tools that let AI take actions, not just answer questions.",
  "Investing & Trading": "Investing and trading in plain language — stocks, ETFs, index funds, trading platforms and how technology is changing the way people invest.",
  "Smartphones & Gadgets": "Smartphones and gadgets — iPhone and Android phones, wearables, tablets and earbuds, with clear answers on what is new and what it means for you.",
  "Robotics": "Robotics news and explainers — humanoid robots, industrial robots and physical AI, and what robots can and cannot do today.",
  "PC Building & Gaming": "PC building and gaming — parts, graphics cards, gaming laptops and upgrades, explained so you can build or buy the right machine.",
  "Default": `The latest ${tagName} news, tools, and analysis — curated tech videos turned into clear, readable articles you can absorb in minutes.`
};

const currentDescription = descriptionDictionary[tagName] || descriptionDictionary["Default"];

const faqDictionary: Record<string, {question: string, answer: string}[]> = {
  "AI & Tech": [
    { question: "What is Artificial Intelligence (AI)?", answer: "AI refers to computer systems designed to perform tasks that typically require human intelligence, such as visual perception, speech recognition, and decision-making. Our videos cover the latest breakthroughs in this fast-moving field." },
    { question: "How often do you update your AI content?", answer: "We curate and post the most relevant AI and tech videos daily to ensure you stay ahead of the curve in a rapidly evolving industry." },
    { question: "Can I use AI tools for my own business?", answer: "Absolutely. Many of the tools featured in our articles, such as ChatGPT and Midjourney, offer accessible tiers for beginners and businesses looking to automate workflows." }
  ],
  "SEO": [
    { question: "What does SEO stand for?", answer: "SEO stands for Search Engine Optimization. It is the practice of increasing both the quality and quantity of website traffic, as well as exposure to your brand, through non-paid search engine results." },
    { question: "Is SEO still relevant with AI search engines?", answer: "Yes, but it is evolving. Traditional SEO is shifting towards 'Generative Engine Optimization' (GEO), meaning content must be structured to be easily understood by AI models like Google's AI Overviews." },
    { question: "How long does it take to see SEO results?", answer: "SEO is a long-term strategy. While technical fixes can show improvements in weeks, content-driven ranking changes typically take 3 to 6 months to mature." }
  ],
  "Default": [
    { question: "How often are new articles added?", answer: "Most days. The system publishes a few new articles a day, usually two or three, each answering a question people actually search for." },
    { question: "Are the source videos free to watch?", answer: "Yes. Every article links to the creator's original video on YouTube, and it is free to watch." },
    { question: "Can I save articles to read later?", answer: "Yes. Click 'Save' under any article and it is added to your Read later list in the sidebar. The list lives in your browser only; nothing is sent anywhere." }
  ]
};

const currentFAQs = faqDictionary[tagName] || faqDictionary["Default"];

const tagAccent = TAG_COLORS[tagName] || "#6b7280";
// Tyndt emne (17/10): under INDEX_GRAENSE artikler er siden en kort liste. Den holdes ude af
// Google (noindex + ude af sitemappet) og fortæller læseren, at emnet er under opbygning.
const tyndt = totalCount < INDEX_GRAENSE;

const formatDate = (d: string) => {
  const parsed = new Date(d);
  return isNaN(parsed.getTime()) ? d : parsed.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
};// CollectionPage + ItemList (20/9-2026). Listesiderne havde kun en breadcrumb,
// så en maskine kunne ikke se, at siden ER en liste, eller hvad der står på den.
// Listen må kun rumme det, siden faktisk viser — ellers lover schemaet mere end
// siden holder. publisher peger på organisationen via @id, så noden kun findes
// ét sted (forsiden).
const listeSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${tagName} Archive`,
  "url": `https://techfeedwatch.com/tag/${currentSlug}/`,
  "description": currentDescription,
  "isPartOf": { "@type": "WebSite", "name": "Tech Feed Watch", "url": "https://techfeedwatch.com/" },
  "publisher": { "@id": "https://techfeedwatch.com/#organization" },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": pageVideos.length,
    "itemListElement": pageVideos.map((v: any, n: number) => ({
      "@type": "ListItem",
      "position": n + 1,
      // Slug kommer fra filstien, ikke fra frontmatter — samme måde som kortene
      // nedenfor gør det. Første forsøg gættede på et frontmatter-felt og gav
      // "undefined" på alle 13 emnesider; målingen fangede det før commit.
      "url": `https://techfeedwatch.com/video/${v.file.split('/').pop().replace('.md', '')}/`,
      "name": v.frontmatter?.title ?? v.title
    }))
  }
};

---

<MainLayout title={`${tagName} Archive`} description={currentDescription} schema={listeSchema} noindex={tyndt}>
  
  <style is:global>
    .tag-page-wrapper { padding: 30px 20px; max-width: 1600px; margin: 0 auto; width: 100%; box-sizing: border-box; }
    .breadcrumbs-bar { background: var(--hover-bg); padding: 10px 18px; border-radius: 8px; font-size: 0.9rem; margin-bottom: 25px; color: #6b7280; display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--border-color); }
    .breadcrumbs-bar a { color: var(--teal-text); text-decoration: none; font-weight: 500; display: inline-flex; align-items: center; min-height: 44px; padding: 4px 2px; }
    body.dark-mode .breadcrumbs-bar a { color: #22d3ee; }
    /* Brødkrummelinjens grå var 3,21:1 mod den mørke baggrund. Farven er
       årsagen, ikke opacity — det var min første og forkerte diagnose. */
    .breadcrumbs-bar span { opacity: 1; }
    body.dark-mode .breadcrumbs-bar { color: #b6bcc7; }
    .header-title { font-size: 2rem; margin-top: 0; margin-bottom: 15px; padding-bottom: 12px; border-bottom: 3px solid var(--tag-accent, #6b7280); }
    /* Emnefarven som overskriftstekst gav 3,21:1 i moerk tilstand. Farven staar
       allerede i den 3px kant under overskriften. */
    .header-title span { color: var(--teal-text); }
    /* Følg-knap og "under opbygning" (17/10) */
    .emne-foelg-raekke { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin: -24px 0 34px; }
    .emne-foelg { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; border-radius: 999px; border: 1px solid #1d4ed8; background: transparent; color: var(--teal-text); font-size: 0.92rem; font-weight: 700; cursor: pointer; font-family: inherit; }
    .emne-foelg:hover { background: rgba(37, 99, 235, 0.08); }
    .emne-foelg[aria-pressed="true"] { background: #1d4ed8; color: #fff; }
    .emne-foelg-note { font-size: 0.85rem; color: #6b7280; }
    .emne-push { border-top: none; padding: 0; margin: -20px 0 30px; max-width: 1000px; font-size: 0.88rem; }
    body.dark-mode .emne-foelg { color: #67e8f9; border-color: #67e8f9; }
    body.dark-mode .emne-foelg[aria-pressed="true"] { background: #1d4ed8; color: #fff; border-color: #1d4ed8; }
    body.dark-mode .emne-foelg-note { color: #9ca3af; }
    .emne-bygges { display: flex; gap: 14px; align-items: flex-start; max-width: 1000px; margin: 0 0 34px; padding: 18px 20px; border-radius: 12px; border: 1px solid rgba(37, 99, 235, 0.35); background: rgba(37, 99, 235, 0.07); }
    .emne-bygges-ikon { font-size: 1.6rem; line-height: 1; }
    .emne-bygges h2 { margin: 0 0 6px; font-size: 1.1rem; }
    .emne-bygges p { margin: 0; line-height: 1.55; }
    .tag-description { font-size: 1.1rem; line-height: 1.6; color: #4b5563; margin-top: 0; margin-bottom: 40px; padding-bottom: 20px; border-bottom: 1px solid var(--border-color); max-width: 1000px; }
    body.dark-mode .tag-description { color: #9ca3af; }

    .video-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-bottom: 30px; }
    .watch-card { text-decoration: none; color: inherit; display: block; transition: transform 0.2s; }
    .watch-card:hover { transform: translateY(-3px); }
    
    .watch-card-thumb { aspect-ratio: 16/9; border-radius: 12px; margin-bottom: 10px; position: relative; overflow: hidden; }
    .watch-card-thumb img { width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0; border: none; }
    .duration-badge { position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.8); color: white; padding: 2px 6px; border-radius: 4px; font-size: 12px; font-weight: 600; letter-spacing: 0.5px; z-index: 2; }

    .tma-grid-title { margin: 0 0 5px 0; font-size: 15px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;}
    .watch-card:hover .tma-grid-title { color: var(--teal-text); }
    .tma-grid-meta { font-size: 13px; color: #6b7280; margin: 0; }
    body.dark-mode .tma-grid-meta { color: #9ca3af; }

    .pagination { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 10px 0 45px 0; flex-wrap: wrap; }
    .pagination-btn, .pagination-num { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; height: 44px; padding: 0 16px; border-radius: 20px; background: var(--hover-bg); color: var(--text-color); text-decoration: none; font-size: 0.9rem; font-weight: 600; transition: background 0.2s; border: none; box-sizing: border-box; }
    .pagination-num { min-width: 44px; padding: 0; }
    .pagination-btn:hover, .pagination-num:hover { background: #e5e7eb; }
    body.dark-mode .pagination-btn:hover, body.dark-mode .pagination-num:hover { background: #334155; }
    .pagination-num.active { background: #111; color: #fff; }
    body.dark-mode .pagination-num.active { background: #f1f5f9; color: #111; }
    .pagination-disabled { opacity: 0.4; pointer-events: none; }

    @media (max-width: 768px) { 
      .tag-page-wrapper { padding: 15px; }
      .header-title { font-size: 1.5rem; }
      .tag-description { font-size: 1rem; }
      .video-grid { grid-template-columns: 1fr; gap: 20px; }
      .watch-card-thumb { border-radius: 8px; }
      .pagination { gap: 6px; }
      .pagination-btn, .pagination-num { min-width: 44px; height: 44px; padding: 0 8px; font-size: 0.85rem; }
    }
  </style>

  <div class="tag-page-wrapper">
    
    <div class="breadcrumbs-bar">
      <a href="/">Frontpage</a> <span>/</span> 
      <a href="/library">Library</a> <span>/</span> 
      <span>{tagName}</span>
    </div>

    <h1 class="header-title" style={`--tag-accent: ${tagAccent}`}>Articles in <span>#{tagName}</span></h1>
    <p class="tag-description">{currentDescription}</p>
    <div class="emne-foelg-raekke">
      <button type="button" class="emne-foelg" data-emne={tagName} aria-pressed="false">🔔 <span class="emne-foelg-tekst">Follow this topic</span></button>
      <span class="emne-foelg-note">The bell at the top then counts only the topics you follow.</span>
    </div>
    <div class="notif-push emne-push" data-push-felt hidden></div>
    {tyndt && (
      <div class="emne-bygges" role="note">
        <span class="emne-bygges-ikon" aria-hidden="true">🛠️</span>
        <div>
          <h2>We're building this topic right now</h2>
          <p>{totalCount === 0 ? 'The first articles are on their way' : `There ${totalCount === 1 ? 'is 1 article' : `are ${totalCount} articles`} so far`} — new ones arrive every few days. Follow it with the 🔔 and we'll show you each new one. Thanks for your patience :-)</p>
        </div>
      </div>
    )}
    
    <div class="video-grid">
      {pageVideos.map((video: any) => (
        <a href={`/video/${video.file.split('/').pop().replace('.md', '')}`} class="watch-card">
          <div class="watch-card-thumb">
            <img src={`/kort/${video.file.split('/').pop().replace('.md', '')}.webp`} alt={video.frontmatter.title} loading="lazy" />
            <span class="watch-card-play" aria-hidden="true">▶</span>
          </div>
          <div>
            <h2 class="tma-grid-title">{video.frontmatter.title}</h2>
            <SourceLine channel={video.frontmatter.channelTitle} date={video.frontmatter.date} minutesRead={video.frontmatter.minutesRead} />
          </div>
        </a>
      ))}
    </div>

    {lastPage > 1 && (
      <nav class="pagination" aria-label="Sidenavigation">
        <span class="pagination-btn pagination-disabled" aria-disabled="true">← Previous</span>
        {Array.from({ length: lastPage }, (_, i) => i + 1).map((n: number) => (
          n === 1 ? (
            <span class="pagination-num active" aria-current="page">{n}</span>
          ) : (
            <a href={`/tag/${currentSlug}/page/${n}`} class="pagination-num">{n}</a>
          )
        ))}
        {nextUrl ? (
          <a href={nextUrl} class="pagination-btn">Next →</a>
        ) : (
          <span class="pagination-btn pagination-disabled" aria-disabled="true">Next →</span>
        )}
      </nav>
    )}
    
    <FAQ faqs={currentFAQs} />
    
  </div>
  <script is:inline>
    // Følg-knap (17/10): samme liste som klokkens "Topics" (localStorage tfw_follow). Intet sendes til os.
    (function () {
      var knap = document.querySelector('.emne-foelg'); if (!knap) return;
      var emne = knap.getAttribute('data-emne'), tekst = knap.querySelector('.emne-foelg-tekst');
      var laes = function () { try { var v = JSON.parse(localStorage.getItem('tfw_follow')); return Array.isArray(v) ? v : []; } catch (e) { return []; } };
      var vis = function () { var f = laes().indexOf(emne) !== -1; knap.setAttribute('aria-pressed', f ? 'true' : 'false'); tekst.textContent = f ? 'Following' : 'Follow this topic'; };
      knap.addEventListener('click', function () {
        var f = laes(); f = f.indexOf(emne) === -1 ? f.concat(emne) : f.filter(function (x) { return x !== emne; });
        try { localStorage.setItem('tfw_follow', JSON.stringify(f)); } catch (e) {}
        vis(); document.dispatchEvent(new CustomEvent('tfw-follow-aendret'));
      });
      vis();
    })();
  </script>
</MainLayout>
