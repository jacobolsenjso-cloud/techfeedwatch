---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="History">
  <style is:global>
    .history-wrapper { padding: 30px 20px; max-width: 1400px; margin: 0 auto; flex: 1; width: 100%; box-sizing: border-box; }
    .header-title { font-size: 2.2rem; margin-top: 0; margin-bottom: 10px; display: flex; align-items: center; gap: 12px; }
    .header-desc { color: #6b7280; font-size: 1.1rem; margin-bottom: 30px; }
    body.dark-mode .header-desc { color: #9ca3af; }
    
    .clear-btn { background: #ef4444; color: white; border: none; padding: 8px 16px; border-radius: 8px; cursor: pointer; font-weight: 600; margin-bottom: 30px; transition: background 0.2s; }
    .clear-btn:hover { background: #dc2626; }

    .video-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
    .watch-card { text-decoration: none; color: inherit; display: block; transition: transform 0.2s; }
    .watch-card:hover { transform: translateY(-3px); }
    .watch-card-thumb { aspect-ratio: 16/9; border-radius: 12px; margin-bottom: 10px; overflow: hidden; position: relative; }
    .tma-grid-title { margin: 0 0 5px 0; font-size: 15px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;}
    .watch-card:hover .tma-grid-title { color: #ef4444; }
    
    .empty-state { text-align: center; padding: 50px 20px; color: #6b7280; font-size: 1.2rem; }
  </style>

  <div class="history-wrapper">
    <h1 class="header-title">🕒 History</h1>
    <p class="header-desc">Videos you have watched recently.</p>
    
    <button id="clearHistoryBtn" class="clear-btn" style="display: none;">Clear History</button>
    
    <div id="historyGrid" class="video-grid"></div>
    <div id="emptyState" class="empty-state" style="display: none;">You haven't watched any videos yet.</div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const historyGrid = document.getElementById('historyGrid');
      const emptyState = document.getElementById('emptyState');
      const clearBtn = document.getElementById('clearHistoryBtn');

      // Selvhelbredende: opslag fra youtubeId -> nuværende titel-slug, hentet fra videos.json
      let idToSlug = {};
      let validSlugs = null;

      // Retter gamle ID-baserede links til nye titel-slugs, og fjerner videoer der ikke længere findes
      const healVideos = (videos) => {
        if (!validSlugs) return { healed: videos, changed: false };
        let changed = false;
        const healed = [];
        videos.forEach(video => {
          let youtubeId = video.youtubeId || null;
          if (!youtubeId && video.slug && /^[a-zA-Z0-9_-]{11}$/.test(video.slug) && idToSlug[video.slug]) {
            youtubeId = video.slug;
          }
          let newSlug = video.slug;
          if (youtubeId && idToSlug[youtubeId]) {
            newSlug = idToSlug[youtubeId];
          }
          if (!validSlugs.has(newSlug)) {
            changed = true;
            return;
          }
          if (newSlug !== video.slug) changed = true;
          healed.push(newSlug === video.slug ? video : { ...video, slug: newSlug });
        });
        return { healed, changed };
      };

      const loadHistory = () => {
        const history = JSON.parse(localStorage.getItem('videoHistory') || '[]');
        const { healed, changed } = healVideos(history);
        if (changed) localStorage.setItem('videoHistory', JSON.stringify(healed));

        if (healed.length === 0) {
          historyGrid.innerHTML = '';
          emptyState.style.display = 'block';
          clearBtn.style.display = 'none';
          return;
        }

        emptyState.style.display = 'none';
        clearBtn.style.display = 'inline-block';

        historyGrid.innerHTML = healed.map(video => `
          <a href="/video/${video.slug}" class="watch-card">
            <div class="watch-card-thumb">
              <img src="${video.img.replace('mqdefault', 'hqdefault')}" alt="${(video.title || '').replace(/"/g, '&quot;')}" loading="lazy" />
              <span class="watch-card-play" aria-hidden="true">▶</span>
            </div>
            <div>
              <h3 class="tma-grid-title">${video.title}</h3>
            </div>
          </a>
        `).join('');
      };

      fetch('/videos.json')
        .then(res => res.json())
        .then(allVideos => {
          allVideos.forEach(v => {
            if (v.youtubeId) idToSlug[v.youtubeId] = v.slug;
          });
          validSlugs = new Set(allVideos.map(v => v.slug));
          loadHistory();
        })
        .catch(() => {
          loadHistory();
        });

      // Slet historik knap
      clearBtn.addEventListener('click', () => {
        if(confirm('Are you sure you want to clear your history?')) {
          localStorage.removeItem('videoHistory');
          loadHistory();
        }
      });
    });
  </script>
</MainLayout>