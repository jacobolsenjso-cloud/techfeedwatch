---
import MainLayout from '../../../layouts/MainLayout.astro';

export async function getStaticPaths({ paginate }: any) {
  const allVideos = Object.values(import.meta.glob('../../../content/videos/*.md', { eager: true }));
  const shorts = allVideos
    .filter((v: any) => v.frontmatter.isShort === true)
    .sort((a: any, b: any) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
  // Side 1 bor på "/shorts" - drop paginate's side-1-rute, så denne fil kun laver /shorts/page/2, /3 osv.
  return paginate(shorts, { pageSize: 24 }).slice(1);
}

const { page } = Astro.props as { page: any };

const allVideos = Object.values(import.meta.glob('../../../content/videos/*.md', { eager: true }));
const allShorts = allVideos.filter((v: any) => v.frontmatter.isShort === true);

const tagCounts = allShorts.reduce((acc: any, video: any) => {
  const t = video.frontmatter.tags || video.frontmatter.tag || [];
  const tagsArray = Array.isArray(t) ? t : [t];
  tagsArray.filter(Boolean).forEach((tag: string) => { acc[tag] = (acc[tag] || 0) + 1; });
  return acc;
}, {}) as Record<string, number>;
const topTags = Object.keys(tagCounts).sort((a, b) => tagCounts[b] - tagCounts[a]).slice(0, 20);

const TAG_COLORS: Record<string, string> = {
  "AI & Tech": "#3b82f6", "SEO": "#10b981", "Automation": "#f59e0b",
  "Coding": "#8b5cf6", "Business & Money": "#0d9488", "AI Video": "#ec4899",
  "Productivity": "#eab308", "Fintech": "#ef4444", "Crypto": "#d97706"
};

const formatDate = (d: string) => {
  const parsed = new Date(d);
  return isNaN(parsed.getTime()) ? d : parsed.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
};

const prevUrl = page.currentPage <= 2 ? '/shorts' : `/shorts/page/${page.currentPage - 1}`;
const nextUrl = page.currentPage < page.lastPage ? `/shorts/page/${page.currentPage + 1}` : null;
---

<MainLayout title={`Shorts – Page ${page.currentPage}`}>
  <style is:global>
    .tag-bar-container { position: sticky; top: -1px; background: var(--bg-color); z-index: 25; padding: 12px 20px; border-bottom: 1px solid var(--border-color); display: flex; align-items: center; gap: 10px; overflow-x: auto; white-space: nowrap; scrollbar-width: none; min-height: 55px; box-sizing: border-box; margin-bottom: 25px; }
    .tag-bar-container::-webkit-scrollbar { display: none; }
    .filter-tag { background: var(--hover-bg); color: var(--text-color); border: 1px solid transparent; padding: 7px 16px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: background 0.2s; line-height: 1.5; display: inline-block; }
    .filter-tag:hover { background: #e5e7eb; }
    .filter-tag.active { background: #111; color: #fff; }
    body.dark-mode .filter-tag:hover { background: #334155; }
    body.dark-mode .filter-tag.active { background: #f1f5f9; color: #111; }
    .filter-tag-accent { border-color: var(--tag-accent); }
    .filter-tag-accent::before { content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--tag-accent); margin-right: 7px; vertical-align: middle; }
    .filter-tag-accent.active { background: var(--tag-accent); color: #fff; border-color: var(--tag-accent); }

    .shorts-wrapper { padding: 0 20px 20px 20px; max-width: 1400px; margin: 0 auto; flex: 1; width: 100%; box-sizing: border-box; }
    .header-title { font-size: 2rem; margin-top: 0; margin-bottom: 25px; display: flex; align-items: center; gap: 10px; }

    .shorts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px; margin-bottom: 40px; }
    .watch-card { text-decoration: none; color: inherit; display: block; transition: transform 0.3s ease; }
    .watch-card:hover { transform: translateY(-4px); }
    .short-card-thumb { aspect-ratio: 9/16; border-radius: 12px; margin-bottom: 10px; position: relative; overflow: hidden; }
    .play-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.2); display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.3s ease; z-index: 2; }
    .play-icon { width: 48px; height: 48px; background: rgba(239, 68, 68, 0.9); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 20px; padding-left: 4px; box-sizing: border-box; backdrop-filter: blur(4px); }
    .watch-card:hover .play-overlay { opacity: 1; }
    .tma-grid-title { margin: 0 0 5px 0; font-size: 15px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; transition: color 0.2s; }
    .watch-card:hover .tma-grid-title { color: #ef4444; }
    .tma-grid-meta { font-size: 13px; color: #6b7280; margin: 0; }
    body.dark-mode .tma-grid-meta { color: #9ca3af; }

    .no-results { grid-column: 1 / -1; text-align: center; padding: 60px 20px; color: #6b7280; font-size: 1rem; }
    body.dark-mode .no-results { color: #9ca3af; }

    .pagination { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 20px 0 40px 0; flex-wrap: wrap; }
    .pagination-btn, .pagination-num { display: inline-flex; align-items: center; justify-content: center; min-width: 40px; height: 40px; padding: 0 16px; border-radius: 20px; background: var(--hover-bg); color: var(--text-color); text-decoration: none; font-size: 0.9rem; font-weight: 600; transition: background 0.2s; border: none; box-sizing: border-box; cursor: pointer; }
    .pagination-num { min-width: 40px; padding: 0; }
    .pagination-btn:hover, .pagination-num:hover { background: #e5e7eb; }
    body.dark-mode .pagination-btn:hover, body.dark-mode .pagination-num:hover { background: #334155; }
    .pagination-num.active { background: #111; color: #fff; }
    body.dark-mode .pagination-num.active { background: #f1f5f9; color: #111; }
    .pagination-disabled { opacity: 0.4; pointer-events: none; }

    @media (max-width: 768px) {
      .shorts-wrapper { padding: 15px; }
      .shorts-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
      .tag-bar-container { margin-left: -15px; margin-right: -15px; width: calc(100% + 30px); padding: 10px 15px; }
      .pagination { gap: 6px; }
      .pagination-btn, .pagination-num { min-width: 36px; height: 36px; padding: 0 12px; font-size: 0.85rem; }
    }
  </style>

  <div class="tag-bar-container">
    <button class="filter-tag active" data-tag="All">All</button>
    {topTags.map((tag: any) => (
      TAG_COLORS[tag] ? (
        <button class="filter-tag filter-tag-accent" data-tag={tag} style={`--tag-accent: ${TAG_COLORS[tag]}`}>{tag}</button>
      ) : (
        <button class="filter-tag" data-tag={tag}>{tag}</button>
      )
    ))}
  </div>

  <div class="shorts-wrapper" id="videoContainer">
    <h1 class="header-title"><span style="color: #ef4444;">⚡</span> Shorts</h1>

    <div id="defaultView">
      <div class="shorts-grid">
        {page.data.map((short: any) => (
          <a href={`/video/${short.file.split('/').pop().replace('.md', '')}`} class="watch-card">
            <div class="short-card-thumb">
              <img src={`https://img.youtube.com/vi/${short.frontmatter.youtubeId}/maxresdefault.jpg`} alt={short.frontmatter.title} loading="lazy" />
              <div class="play-overlay"><div class="play-icon">▶</div></div>
            </div>
            <h3 class="tma-grid-title">{short.frontmatter.title}</h3>
            <p class="tma-grid-meta">Tech Feed Watch • {formatDate(short.frontmatter.date)}</p>
          </a>
        ))}
      </div>

      <nav class="pagination" aria-label="Pagination">
        <a href={prevUrl} class="pagination-btn">← Previous</a>
        {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((n: number) => (
          n === page.currentPage ? (
            <span class="pagination-num active" aria-current="page">{n}</span>
          ) : (
            <a href={n === 1 ? '/shorts' : `/shorts/page/${n}`} class="pagination-num">{n}</a>
          )
        ))}
        {nextUrl ? (
          <a href={nextUrl} class="pagination-btn">Next →</a>
        ) : (
          <span class="pagination-btn pagination-disabled" aria-disabled="true">Next →</span>
        )}
      </nav>
    </div>

    <div id="filteredResults" class="shorts-grid" style="display:none;"></div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('topSearchInput');
      const filterTags = document.querySelectorAll('.filter-tag');
      const defaultView = document.getElementById('defaultView');
      const filteredResults = document.getElementById('filteredResults');

      let allShortsData = [];
      let ready = false;

      fetch('/videos.json')
        .then(res => res.json())
        .then(data => { allShortsData = data.filter(v => v.isShort); ready = true; filterVideos(); })
        .catch(() => { allShortsData = []; ready = true; });

      function buildCard(video) {
        const card = document.createElement('a');
        card.href = `/video/${video.slug}`;
        card.className = 'watch-card';
        const thumb = document.createElement('div');
        thumb.className = 'short-card-thumb';
        const img = document.createElement('img');
        img.src = `https://img.youtube.com/vi/${video.youtubeId}/maxresdefault.jpg`;
        img.alt = video.title;
        img.loading = 'lazy';
        thumb.appendChild(img);
        const overlay = document.createElement('div');
        overlay.className = 'play-overlay';
        overlay.innerHTML = '<div class="play-icon">▶</div>';
        thumb.appendChild(overlay);
        const titleEl = document.createElement('h3');
        titleEl.className = 'tma-grid-title';
        titleEl.textContent = video.title;
        card.appendChild(thumb);
        card.appendChild(titleEl);
        return card;
      }

      function renderFiltered(query, activeTag) {
        filteredResults.innerHTML = '';
        const matches = allShortsData.filter(video => {
          const matchesSearch = video.title.toLowerCase().includes(query);
          const matchesTag = activeTag === 'All' || (video.tags || []).includes(activeTag);
          return matchesSearch && matchesTag;
        });
        if (matches.length === 0) {
          const empty = document.createElement('p');
          empty.className = 'no-results';
          empty.textContent = 'No Shorts found.';
          filteredResults.appendChild(empty);
          return;
        }
        matches.forEach(video => filteredResults.appendChild(buildCard(video)));
      }

      function filterVideos() {
        const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
        const activeTagBtn = document.querySelector('.filter-tag.active');
        const activeTag = activeTagBtn ? activeTagBtn.getAttribute('data-tag') : 'All';
        const isFiltering = activeTag !== 'All' || query !== '';
        if (!isFiltering) {
          if (defaultView) defaultView.style.display = '';
          if (filteredResults) filteredResults.style.display = 'none';
          return;
        }
        if (defaultView) defaultView.style.display = 'none';
        if (filteredResults) {
          filteredResults.style.display = '';
          if (ready) renderFiltered(query, activeTag);
          else filteredResults.innerHTML = '';
        }
      }

      if (searchInput) searchInput.addEventListener('input', filterVideos);
      filterTags.forEach(tagBtn => {
        tagBtn.addEventListener('click', (e) => {
          filterTags.forEach(btn => btn.classList.remove('active'));
          e.target.classList.add('active');
          filterVideos();
        });
      });
    });
  </script>
</MainLayout>
