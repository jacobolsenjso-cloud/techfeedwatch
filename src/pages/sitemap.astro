---
import { TAG_COLORS, tagSlug } from '../lib/tags';
import { TOOLS as ALLE_VAERKTOEJER, TOOL_CATEGORIES } from '../lib/tools';
import MainLayout from '../layouts/MainLayout.astro';

// Shorts er noindex'ede (se video/[slug].astro), så de udelades her for ikke at lede Google til dem
const allVideos = Object.values(import.meta.glob('../content/videos/*.md', { eager: true }))
  .filter((v: any) => !v.frontmatter.isShort);

// Alle emner fra det fælles farvekort — før var listen håndskrevet og manglede tre emner (94 artikler).
const ALLOWED_TAGS = Object.keys(TAG_COLORS);


function getTags(v: any): string[] {
  const t = v.frontmatter.tags || v.frontmatter.tag || [];
  return Array.isArray(t) ? t : [t];
}

// Grupperer alle videoer under hvert tag (en video kan optræde under flere tags), nyeste først.
// Tags uden videoer springes over.
const videosByTag = ALLOWED_TAGS.map((tag) => {
  const videos = allVideos
    .filter((v: any) => getTags(v).includes(tag))
    .sort((a: any, b: any) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
  return { tag, videos };
}).filter((group) => group.videos.length > 0);

// 17/10: listen manglede Start here, Latest, Best of each topic, Trends, Search og
// redaktions-/kontaktsiderne. Alle sider i hovedmenuen og footeren skal stå her.
const MAIN_PAGES = [
  { href: '/', label: 'Home' },
  { href: '/start-here', label: 'Start here' },
  { href: '/latest', label: 'Latest' },
  { href: '/popular', label: 'Best of each topic' },
  { href: '/library', label: 'Library' },
  { href: '/trends', label: 'Trends' },
  { href: '/search', label: 'Search' },
  { href: '/watch-later', label: 'Read later' },
  { href: '/history', label: 'History' },
  { href: '/tools', label: 'Tools' },
  { href: '/glossary', label: 'Glossary' },
  { href: '/guides', label: 'Guides' },
];
const ABOUT_PAGES = [
  { href: '/about', label: 'About' },
  { href: '/author/jacob-olsen', label: 'Jacob S. Olsen' },
  { href: '/editorial-guidelines', label: 'Editorial guidelines' },
  { href: '/corrections', label: 'Corrections' },
  { href: '/contact', label: 'Contact' },
  { href: '/terms', label: 'Terms' },
  { href: '/privacy-policy', label: 'Privacy Policy' },
];

// Ordliste-kategorierne læses nu fra selve ordene (17/10): den håndskrevne liste
// havde kun 5 af 8 kategorier, så 10 af 56 ord manglede på siden.
const GLOSSARY_ORDER = ["AI", "Tech", "SEO", "Fintech", "Crypto", "Cybersecurity", "Hardware", "Business"];
const GLOSSARY_CATEGORY_COLORS: Record<string, string> = {
  AI: "#2563eb", Tech: "#8b5cf6", SEO: "#10b981", Fintech: "#2563eb", Crypto: "#d97706",
  Cybersecurity: TAG_COLORS['Cybersecurity'], Hardware: TAG_COLORS['Hardware & Chips'], Business: TAG_COLORS['Business & Money'],
};

const glossaryTerms = Object.values(import.meta.glob('../content/glossary/*.md', { eager: true }))
  .map((e: any) => ({
    term: e.frontmatter.term,
    slug: e.frontmatter.slug,
    category: e.frontmatter.category,
  }))
  .filter((t: any) => t.term && t.slug);

// Grupperer glossary-termer under hver kategori, alfabetisk. Kategorier uden termer springes over.
// Kendte kategorier i fast rækkefølge, nye kategorier bagefter - så et nyt ord aldrig forsvinder.
const GLOSSARY_CATEGORIES = [...new Set([...GLOSSARY_ORDER, ...glossaryTerms.map((t: any) => t.category).filter(Boolean).sort()])];
const glossaryByCategory = GLOSSARY_CATEGORIES.map((category) => {
  const terms = glossaryTerms
    .filter((t: any) => t.category === category)
    .sort((a: any, b: any) => a.term.localeCompare(b.term));
  return { category, terms };
}).filter((group) => group.terms.length > 0);

const guidePages = Object.values(import.meta.glob('../content/guides/*.md', { eager: true }))
  .map((g: any) => ({ title: g.frontmatter.title, slug: g.frontmatter.slug }))
  .filter((g: any) => g.title && g.slug)
  .sort((a: any, b: any) => a.title.localeCompare(b.title));

// Værktøjerne læses fra src/lib/tools.ts (17/10): før stod 8 af 50 håndskrevet her.
const toolsByCategory = TOOL_CATEGORIES.map((c) => ({
  category: c,
  tools: ALLE_VAERKTOEJER.filter((t) => t.category === c.id),
})).filter((g) => g.tools.length > 0);

// Emnesiderne selv (/tag/...) - før linkede sitemap'et kun til artiklerne, ikke til emnerne.
const topicPages = videosByTag.map(({ tag, videos }) => ({ tag, href: `/tag/${tagSlug(tag)}`, count: videos.length }));

const title = "Site Map";
const description = "Browse every page, tool, and article on TechFeedWatch, organized by topic for easy navigation.";
---

<MainLayout title={title} description={description}>
  <style is:global>
    .sitemap-wrapper { max-width: 900px; margin: 0 auto; padding: 40px 20px; flex: 1; width: 100%; box-sizing: border-box; }
    .sitemap-header h1 { margin: 0 0 8px 0; font-size: 2rem; }
    .sitemap-header p { color: #6b7280; margin: 0 0 30px 0; font-size: 1.05rem; }
    body.dark-mode .sitemap-header p { color: #9ca3af; }

    .sitemap-section { margin-bottom: 40px; }
    .sitemap-section h2 { font-size: 1.3rem; margin: 0 0 15px 0; padding-bottom: 8px; border-bottom: 1px solid var(--border-color); }

    .sitemap-link-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
    .sitemap-link-list li a { display: inline-block; padding: 8px 16px; border-radius: 20px; background: var(--hover-bg); color: var(--text-color); text-decoration: none; font-size: 0.9rem; font-weight: 600; transition: background 0.2s; }
    .sitemap-link-list li a:hover { background: #e5e7eb; }
    body.dark-mode .sitemap-link-list li a:hover { background: #334155; }

    .sitemap-tag { background: var(--card-bg); border: 1px solid var(--border-color); border-left: 4px solid var(--tag-accent, var(--border-color)); border-radius: 8px; margin-bottom: 10px; overflow: hidden; transition: border-left-width 0.2s; }
    .sitemap-tag:hover { border-left-width: 7px; }
    .sitemap-tag summary {
      cursor: pointer;
      padding: 14px 18px;
      font-weight: 700;
      font-size: 1.05rem;
      list-style: none;
      background: var(--hover-bg);
      display: flex;
      align-items: center;
      transition: background 0.2s;
    }
    .sitemap-tag summary:hover { background: #e5e7eb; }
    body.dark-mode .sitemap-tag summary:hover { background: #334155; }
    .sitemap-tag summary::-webkit-details-marker { display: none; }
    .sitemap-tag summary::after { content: '+'; font-size: 1.3rem; font-weight: 400; margin-left: auto; padding-left: 12px; }
    .sitemap-tag[open] summary::after { content: '−'; }
    .sitemap-count { font-weight: 600; color: var(--tag-accent, #6b7280); font-size: 0.9rem; margin-left: 6px; }

    .sitemap-video-list { list-style: none; margin: 0; padding: 10px 18px 16px 18px; display: flex; flex-direction: column; gap: 8px; }
    .sitemap-video-list li a { color: var(--text-color); text-decoration: none; font-size: 0.95rem; }
    .sitemap-video-list li a:hover { color: var(--teal-text); text-decoration: underline; }
    body.dark-mode .sitemap-video-list li a:hover { color: #22d3ee; }

    @media (max-width: 768px) {
      .sitemap-wrapper { padding: 20px 15px; }
      .sitemap-header h1 { font-size: 1.6rem; }
    }
  </style>

  <div class="sitemap-wrapper">
    <div class="sitemap-header">
      <h1>🗺️ Site Map</h1>
      <p>Browse every page, tool, and article on TechFeedWatch — organized by topic for easy navigation.</p>
    </div>

    <section class="sitemap-section">
      <h2>Main Pages</h2>
      <ul class="sitemap-link-list">
        {MAIN_PAGES.map((p) => (
          <li><a href={p.href}>{p.label}</a></li>
        ))}
      </ul>
    </section>

    <section class="sitemap-section">
      <h2>About this site</h2>
      <ul class="sitemap-link-list">
        {ABOUT_PAGES.map((p) => (
          <li><a href={p.href}>{p.label}</a></li>
        ))}
      </ul>
    </section>

    <section class="sitemap-section">
      <h2>Topics</h2>
      <ul class="sitemap-link-list">
        {topicPages.map((t) => (
          <li><a href={t.href}>{t.tag} ({t.count})</a></li>
        ))}
      </ul>
    </section>

    <section class="sitemap-section">
      <h2>Tools ({ALLE_VAERKTOEJER.length})</h2>
      {toolsByCategory.map(({ category, tools }) => (
        <details class="sitemap-tag">
          <summary>{category.icon} {category.name}<span class="sitemap-count">({tools.length})</span></summary>
          <ul class="sitemap-video-list">
            <li><a href={`/tools/${category.slug}`}>All {category.name} tools →</a></li>
            {tools.map((t) => (
              <li><a href={`/tools/${t.slug}`}>{t.title}</a></li>
            ))}
          </ul>
        </details>
      ))}
    </section>

    {guidePages.length > 0 && (
      <section class="sitemap-section">
        <h2>Guides</h2>
        <ul class="sitemap-link-list">
          {guidePages.map((g: any) => (
            <li><a href={`/guides/${g.slug}`}>{g.title}</a></li>
          ))}
        </ul>
      </section>
    )}

    <section class="sitemap-section">
      <h2>Glossary Terms</h2>
      {glossaryByCategory.map(({ category, terms }) => (
        <details class="sitemap-tag" style={`--tag-accent: ${GLOSSARY_CATEGORY_COLORS[category] || 'var(--border-color)'}`}>
          <summary>{category}<span class="sitemap-count">({terms.length})</span></summary>
          <ul class="sitemap-video-list">
            {terms.map((t: any) => (
              <li><a href={`/glossary/${t.slug}`}>{t.term}</a></li>
            ))}
          </ul>
        </details>
      ))}
    </section>

    <section class="sitemap-section">
      <h2>Articles by Topic</h2>
      {videosByTag.map(({ tag, videos }) => (
        <details class="sitemap-tag" style={`--tag-accent: ${TAG_COLORS[tag] || 'var(--border-color)'}`}>
          <summary>{tag}<span class="sitemap-count">({videos.length})</span></summary>
          <ul class="sitemap-video-list">
            {videos.map((v: any) => (
              <li><a href={`/video/${v.file.split('/').pop().replace('.md', '')}`}>{v.frontmatter.title}</a></li>
            ))}
          </ul>
        </details>
      ))}
    </section>
  </div>
</MainLayout>
