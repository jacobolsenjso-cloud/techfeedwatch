---
import MainLayout from '../../layouts/MainLayout.astro';
import FAQ from '../../components/FAQ.astro';

export async function getStaticPaths() {
  const allGuides = Object.values(import.meta.glob('../../content/guides/*.md', { eager: true }));
  const videos = Object.values(import.meta.glob('../../content/videos/*.md', { eager: true }));

  return allGuides.map((guide: any) => {
    const guideTags = Array.isArray(guide.frontmatter.tags)
      ? guide.frontmatter.tags
      : [guide.frontmatter.tags].filter(Boolean);

    const matchedVideos = videos
      .filter((v: any) => {
        if (v.frontmatter.isShort) return false;
        const vTags = v.frontmatter.tags || v.frontmatter.tag || [];
        const tagsArray = Array.isArray(vTags) ? vTags : [vTags];
        return tagsArray.some((t: string) => guideTags.includes(t));
      })
      .sort((a: any, b: any) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());

    return {
      params: { slug: guide.frontmatter.slug },
      props: { guide, matchedVideos },
    };
  });
}

const { guide, matchedVideos } = Astro.props as { guide: any; matchedVideos: any[] };
const { title, description, category, date, faqs } = guide.frontmatter;

// Samme regel som artiklerne: datoen vises kun når den findes OG er forskellig
// fra udgivelsesdatoen. En guide der står med samme dato for evigt ser forladt
// ud, og en der påstår at være opdateret uden at være det er værre.
const updated: string | null = guide.frontmatter.updated || null;
const showUpdated = updated && String(updated).slice(0, 10) !== String(date).slice(0, 10);
const updatedLabel = showUpdated
  ? new Date(updated).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

const TAG_COLORS: Record<string, string> = {
  "AI & Tech": "#06b6d4", "SEO": "#6366f1", "Automation": "#14b8a6",
  "Coding": "#2563eb", "Business & Money": "#059669", "AI Video": "#d926c8",
  "Productivity": "#8b5cf6", "Fintech": "#1e3a8a", "Crypto": "#f59e0b",
  "Cybersecurity": "#dc2626", "Quantum Computing": "#7c3aed", "Hardware & Chips": "#ea580c", "AR & VR": "#db2777"
};
const accent = TAG_COLORS[category] || "#0891b2";

const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  // Google kræver et billede på Article. Guides har ikke deres eget og-billede
  // som artiklerne har, så indtil de får det, peger vi på sitets delebillede —
  // et rigtigt billede der findes, frem for et felt der mangler.
  "image": "https://techfeedwatch.com/og-default-v2.png",
  "author": {
    "@type": "Person",
    "name": "Jacob S. Olsen",
    "url": "https://techfeedwatch.com/author/jacob-olsen",
    "sameAs": ["https://x.com/JacobStubbeJS"],
    "jobTitle": "Founder of Tech Feed Watch"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Tech Feed Watch",
    "url": "https://techfeedwatch.com/",
    "logo": { "@type": "ImageObject", "url": "https://techfeedwatch.com/icon-512.png", "width": 512, "height": 512 }
  },
  // Fuld ISO-tid med tidszone, ikke bare "2026-07-23". Google accepterer den
  // bare dato, men melder den som ugyldig datetime — artikelsiderne har altid
  // gjort det rigtigt, guiderne gjorde ikke.
  "datePublished": new Date(date).toISOString(),
  "dateModified": new Date(showUpdated ? updated! : date).toISOString(),
  "mainEntityOfPage": { "@type": "WebPage", "@id": `https://techfeedwatch.com/guides/${guide.frontmatter.slug}` }
};
---

<MainLayout title={`${title} — Tech Feed Watch`} description={description} schema={schema}>
  <style is:global>
    .guide-wrapper { max-width: 820px; margin: 0 auto; padding: 40px 20px; flex: 1; width: 100%; box-sizing: border-box; }
    .guide-breadcrumbs { background: var(--hover-bg); padding: 10px 18px; border-radius: 8px; font-size: 0.9rem; margin-bottom: 25px; color: #6b7280; display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--border-color); }
    .guide-breadcrumbs a { color: var(--teal-text); text-decoration: none; font-weight: 500; display: inline-flex; align-items: center; min-height: 44px; padding: 4px 2px; }
    .guide-updated { font-size: 0.88rem; color: #6b7280; margin: -8px 0 24px 0; }
    body.dark-mode .guide-updated { color: #9ca3af; }
    .guide-updated a { color: var(--teal-text); text-decoration: none; font-weight: 600; }
    body.dark-mode .guide-breadcrumbs a { color: #22d3ee; }
    /* Samme som artikelsiden: den grå var 3,21:1 mod den mørke baggrund.
       Brødkrummens sidste led er sidens titel — det er indhold, ikke pynt. */
    body.dark-mode .guide-breadcrumbs { color: #b6bcc7; }
    .guide-breadcrumbs span { opacity: 1; }

    .guide-badge { display: inline-block; background: var(--accent); color: #fff; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; padding: 5px 12px; border-radius: 12px; margin-bottom: 14px; }
    .guide-title { font-size: 2.1rem; margin: 0 0 14px 0; line-height: 1.2; }
    .guide-lead { font-size: 1.15rem; line-height: 1.6; color: #4b5563; margin: 0 0 32px 0; padding-bottom: 24px; border-bottom: 1px solid var(--border-color); }
    body.dark-mode .guide-lead { color: #9ca3af; }

    .guide-body { font-size: 1.05rem; line-height: 1.8; color: var(--text-color); }
    .guide-body h2 { font-size: 1.45rem; margin: 38px 0 14px 0; padding-bottom: 8px; border-bottom: 2px solid var(--accent); }
    .guide-body p { margin: 0 0 18px 0; }
    .guide-body a { color: var(--teal-text); text-decoration: underline; }
    body.dark-mode .guide-body a { color: #22d3ee; }
    .guide-body strong { font-weight: 700; }

    .guide-videos { margin-top: 46px; padding-top: 28px; border-top: 1px solid var(--border-color); }
    .guide-videos h2 { font-size: 1.5rem; margin: 0 0 20px 0; }
    .guide-video-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px; }
    .guide-card { text-decoration: none; color: inherit; display: block; transition: transform 0.2s; }
    .guide-card:hover { transform: translateY(-3px); }
    .guide-card-thumb { aspect-ratio: 16/9; background-color: #000; border-radius: 10px; margin-bottom: 10px; position: relative; overflow: hidden; }
    .guide-card-thumb img { width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0; }
    .guide-card-badge { position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.8); color: #fff; padding: 2px 6px; border-radius: 4px; font-size: 12px; font-weight: 600; }
    .guide-card-title { margin: 0; font-size: 14px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .guide-card:hover .guide-card-title { color: var(--teal-text); }

    .guide-author { display: flex; gap: 20px; align-items: flex-start; width: 100%; box-sizing: border-box; background: var(--hover-bg); border: 1px solid var(--border-color); border-left: 4px solid var(--accent); border-radius: 10px; padding: 26px; margin-top: 46px; }
    .guide-author-photo { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; object-position: center top; flex-shrink: 0; }
    .guide-author-name { font-weight: 700; font-size: 1.1rem; margin: 0; }
    /* var(--accent) er emnets farve, og som tekst gav den 3,47:1 i mørk
       tilstand. Emnefarven står allerede på badge og kant. */
    .guide-author-title { font-size: 0.88rem; font-weight: 600; color: var(--teal-text); margin: 4px 0 12px 0; }
    .guide-author-note { font-size: 0.82rem; font-style: italic; color: #6b7280; margin: 0; padding-top: 14px; border-top: 1px solid var(--border-color); }
    body.dark-mode .guide-author-note { color: #9ca3af; }
    /* Uden en egen farve arvede linket noten's dæmpede grå og landede på
       1,65:1 i mørk tilstand. Et link skal kunne skelnes fra teksten omkring. */
    .guide-author-note a { color: var(--teal-text); font-weight: 600; text-decoration: none; }
    .guide-author-note a:hover { text-decoration: underline; }

    @media (max-width: 768px) {
      .guide-wrapper { padding: 24px 15px; }
      .guide-title { font-size: 1.6rem; }
      .guide-lead { font-size: 1.05rem; }
      .guide-video-grid { grid-template-columns: 1fr 1fr; gap: 14px; }
      .guide-author { padding: 20px; gap: 14px; }
      .guide-author-photo { width: 56px; height: 56px; }
    }
    @media (max-width: 460px) {
      .guide-video-grid { grid-template-columns: 1fr; }
    }
  </style>

  <div class="guide-wrapper" style={`--accent: ${accent}`}>
    <div class="guide-breadcrumbs">
      <a href="/">Frontpage</a> <span>/</span>
      <a href="/guides">Guides</a> <span>/</span>
      <span>{title}</span>
    </div>

    <span class="guide-badge">{category}</span>
    <h1 class="guide-title">{title}</h1>
    <p class="guide-lead">{description}</p>
    {updatedLabel && (
      <p class="guide-updated">Last updated <time datetime={updated!}>{updatedLabel}</time> · by <a href="/author/jacob-olsen">Jacob S. Olsen</a></p>
    )}

    <div class="guide-body">
      <guide.Content />
    </div>

    {matchedVideos.length > 0 && (
      <section class="guide-videos">
        <h2>Videos in this guide</h2>
        <div class="guide-video-grid">
          {matchedVideos.map((video: any) => (
            <a href={`/video/${video.file.split('/').pop().replace('.md', '')}`} class="guide-card">
              <div class="guide-card-thumb">
                <img src={`https://img.youtube.com/vi/${video.frontmatter.youtubeId}/mqdefault.jpg`} alt={video.frontmatter.title} loading="lazy" />
                <div class="guide-card-badge">{video.frontmatter.duration || '0:00'}</div>
              </div>
              <h3 class="guide-card-title">{video.frontmatter.title}</h3>
            </a>
          ))}
        </div>
      </section>
    )}

    {faqs && faqs.length > 0 && <FAQ faqs={faqs} />}

    <div class="guide-author">
      <img src="/jacob-olsen.png" alt="Jacob Olsen" class="guide-author-photo" width="72" height="72" />
      <div>
        <p class="guide-author-name">Jacob S. Olsen</p>
        <p class="guide-author-title">Runs Tech Feed Watch, from Denmark</p>
        <p class="guide-author-note">Guides are written and maintained by hand, unlike the article summaries on this site — <a href="/about">how that works</a>. If something here is wrong, <a href="/corrections">tell me</a>.</p>
      </div>
    </div>
  </div>
</MainLayout>
