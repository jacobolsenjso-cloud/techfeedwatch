---
import MainLayout from '../layouts/MainLayout.astro';

// Vises af service workeren når der ikke er forbindelse. noindex, fordi den
// aldrig skal dukke op i søgeresultater.
---

<MainLayout
  title="You're offline"
  description="Tech Feed Watch could not reach the network. Recently opened articles are still available."
  noindex={true}
>
  <div class="offline-wrap">
    <svg class="offline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M1 1l22 22" />
      <path d="M16.7 11.7a6 6 0 0 0-3.4-1.6" />
      <path d="M5 12.5a10 10 0 0 1 3.5-2.2" />
      <path d="M2 8.8a15 15 0 0 1 5-3" />
      <path d="M22 8.8a15 15 0 0 0-8.7-3.7" />
      <path d="M8.5 16.2a4 4 0 0 1 5 0" />
      <circle cx="12" cy="20" r="0.6" fill="currentColor" />
    </svg>

    <h1>You're offline</h1>
    <p class="offline-lead">
      We couldn't reach the network. Articles you've opened recently are still
      readable — this page will reconnect on its own once you're back.
    </p>

    <div class="offline-actions">
      <button type="button" id="offlineRetry" class="offline-btn offline-btn-primary">Try again</button>
      <a href="/" class="offline-btn offline-btn-secondary">Go to the front page</a>
    </div>

    <p class="offline-status" id="offlineStatus" hidden>Back online — reloading…</p>
  </div>

  <style is:global>
    .offline-wrap {
      max-width: 520px; margin: 0 auto; padding: 72px 24px;
      text-align: center; flex: 1;
    }
    .offline-icon { width: 56px; height: 56px; color: #6b7280; margin-bottom: 20px; }
    body.dark-mode .offline-icon { color: #9ca3af; }
    .offline-wrap h1 { margin: 0 0 10px 0; font-size: 1.7rem; font-weight: 800; letter-spacing: -0.02em; }
    .offline-lead { margin: 0 0 26px 0; font-size: 1rem; line-height: 1.6; color: #4b5563; }
    body.dark-mode .offline-lead { color: #a1a1aa; }
    .offline-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
    .offline-btn {
      font: inherit; font-size: 0.9rem; font-weight: 600;
      padding: 11px 22px; min-height: 44px; border-radius: 999px;
      display: inline-flex; align-items: center; cursor: pointer; text-decoration: none;
    }
    .offline-btn-primary { background: var(--teal-text); color: #fff; border: 1px solid var(--teal-text); }
    .offline-btn-secondary { background: transparent; color: var(--text-color); border: 1px solid var(--border-color); }
    .offline-btn-secondary:hover { background: var(--hover-bg); }
    .offline-status { margin-top: 18px; font-size: 0.88rem; color: var(--teal-text); font-weight: 600; }
  </style>

  <script is:inline>
    (function () {
      var btn = document.getElementById('offlineRetry');
      var status = document.getElementById('offlineStatus');
      if (btn) btn.addEventListener('click', function () { location.reload(); });
      // Kom forbindelsen tilbage, så hent siden igen af sig selv
      window.addEventListener('online', function () {
        if (status) status.hidden = false;
        setTimeout(function () { location.reload(); }, 600);
      });
    })();
  </script>
</MainLayout>
