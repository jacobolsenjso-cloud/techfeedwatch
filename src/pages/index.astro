  <div class="frontpage-wrapper" id="videoContainer">

    <div id="defaultView">
      {leadMain && (
        <section class="lead-section" aria-label="Latest analysis">
          <a href={`/video/${leadMain.file.split('/').pop().replace('.md', '')}`} class="lead-card">
            <div class="lead-card-thumb watch-card-thumb">
              {/* Ikke alle videoer har en maxres-udgave. Uden fallback viser
                  YouTube en grå pladsholder på sidens mest synlige billede. */}
              <img
                src={`https://img.youtube.com/vi/${leadMain.frontmatter.youtubeId}/maxresdefault.jpg`}
                alt="" loading="eager" fetchpriority="high"
                data-fallback={`https://img.youtube.com/vi/${leadMain.frontmatter.youtubeId}/hqdefault.jpg`}
                onerror="if(this.dataset.fallback){this.src=this.dataset.fallback;this.removeAttribute('data-fallback');}"
              />
            </div>
            {firstTag(leadMain) && (
              <span class="lead-eyebrow" style={`--tag-accent: ${TAG_COLORS[firstTag(leadMain) as string] || '#0891b2'}`}>{firstTag(leadMain)}</span>
            )}
            <h2 class="lead-title">{leadMain.frontmatter.title}</h2>
            <p class="lead-excerpt">{excerpt(leadMain.frontmatter.summary, 230)}</p>
            <SourceLine channel={leadMain.frontmatter.channelTitle} date={leadMain.frontmatter.date} minutesRead={leadMain.frontmatter.minutesRead} className="lead-meta" />
          </a>

          <div class="lead-secondary">
            {leadSide.map((video: any) => (
              <a href={`/video/${video.file.split('/').pop().replace('.md', '')}`} class="lead-mini">
                <div class="lead-mini-thumb watch-card-thumb">
                  <img src={`https://img.youtube.com/vi/${video.frontmatter.youtubeId}/mqdefault.jpg`} alt="" loading="lazy" />
                </div>
                <div>
                  <h3 class="lead-mini-title">{video.frontmatter.title}</h3>
                  <SourceLine channel={video.frontmatter.channelTitle} date={video.frontmatter.date} className="lead-mini-meta" />
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      {vRow1.length > 0 && (
        <>
        <div class="section-heading">
          <h2>Latest analysis</h2>
          <span class="section-note">Every article is our own written analysis of a third-party video.</span>
        </div>
        <div class="video-grid">
          {vRow1.map((video: any) => (
            <a href={`/video/${video.file.split('/').pop().replace('.md', '')}`} class="watch-card">
              <div class="watch-card-thumb">
                <img src={`https://img.youtube.com/vi/${video.frontmatter.youtubeId}/mqdefault.jpg`} alt="" loading="lazy" />
                <span class="watch-card-play" aria-hidden="true">▶</span>
              </div>
              <div>
                <h3 class="tma-grid-title">{video.frontmatter.title}</h3>
                <p class="card-excerpt">{excerpt(video.frontmatter.summary)}</p>
                <SourceLine channel={video.frontmatter.channelTitle} date={video.frontmatter.date} minutesRead={video.frontmatter.minutesRead} />
              </div>
            </a>
          ))}
        </div>
        </>
      )}

      {/* Værktøjerne står under første række artikler: artiklerne skal stadig
          føre an, men værktøjerne må ikke kræve at man leder efter dem. */}
      <section class="home-tools" aria-labelledby="home-tools-heading">
        <div class="home-tools-head">
          <div>
            <h2 id="home-tools-heading">Free tools we built</h2>
            <p>No sign-up, nothing uploaded — everything runs in your browser.</p>
          </div>
          <a href="/tools" class="home-tools-all">All {toolCount} tools →</a>
        </div>
        <div class="home-tools-grid">
          {homeTools.map((tool) => (
            <a href={`/tools/${tool.slug}`} class="home-tool">
              <span class="home-tool-icon" aria-hidden="true">{tool.icon}</span>
              <span class="home-tool-name">{tool.short}</span>
            </a>
          ))}
        </div>
      </section>

      {vRow2.length > 0 && (
        <div class="video-grid">
          {vRow2.map((video: any) => (
            <a href={`/video/${video.file.split('/').pop().replace('.md', '')}`} class="watch-card">
              <div class="watch-card-thumb">
                <img src={`https://img.youtube.com/vi/${video.frontmatter.youtubeId}/mqdefault.jpg`} alt="" loading="lazy" />
                <span class="watch-card-play" aria-hidden="true">▶</span>
              </div>
              <div>
                <h3 class="tma-grid-title">{video.frontmatter.title}</h3>
                <p class="card-excerpt">{excerpt(video.frontmatter.summary)}</p>
                <SourceLine channel={video.frontmatter.channelTitle} date={video.frontmatter.date} minutesRead={video.frontmatter.minutesRead} />
              </div>
            </a>
          ))}
        </div>
      )}

      {vRest.length > 0 && (
        <div class="video-grid">
          {vRest.map((video: any) => (
            <a href={`/video/${video.file.split('/').pop().replace('.md', '')}`} class="watch-card">
              <div class="watch-card-thumb">
                <img src={`https://img.youtube.com/vi/${video.frontmatter.youtubeId}/mqdefault.jpg`} alt="" loading="lazy" />
                <span class="watch-card-play" aria-hidden="true">▶</span>
              </div>
              <div>
                <h3 class="tma-grid-title">{video.frontmatter.title}</h3>
                <p class="card-excerpt">{excerpt(video.frontmatter.summary)}</p>
                <SourceLine channel={video.frontmatter.channelTitle} date={video.frontmatter.date} minutesRead={video.frontmatter.minutesRead} />
              </div>
            </a>
          ))}
