---
import MainLayout from '../layouts/MainLayout.astro';

const PAGE_SIZE = 24;

const allVideos = Object.values(import.meta.glob('../content/videos/*.md', { eager: true }));

const regularVideos = allVideos
  .filter((v: any) => !v.frontmatter.isShort)
  .sort((a: any, b: any) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());

const shorts = allVideos
  .filter((v: any) => v.frontmatter.isShort === true)
  .sort((a: any, b: any) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());

// Finder automatisk de 20 mest populære tags
const tagCounts = allVideos.reduce((acc: any, video: any) => {
  const t = video.frontmatter.tags || video.frontmatter.tag || [];
  const tagsArray = Array.isArray(t) ? t : [t];
  tagsArray.filter(Boolean).forEach((tag: string) => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {}) as Record<string, number>;
const topTags = Object.keys(tagCounts)
  .sort((a, b) => tagCounts[b] - tagCounts[a])
  .slice(0, 20);

// Emne-farvesystem, defineret lokalt (samme farver som sitemap.astro)
const TAG_COLORS: Record<string, string> = {
  "AI & Tech": "#3b82f6", "SEO": "#10b981", "Automation": "#f59e0b",
  "Coding": "#8b5cf6", "Business & Money": "#0d9488", "AI Video": "#ec4899",
  "Productivity": "#eab308", "Fintech": "#ef4444", "Crypto": "#d97706"
};

// Pæn dato-formatering: "2026-07-23" -> "Jul 23, 2026"
const formatDate = (d: string) => {
  const parsed = new Date(d);
  return isNaN(parsed.getTime()) ? d : parsed.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
};

// Side 1: kun de første 24 normale videoer. Resten pagineres via /page/2, /page/3 osv.
const pageOneVideos = regularVideos.slice(0, PAGE_SIZE);
const totalPages = Math.max(1, Math.ceil(regularVideos.length / PAGE_SIZE));

// Opdeler indholdet i blokke (rækker) - Shorts-hylderne vises kun her, på side 1
const vRow1 = pageOneVideos.slice(0, 4);
const sRow1 = shorts.slice(0, 6);
const vRow2 = pageOneVideos.slice(4, 8);
const sRow2 = shorts.slice(6, 12);
const vRest = pageOneVideos.slice(8);
---

<MainLayout title="Home">

  <style is:global>
    /* --- CSS specifik for forsiden --- */

    /* Tag Bar */
    .tag-bar-container {
      position: sticky;
      top: -1px; /* Klistrer perfekt op mod topbaren uden gab */
      background: var(--bg-color);
      z-index: 25;
      padding: 12px 20px;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      gap: 10px;
      overflow-x: auto;
      white-space: nowrap;
      scrollbar-width: none;
      min-height: 55px;
      box-sizing: border-box;
      margin-bottom: 25px;
    }
    .tag-bar-container::-webkit-scrollbar { display: none; }

    /* Pille-design der matcher videosiden (border-radius: 20px) */
    .filter-tag {
      background: var(--hover-bg); color: var(--text-color); border: 1px solid transparent;
      padding: 7px 16px; border-radius: 20px; font-size: 0.85rem; font-weight: 600;
      cursor: pointer; transition: background 0.2s; line-height: 1.5; display: inline-block;
    }
    .filter-tag:hover { background: #e5e7eb; }
    .filter-tag.active { background: #111; color: #fff; }
    body.dark-mode .filter-tag:hover { background: #334155; }
    body.dark-mode .filter-tag.active { background: #f1f5f9; color: #111; }

    /* Emne-farvesystem: diskret accent-prik pr. tag, fyldt farve når chippen er aktiv */
    .filter-tag-accent { border-color: var(--tag-accent); }
    .filter-tag-accent::before { content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--tag-accent); margin-right: 7px; vertical-align: middle; }
    .filter-tag-accent.active { background: var(--tag-accent); color: #fff; border-color: var(--tag-accent); }

    .home-hero { max-width: 1600px; margin: 22px auto 6px auto; padding: 0 20px; box-sizing: border-box; width: 100%; }
    .home-hero-card { position: relative; overflow: hidden; border-radius: 18px; border: 1px solid var(--border-color); background: linear-gradient(135deg, rgba(239,68,68,0.10), rgba(239,68,68,0.02) 62%); padding: 38px 34px; }
    .home-hero-card::after { content: ''; position: absolute; top: -45%; right: -8%; width: 360px; height: 360px; background: radial-gradient(circle, rgba(239,68,68,0.16), transparent 70%); pointer-events: none; }
    .home-hero-title { margin: 0 0 10px 0; font-size: 2.1rem; font-weight: 800; letter-spacing: -0.03em; }
    .home-hero-sub { margin: 0 0 20px 0; font-size: 1.05rem; line-height: 1.6; color: #4b5563; max-width: 640px; position: relative; }
    body.dark-mode .home-hero-sub { color: #b8b3bd; }
    .home-hero-links { display: flex; flex-wrap: wrap; gap: 10px; position: relative; }
    .home-hero-link { display: inline-flex; align-items: center; gap: 7px; background: var(--card-bg); border: 1px solid var(--border-color); color: var(--text-color); text-decoration: none; padding: 9px 16px; border-radius: 999px; font-weight: 600; font-size: 0.9rem; transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease; }
    .home-hero-link:hover { transform: translateY(-2px); border-color: #ef4444; box-shadow: 0 6px 24px rgba(0,0,0,0.06), 0 2px 8px rgba(0,0,0,0.04); }
    @media (max-width: 768px) { .home-hero { margin: 15px auto 4px; padding: 0 15px; } .home-hero-card { padding: 26px 20px; border-radius: 14px; } .home-hero-title { font-size: 1.6rem; } .home-hero-sub { font-size: 0.98rem; } }

    .frontpage-wrapper { padding: 0 20px 20px 20px; max-width: 1600px; margin: 0 auto; flex: 1; width: 100%; box-sizing: border-box; }

    /* Video Grid */
    .video-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-bottom: 40px; }
    .watch-card { text-decoration: none; color: inherit; display: block; transition: transform 0.2s; }
    .watch-card:hover { transform: translateY(-3px); }
    .watch-card-thumb { aspect-ratio: 16/9; background-color: #000; background-size: cover; background-position: center; border-radius: 12px; position: relative; margin-bottom: 10px; overflow: hidden; }
    .duration-badge { position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.8); color: white; padding: 2px 6px; border-radius: 4px; font-size: 12px; font-weight: 600; letter-spacing: 0.5px; }

    .tma-grid-title { margin: 0 0 5px 0; font-size: 15px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;}
    .watch-card:hover .tma-grid-title { color: #ef4444; }
    .watch-card-thumb img, .short-card-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1); }
    .watch-card:hover .watch-card-thumb img, .watch-card:hover .short-card-thumb img { transform: scale(1.06); }
    .watch-card:hover .watch-card-thumb, .watch-card:hover .short-card-thumb { box-shadow: 0 6px 24px rgba(0,0,0,0.10), 0 2px 8px rgba(0,0,0,0.05); }
    .watch-card-play { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0.8); width: 52px; height: 52px; border-radius: 50%; background: rgba(0,0,0,0.55); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.05rem; padding-left: 3px; opacity: 0; transition: opacity 0.25s ease, transform 0.25s ease; pointer-events: none; }
    .watch-card:hover .watch-card-play { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    @media (prefers-reduced-motion: reduce) { .watch-card-thumb img, .short-card-thumb img { transition: none; } .watch-card:hover .watch-card-thumb img, .watch-card:hover .short-card-thumb img { transform: none; } }
    .tma-grid-meta { font-size: 13px; color: #6b7280; margin: 0; }
    body.dark-mode .tma-grid-meta { color: #9ca3af; }

    .no-results { grid-column: 1 / -1; text-align: center; padding: 60px 20px; color: #6b7280; font-size: 1rem; }
    body.dark-mode .no-results { color: #9ca3af; }

    /* Shorts Shelf */
    .shorts-shelf { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 15px; margin-bottom: 40px; }
    .short-card-thumb { aspect-ratio: 9/16; background-size: cover; background-position: center; border-radius: 12px; position: relative; overflow: hidden; }

    /* Paginering */
    .pagination { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 20px 0 40px 0; flex-wrap: wrap; }
    .pagination-btn, .pagination-num { display: inline-flex; align-items: center; justify-content: center; min-width: 40px; height: 40px; padding: 0 16px; border-radius: 20px; background: var(--hover-bg); color: var(--text-color); text-decoration: none; font-size: 0.9rem; font-weight: 600; transition: background 0.2s; border: none; box-sizing: border-box; cursor: pointer; }
    .pagination-num { min-width: 40px; padding: 0; }
    .pagination-btn:hover, .pagination-num:hover { background: #e5e7eb; }
    body.dark-mode .pagination-btn:hover, body.dark-mode .pagination-num:hover { background: #334155; }
    .pagination-num.active { background: #111; color: #fff; }
    body.dark-mode .pagination-num.active { background: #f1f5f9; color: #111; }
    .pagination-disabled { opacity: 0.4; pointer-events: none; }

    @media (max-width: 768px) {
      .frontpage-wrapper { padding: 15px; }
      .video-grid { grid-template-columns: 1fr; gap: 20px; }
      .shorts-shelf { grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .watch-card-thumb { border-radius: 8px; }

      /* Edge-to-edge tags på mobil, ligesom på videosiden */
      .tag-bar-container {
        margin-left: -15px;
        margin-right: -15px;
        width: calc(100% + 30px);
        padding: 10px 15px;
      }

      .pagination { gap: 6px; }
      .pagination-btn, .pagination-num { min-width: 36px; height: 36px; padding: 0 12px; font-size: 0.85rem; }
    }
  </style>

  <section class="home-hero">
    <div class="home-hero-card">
      <h1 class="home-hero-title">Tech, distilled.</h1>
      <p class="home-hero-sub">The best videos in AI, tech, fintech, and crypto — turned into sharp, unbiased analysis you can actually read. Updated daily.</p>
      <div class="home-hero-links">
        <a href="/guides" class="home-hero-link">🧭 Guides</a>
        <a href="/tools" class="home-hero-link">🛠️ Tools</a>
        <a href="/glossary" class="home-hero-link">📖 Glossary</a>
      </div>
    </div>
  </section>

  <div class="tag-bar-container">
    <button class="filter-tag active" data-tag="All">All</button>
    {topTags.map((tag: any) => (
      TAG_COLORS[tag] ? (
        <button class="filter-tag filter-tag-accent" data-tag={tag} style={`--tag-accent: ${TAG_COLORS[tag]}`}>{tag}</button>
      ) : (
        <button class="filter-tag" data-tag={tag}>{tag}</button>
      )
    ))}
  </div>

  <div class="frontpage-wrapper" id="videoContainer">

    <div id="defaultView">
      {vRow1.length > 0 && (
        <div class="video-grid">
          {vRow1.map((video: any) => (
            <a href={`/video/${video.file.split('/').pop().replace('.md', '')}`} class="watch-card">
              <div class="watch-card-thumb">
                <img src={`https://img.youtube.com/vi/${video.frontmatter.youtubeId}/mqdefault.jpg`} alt={video.frontmatter.title} loading="lazy" />
                <div class="duration-badge">{video.frontmatter.duration || '0:00'}</div>
                <span class="watch-card-play" aria-hidden="true">▶</span>
              </div>
              <div>
                <h3 class="tma-grid-title">{video.frontmatter.title}</h3>
                <p class="tma-grid-meta">Tech Feed Watch • {formatDate(video.frontmatter.date)}</p>
              </div>
            </a>
          ))}
        </div>
      )}

      {sRow1.length > 0 && (
        <div class="shorts-section">
          <h2 style="font-size: 1.2rem; margin-bottom: 15px;"><span style="color: #ef4444;">⚡</span> Shorts</h2>
          <div class="shorts-shelf">
            {sRow1.map((short: any) => (
              <a href={`/video/${short.file.split('/').pop().replace('.md', '')}`} class="watch-card">
                <div class="short-card-thumb">
                  <img src={`https://img.youtube.com/vi/${short.frontmatter.youtubeId}/maxresdefault.jpg`} alt={short.frontmatter.title} loading="lazy" />
                  <div class="duration-badge">{short.frontmatter.duration || 'Short'}</div>
                </div>
                <h3 class="tma-grid-title" style="margin-top: 8px;">{short.frontmatter.title}</h3>
              </a>
            ))}
          </div>
        </div>
      )}

      {vRow2.length > 0 && (
        <div class="video-grid">
          {vRow2.map((video: any) => (
            <a href={`/video/${video.file.split('/').pop().replace('.md', '')}`} class="watch-card">
              <div class="watch-card-thumb">
                <img src={`https://img.youtube.com/vi/${video.frontmatter.youtubeId}/mqdefault.jpg`} alt={video.frontmatter.title} loading="lazy" />
                <div class="duration-badge">{video.frontmatter.duration || '0:00'}</div>
                <span class="watch-card-play" aria-hidden="true">▶</span>
              </div>
              <div>
                <h3 class="tma-grid-title">{video.frontmatter.title}</h3>
                <p class="tma-grid-meta">Tech Feed Watch • {formatDate(video.frontmatter.date)}</p>
              </div>
            </a>
          ))}
        </div>
      )}

      {sRow2.length > 0 && (
        <div class="shorts-section">
          <h2 style="font-size: 1.2rem; margin-bottom: 15px;"><span style="color: #ef4444;">⚡</span> More Shorts</h2>
          <div class="shorts-shelf">
            {sRow2.map((short: any) => (
              <a href={`/video/${short.file.split('/').pop().replace('.md', '')}`} class="watch-card">
                <div class="short-card-thumb">
                  <img src={`https://img.youtube.com/vi/${short.frontmatter.youtubeId}/maxresdefault.jpg`} alt={short.frontmatter.title} loading="lazy" />
                  <div class="duration-badge">{short.frontmatter.duration || 'Short'}</div>
                </div>
                <h3 class="tma-grid-title" style="margin-top: 8px;">{short.frontmatter.title}</h3>
              </a>
            ))}
          </div>
        </div>
      )}

      {vRest.length > 0 && (
        <div class="video-grid">
          {vRest.map((video: any) => (
            <a href={`/video/${video.file.split('/').pop().replace('.md', '')}`} class="watch-card">
              <div class="watch-card-thumb">
                <img src={`https://img.youtube.com/vi/${video.frontmatter.youtubeId}/mqdefault.jpg`} alt={video.frontmatter.title} loading="lazy" />
                <div class="duration-badge">{video.frontmatter.duration || '0:00'}</div>
                <span class="watch-card-play" aria-hidden="true">▶</span>
              </div>
              <div>
                <h3 class="tma-grid-title">{video.frontmatter.title}</h3>
                <p class="tma-grid-meta">Tech Feed Watch • {formatDate(video.frontmatter.date)}</p>
              </div>
            </a>
          ))}
        </div>
      )}

      {totalPages > 1 && (
        <nav class="pagination" aria-label="Sidenavigation">
          <span class="pagination-btn pagination-disabled" aria-disabled="true">← Previous</span>
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((n: number) => (
            n === 1 ? (
              <span class="pagination-num active" aria-current="page">{n}</span>
            ) : (
              <a href={`/page/${n}`} class="pagination-num">{n}</a>
            )
          ))}
          <a href="/page/2" class="pagination-btn">Next →</a>
        </nav>
      )}
    </div>

    <div id="filteredResults" class="video-grid" style="display:none;"></div>

  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Live Search & Tag Filtering (Koblet sammen med MainLayout's søgefelt)
      // Filtrerer på tværs af ALLE videoer (ikke kun den aktuelle side) via /videos.json
      const searchInput = document.getElementById('topSearchInput');
      const filterTags = document.querySelectorAll('.filter-tag');
      const defaultView = document.getElementById('defaultView');
      const filteredResults = document.getElementById('filteredResults');

      let allVideosData = [];
      let videosReady = false;

      fetch('/videos.json')
        .then(res => res.json())
        .then(data => { allVideosData = data; videosReady = true; filterVideos(); })
        .catch(() => { allVideosData = []; videosReady = true; });

      function formatDateJS(d) {
        const parsed = new Date(d);
        return isNaN(parsed.getTime()) ? d : parsed.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
      }

      function buildCard(video) {
        const thumbUrl = video.isShort
          ? `https://img.youtube.com/vi/${video.youtubeId}/maxresdefault.jpg`
          : `https://img.youtube.com/vi/${video.youtubeId}/mqdefault.jpg`;

        const card = document.createElement('a');
        card.href = `/video/${video.slug}`;
        card.className = 'watch-card';

        const thumb = document.createElement('div');
        thumb.className = 'watch-card-thumb';

        const img = document.createElement('img');
        img.src = thumbUrl;
        img.alt = video.title;
        img.loading = 'lazy';
        thumb.appendChild(img);

        const duration = document.createElement('div');
        duration.className = 'duration-badge';
        duration.textContent = video.duration || (video.isShort ? 'Short' : '0:00');
        thumb.appendChild(duration);

        const play = document.createElement('span');
        play.className = 'watch-card-play';
        play.setAttribute('aria-hidden', 'true');
        play.textContent = '▶';
        thumb.appendChild(play);

        const info = document.createElement('div');
        const titleEl = document.createElement('h3');
        titleEl.className = 'tma-grid-title';
        titleEl.textContent = video.title;
        const metaEl = document.createElement('p');
        metaEl.className = 'tma-grid-meta';
        metaEl.textContent = `Tech Feed Watch • ${formatDateJS(video.date)}`;
        info.appendChild(titleEl);
        info.appendChild(metaEl);

        card.appendChild(thumb);
        card.appendChild(info);
        return card;
      }

      function renderFilteredResults(query, activeTag) {
        filteredResults.innerHTML = '';
        const matches = allVideosData.filter(video => {
          const matchesSearch = video.title.toLowerCase().includes(query);
          const matchesTag = activeTag === 'All' || (video.tags || []).includes(activeTag);
          return matchesSearch && matchesTag;
        });

        if (matches.length === 0) {
          const emptyMsg = document.createElement('p');
          emptyMsg.className = 'no-results';
          emptyMsg.textContent = 'No videos found.';
          filteredResults.appendChild(emptyMsg);
          return;
        }

        matches.forEach(video => filteredResults.appendChild(buildCard(video)));
      }

      function filterVideos() {
        const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
        const activeTagBtn = document.querySelector('.filter-tag.active');
        const activeTag = activeTagBtn ? activeTagBtn.getAttribute('data-tag') : 'All';
        const isFiltering = activeTag !== 'All' || query !== '';

        if (!isFiltering) {
          if (defaultView) defaultView.style.display = '';
          if (filteredResults) filteredResults.style.display = 'none';
          return;
        }

        if (defaultView) defaultView.style.display = 'none';
        if (filteredResults) {
          filteredResults.style.display = '';
          if (videosReady) {
            renderFilteredResults(query, activeTag);
          } else {
            filteredResults.innerHTML = '';
          }
        }
      }

      if (searchInput) {
        searchInput.addEventListener('input', filterVideos);
      }

      filterTags.forEach(tagBtn => {
        tagBtn.addEventListener('click', (e) => {
          filterTags.forEach(btn => btn.classList.remove('active'));
          e.target.classList.add('active');
          filterVideos();
        });
      });
    });
  </script>
</MainLayout>
