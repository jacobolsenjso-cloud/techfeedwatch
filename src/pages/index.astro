    <div id="filteredResults" class="video-grid" style="display:none;"></div>

  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // --- Emnerækken: to rækker, resten bag en knap ---
      // Med 12 emner løb den gamle vandrette række ud over skærmkanten, og et
      // tag man skal skulle efter, bliver ikke fundet. Højden på to rækker
      // måles i stedet for at gættes, så det holder uanset skriftstørrelse,
      // bredde og hvor lange emnenavnene bliver.
      const tagBar = document.getElementById('tagBar');
      const tagMore = document.getElementById('tagMore');

      function setupTagRows() {
        if (!tagBar || !tagMore) return;
        tagBar.classList.remove('expanded');
        tagBar.style.setProperty('--tag-rows', 'none');

        const chips = Array.from(tagBar.querySelectorAll('.filter-tag'));
        if (!chips.length) return;
        const firstTop = chips[0].offsetTop;
        const rowTops = [...new Set(chips.map((c) => c.offsetTop))].sort((a, b) => a - b);

        // Passer alt på to rækker eller færre, er der intet at folde ud
        if (rowTops.length <= 2) {
          tagMore.hidden = true;
          tagBar.style.removeProperty('--tag-rows');
          tagBar.style.maxHeight = 'none';
          return;
        }

        const secondRowTop = rowTops[1];
        const rowHeight = chips[0].offsetHeight;
        const padding = parseFloat(getComputedStyle(tagBar).paddingTop) || 12;
        const hidden = chips.filter((c) => c.offsetTop > secondRowTop);

        tagBar.style.maxHeight = '';
        tagBar.style.setProperty('--tag-rows', `${secondRowTop - firstTop + rowHeight + padding * 2}px`);
        tagMore.hidden = false;
        tagMore.textContent = `+${hidden.length} more`;
        tagMore.setAttribute('aria-expanded', 'false');

        // Er det aktive emne gemt, foldes rækken ud af sig selv — ellers ser
        // det ud som om filteret er slået fra.
        if (hidden.some((c) => c.classList.contains('active'))) toggleTagRows(true);
      }

      function toggleTagRows(open) {
        const expand = open !== undefined ? open : !tagBar.classList.contains('expanded');
        tagBar.classList.toggle('expanded', expand);
        tagMore.setAttribute('aria-expanded', String(expand));
        if (expand) {
          tagMore.textContent = 'Show fewer';
        } else {
          setupTagRows();
        }
      }

      if (tagMore) tagMore.addEventListener('click', () => toggleTagRows());
      setupTagRows();
      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(setupTagRows, 180);
      });

      // Live Search & Tag Filtering (Koblet sammen med MainLayout's søgefelt)
      // Filtrerer på tværs af ALLE videoer (ikke kun den aktuelle side) via /videos.json
      const searchInput = document.getElementById('topSearchInput');
      const filterTags = document.querySelectorAll('.filter-tag');
      const defaultView = document.getElementById('defaultView');
      const filteredResults = document.getElementById('filteredResults');

      let allVideosData = [];
      let videosReady = false;

      fetch('/videos.json')
        .then(res => res.json())
        .then(data => { allVideosData = data; videosReady = true; filterVideos(); })
        .catch(() => { allVideosData = []; videosReady = true; });

      function formatDateJS(d) {
        const parsed = new Date(d);
        return isNaN(parsed.getTime()) ? d : parsed.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
      }

      function markLoaded(img) {
        const thumb = img.closest('.watch-card-thumb, .short-card-thumb');
        if (!thumb) return;
        const done = () => thumb.classList.add('is-loaded');
        if (img.complete && img.naturalWidth > 0) done();
        else { img.addEventListener('load', done); img.addEventListener('error', done); }
      }

      function buildCard(video) {
        const thumbUrl = video.isShort
          ? `https://img.youtube.com/vi/${video.youtubeId}/maxresdefault.jpg`
          : `https://img.youtube.com/vi/${video.youtubeId}/mqdefault.jpg`;

        const card = document.createElement('a');
        card.href = `/video/${video.slug}`;
        card.className = 'watch-card';

        const thumb = document.createElement('div');
        thumb.className = 'watch-card-thumb';

        const img = document.createElement('img');
        img.src = thumbUrl;
        img.alt = video.title;
        img.loading = 'lazy';
        thumb.appendChild(img);
        markLoaded(img);


        const play = document.createElement('span');
        play.className = 'watch-card-play';
        play.setAttribute('aria-hidden', 'true');
        play.textContent = '▶';
        thumb.appendChild(play);

        const info = document.createElement('div');
        const titleEl = document.createElement('h3');
        titleEl.className = 'tma-grid-title';
        titleEl.textContent = video.title;
        info.appendChild(titleEl);

        // Udpluk, så filtrerede kort ser ud som de statisk renderede
        if (video.summary) {
          const excerptEl = document.createElement('p');
          excerptEl.className = 'card-excerpt';
          const s = video.summary.trim();
          excerptEl.textContent = s.length > 145
            ? s.slice(0, 145).replace(/\s+\S*$/, '').trim() + '…'
            : s;
          info.appendChild(excerptEl);
        }

        // Kilde + dato. Kanalen krediteres når vi kender den.
        const metaEl = document.createElement('p');
        metaEl.className = 'tma-grid-meta';
        if (video.channelTitle) {
          const src = document.createElement('span');
          src.className = 'card-source';
          src.textContent = video.channelTitle;
          metaEl.appendChild(src);
          metaEl.appendChild(document.createTextNode(' · '));
        }
        metaEl.appendChild(document.createTextNode(formatDateJS(video.date)));
        info.appendChild(metaEl);

        card.appendChild(thumb);
        card.appendChild(info);
        return card;
      }

      function renderFilteredResults(query, activeTag) {
        filteredResults.innerHTML = '';
        const matches = allVideosData.filter(video => {
          const matchesSearch = video.title.toLowerCase().includes(query);
          const matchesTag = activeTag === 'All' || (video.tags || []).includes(activeTag);
          return matchesSearch && matchesTag;
        });

        if (matches.length === 0) {
          const emptyMsg = document.createElement('p');
          emptyMsg.className = 'no-results';
          emptyMsg.textContent = 'No videos found.';
          filteredResults.appendChild(emptyMsg);
          return;
        }

        matches.forEach(video => filteredResults.appendChild(buildCard(video)));
      }

      function filterVideos() {
        const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
        const activeTagBtn = document.querySelector('.filter-tag.active');
        const activeTag = activeTagBtn ? activeTagBtn.getAttribute('data-tag') : 'All';
        const isFiltering = activeTag !== 'All' || query !== '';

        if (!isFiltering) {
          if (defaultView) defaultView.style.display = '';
          if (filteredResults) filteredResults.style.display = 'none';
          return;
        }

        if (defaultView) defaultView.style.display = 'none';
        if (filteredResults) {
          filteredResults.style.display = '';
          if (videosReady) {
            renderFilteredResults(query, activeTag);
          } else {
            filteredResults.innerHTML = '';
          }
        }
      }

      // Tekstsøgning håndteres nu globalt via dropdown i toppen (MainLayout). Tag-filtrering bevares.
      filterTags.forEach(tagBtn => {
        tagBtn.addEventListener('click', (e) => {
          filterTags.forEach(btn => btn.classList.remove('active'));
          e.target.classList.add('active');
          filterVideos();
        });
      });

      // Loading-skeleton: marker thumbnails som loadet, så shimmer stopper når billedet er hentet
      document.querySelectorAll('.watch-card-thumb img, .short-card-thumb img').forEach(markLoaded);

      // (Den gamle fade-maske hørte til den vandrette tag-række og er fjernet
      // sammen med den. Den deklarerede tagBar en gang mere, og fordi begge lå
      // i samme script, kastede siden "Identifier 'tagBar' has already been
      // declared" — så HELE scriptet stoppede, inklusive tag-filtreringen.
      // En dobbelt const er ikke en advarsel; den slår resten af filen ihjel.)
    });
  </script>

  <!-- Mobil emne-genvej: da sticky-baren blev statisk på mobil (26/8, den
       skjulte footeren), mistede mobilbrugere hurtig adgang til filtrene midt
       på siden. Knappen viser sig først når emne-baren er scrollet ud af syne,
       og panelets chips DELEGERER klikket til de rigtige chips i baren — al
       filter-logik (active-tilstand, videos.json, visninger) genbruges urørt.
       Kun mobil: desktop har stadig sticky-baren og behøver ingen genvej. -->
  <button type="button" id="topicFab" class="topic-fab" hidden aria-label="Filter by topic" aria-expanded="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="18" height="18" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="7" y1="12" x2="17" y2="12"></line><line x1="10" y1="18" x2="14" y2="18"></line></svg>
    Topics
  </button>
  <div id="topicSheet" class="topic-sheet" hidden role="dialog" aria-label="Choose topic">
    <div class="topic-sheet-inner" id="topicSheetInner"></div>
  </div>

  <style>
    .topic-fab, .topic-sheet { display: none; }
    @media (max-width: 768px) {
      .topic-fab {
        position: fixed; bottom: 20px; left: 20px; z-index: 60;
        display: flex; align-items: center; gap: 7px;
        height: 44px; padding: 0 16px; border-radius: 22px;
        background: var(--card-bg); color: var(--text-color);
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 14px rgba(0,0,0,0.18);
        font-size: 0.9rem; font-weight: 600; cursor: pointer;
      }
      .topic-fab[hidden] { display: none; }
      .topic-sheet {
        position: fixed; left: 12px; right: 12px; bottom: 76px; z-index: 59;
        display: block; background: var(--card-bg);
        border: 1px solid var(--border-color); border-radius: 14px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.25);
        padding: 14px; max-height: 55vh; overflow-y: auto;
      }
      .topic-sheet[hidden] { display: none; }
      .topic-sheet-inner { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
      .topic-sheet-chip {
        padding: 9px 15px; border-radius: 20px; font-size: 0.85rem; font-weight: 600;
        background: var(--hover-bg); color: var(--text-color);
        border: 1px solid var(--tag-accent, var(--border-color)); cursor: pointer;
      }
      .topic-sheet-chip.active { background: var(--tag-accent, #111); color: #fff; border-color: var(--tag-accent, #111); }
      body.dark-mode .topic-sheet-chip.active { color: #fff; }
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const fab = document.getElementById('topicFab');
      const sheet = document.getElementById('topicSheet');
      const inner = document.getElementById('topicSheetInner');
      const bar = document.querySelector('.tag-bar-outer');
      if (!fab || !sheet || !inner || !bar) return;

      // Knappen viser sig når baren er ude af syne — ellers er den bare støj.
      const io = new IntersectionObserver(([e]) => {
        fab.hidden = e.isIntersecting;
        if (e.isIntersecting) { sheet.hidden = true; fab.setAttribute('aria-expanded', 'false'); }
      });
      io.observe(bar);

      const byg = () => {
        inner.innerHTML = '';
        document.querySelectorAll('.tag-bar-container .filter-tag').forEach((orig) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'topic-sheet-chip' + (orig.classList.contains('active') ? ' active' : '');
          b.textContent = orig.textContent.trim();
          const accent = orig.style.getPropertyValue('--tag-accent');
          if (accent) b.style.setProperty('--tag-accent', accent);
          b.addEventListener('click', () => {
            orig.click(); // delegér: den rigtige chip ejer al logik
            sheet.hidden = true;
            fab.setAttribute('aria-expanded', 'false');
            bar.scrollIntoView({ behavior: 'smooth' }); // vis chips + resultater
          });
          inner.appendChild(b);
        });
      };

      fab.addEventListener('click', () => {
        if (sheet.hidden) { byg(); sheet.hidden = false; fab.setAttribute('aria-expanded', 'true'); }
        else { sheet.hidden = true; fab.setAttribute('aria-expanded', 'false'); }
      });
      document.addEventListener('click', (e) => {
        if (!sheet.hidden && !sheet.contains(e.target) && !fab.contains(e.target)) {
          sheet.hidden = true; fab.setAttribute('aria-expanded', 'false');
        }
      });
    });
  </script>
</MainLayout>
