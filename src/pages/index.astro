---
import MainLayout from '../layouts/MainLayout.astro';
import SourceLine from '../components/SourceLine.astro';
import { TOOLS, featuredTools } from '../lib/tools';

const PAGE_SIZE = 24;

// Værktøjerne er det eneste på sitet vi selv har bygget, og de lå gemt bag ét
// menupunkt. Seks udvalgte vises på forsiden — én fra hver kategori plus lidt
// ekstra vægt til dem med bredest brug.
const homeTools = featuredTools();
const toolCount = TOOLS.length;

const allVideos = Object.values(import.meta.glob('../content/videos/*.md', { eager: true }));

const regularVideos = allVideos
  .filter((v: any) => !v.frontmatter.isShort)
  .sort((a: any, b: any) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());

// Finder automatisk de 20 mest populære tags
const tagCounts = allVideos.reduce((acc: any, video: any) => {
  const t = video.frontmatter.tags || video.frontmatter.tag || [];
  const tagsArray = Array.isArray(t) ? t : [t];
  tagsArray.filter(Boolean).forEach((tag: string) => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {}) as Record<string, number>;
const topTags = Object.keys(tagCounts)
  .sort((a, b) => tagCounts[b] - tagCounts[a])
  .slice(0, 20);

// Emne-farvesystem, defineret lokalt (samme farver som sitemap.astro)
const TAG_COLORS: Record<string, string> = {
  "AI & Tech": "#06b6d4", "SEO": "#6366f1", "Automation": "#14b8a6",
  "Coding": "#2563eb", "Business & Money": "#059669", "AI Video": "#d926c8",
  "Productivity": "#8b5cf6", "Fintech": "#1e3a8a", "Crypto": "#f59e0b",
  "Cybersecurity": "#dc2626", "Quantum Computing": "#7c3aed", "Hardware & Chips": "#ea580c", "AR & VR": "#db2777"
};

// Pæn dato-formatering: "2026-07-23" -> "Jul 23, 2026"
const formatDate = (d: string) => {
  const parsed = new Date(d);
  return isNaN(parsed.getTime()) ? d : parsed.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
};

// Side 1: kun de første 24 normale videoer. Resten pagineres via /page/2, /page/3 osv.
const pageOneVideos = regularVideos.slice(0, PAGE_SIZE);
const totalPages = Math.max(1, Math.ceil(regularVideos.length / PAGE_SIZE));

// Redaktionel topsektion: dagens hovedhistorie + to sekundære. Tekst vægtes over
// thumbnail, så forsiden læses som en publikation frem for en videoliste.
const leadMain = pageOneVideos[0] || null;
// Fire sekundære, så højre kolonne er nogenlunde lige så høj som hovedhistorien
// og ikke efterlader et stort tomt felt ved siden af.
const leadSide = pageOneVideos.slice(1, 5);

// Kort hjælper til kortenes udpluk — summary er ofte 400+ tegn.
// Afsluttende tegnsætning fjernes før ellipsen, ellers ender man med "sector...."
const excerpt = (text: string, max = 145) => {
  const s = (text || '').trim();
  if (s.length <= max) return s;
  return s.slice(0, max).replace(/\s+\S*$/, '').replace(/[.,;:!?—-]+$/, '').trim() + '…';
};

// Primært tag bruges som "eyebrow" over hovedhistorien
const firstTag = (v: any): string | null => {
  const t = v?.frontmatter?.tags || v?.frontmatter?.tag || [];
  const arr = Array.isArray(t) ? t : [t];
  return arr.filter(Boolean)[0] || null;
};

// Opdeler resten i blokke (rækker)
const vRow1 = pageOneVideos.slice(5, 9);
const vRow2 = pageOneVideos.slice(9, 13);
const vRest = pageOneVideos.slice(13);
---

<MainLayout title="AI, Tech, Fintech & Crypto News, Explained" description="Tech Feed Watch turns the best AI, tech, fintech, and crypto videos into clear, readable analysis you can absorb in minutes. Updated daily.">

  <style is:global>
    /* --- CSS specifik for forsiden --- */

    /* Tag Bar */
    /* Yderste beholder er den klistrende. Knappen SKAL ligge her og ikke inde i
       den beskårne række — første forsøg lagde den inde i rækken, hvor den selv
       havnede på tredje linje og blev skjult af netop den beskæring den skulle
       ophæve. */
    .tag-bar-outer {
      position: sticky;
      top: -1px;
      background: var(--bg-color);
      z-index: 25;
      border-bottom: 1px solid var(--border-color);
      margin-bottom: 25px;
    }
    .tag-bar-container {
      padding: 12px 20px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      min-height: 55px;
      box-sizing: border-box;
      /* Sammenklappet viser den to rækker. Med 12 emner løb den vandrette
         udgave ud over kanten, og et tag man skal skulle efter, findes ikke.
         --tag-rows sættes af JS til den reelle højde af to rækker, så det
         virker uanset skriftstørrelse og bredde. */
      max-height: var(--tag-rows, 96px);
      overflow: hidden;
      transition: max-height 0.25s ease;
    }
    .tag-bar-container.expanded { max-height: 600px; }

    /* Knappen står på sin EGEN linje under rækken. Første forsøg placerede den
       absolut i højre hjørne og reserverede plads med padding — den plads holdt
       ikke på alle bredder, og knappen lagde sig oven på det sidste emne. En
       egen linje koster 30 px og kan ikke overlappe noget. */
    .tag-more {
      display: block; margin: 0 auto 10px auto;
      background: var(--bg-color); border: 1px dashed var(--border-color); color: #6b7280;
      padding: 6px 16px; border-radius: 20px; font-size: 0.82rem; font-weight: 600;
      cursor: pointer; line-height: 1.5; white-space: nowrap;
    }
    .tag-more:hover { border-color: var(--teal-text); color: var(--teal-text); }
    .tag-more[hidden] { display: none; }
    body.dark-mode .tag-more { color: #9ca3af; }

    /* Pille-design der matcher videosiden (border-radius: 20px) */
    .filter-tag {
      background: var(--hover-bg); color: var(--text-color); border: 1px solid transparent;
      padding: 7px 16px; border-radius: 20px; font-size: 0.85rem; font-weight: 600;
      cursor: pointer; transition: background 0.2s; line-height: 1.5; display: inline-flex; align-items: center; min-height: 44px; box-sizing: border-box;
    }
    .filter-tag:hover { background: #e5e7eb; }
    .filter-tag.active { background: #111; color: #fff; }
    body.dark-mode .filter-tag:hover { background: #334155; }
    body.dark-mode .filter-tag.active { background: #f1f5f9; color: #111; }

    /* Emne-farvesystem: diskret accent-prik pr. tag, fyldt farve når chippen er aktiv */
    .filter-tag-accent { border-color: var(--tag-accent); }
    .filter-tag-accent::before { content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--tag-accent); margin-right: 7px; vertical-align: middle; }
    .filter-tag-accent.active { background: var(--tag-accent); color: #fff; border-color: var(--tag-accent); }

    .home-hero { max-width: 1600px; margin: 22px auto 6px auto; padding: 0 20px; box-sizing: border-box; width: 100%; }
    .home-hero-card { position: relative; overflow: hidden; border-radius: 18px; border: 1px solid var(--border-color); background: linear-gradient(135deg, rgba(8, 145, 178,0.10), rgba(8, 145, 178,0.02) 62%); padding: 38px 34px; }
    .home-hero-card::after { content: ''; position: absolute; top: -45%; right: -8%; width: 360px; height: 360px; background: radial-gradient(circle, rgba(8, 145, 178,0.16), transparent 70%); pointer-events: none; }
    .home-hero-title { margin: 0 0 10px 0; font-size: 2.1rem; font-weight: 800; letter-spacing: -0.03em; }
    .home-hero-sub { margin: 0 0 20px 0; font-size: 1.05rem; line-height: 1.6; color: #4b5563; max-width: 640px; position: relative; }
    body.dark-mode .home-hero-sub { color: #b8b3bd; }
    /* Tillidslinjen: mindre end underteksten, men stadig over 4,5:1 i kontrast.
       Fluebenet er dekorativt og bliver derfor skjult for skærmlæsere. */
    .home-hero-note {
      display: flex; align-items: flex-start; gap: 8px;
      margin: -8px 0 20px 0; position: relative;
      font-size: 0.88rem; line-height: 1.5; color: #4b5563; max-width: 640px;
    }
    body.dark-mode .home-hero-note { color: #a1a1aa; }
    .home-hero-note svg {
      width: 16px; height: 16px; flex-shrink: 0; margin-top: 2px;
      stroke: var(--teal-text); fill: none;
      stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round;
    }

    .home-hero-links { display: flex; flex-wrap: wrap; gap: 10px; position: relative; }
    .home-hero-link { display: inline-flex; align-items: center; gap: 7px; background: var(--card-bg); border: 1px solid var(--border-color); color: var(--text-color); text-decoration: none; padding: 9px 16px; border-radius: 999px; font-weight: 600; font-size: 0.9rem; transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease; }
    .home-hero-link:hover { transform: translateY(-2px); border-color: var(--teal-text); box-shadow: 0 6px 24px rgba(0,0,0,0.06), 0 2px 8px rgba(0,0,0,0.04); }
    .hero-link-icon { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; opacity: 0.7; }
    .home-hero-link:hover .hero-link-icon { opacity: 1; color: var(--teal-text); }
    @media (max-width: 768px) { .home-hero { margin: 15px auto 4px; padding: 0 15px; } .home-hero-card { padding: 26px 20px; border-radius: 14px; } .home-hero-title { font-size: 1.6rem; } .home-hero-sub { font-size: 0.98rem; } }

    .frontpage-wrapper { padding: 0 20px 20px 20px; max-width: 1600px; margin: 0 auto; flex: 1; width: 100%; box-sizing: border-box; }

    /* Video Grid */
    .video-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-bottom: 40px; }
    .watch-card { text-decoration: none; color: inherit; display: block; transition: transform 0.2s; }
    .watch-card:hover { transform: translateY(-3px); }
    .watch-card-thumb { aspect-ratio: 16/9; background-color: #000; background-size: cover; background-position: center; border-radius: 12px; position: relative; margin-bottom: 10px; overflow: hidden; }
    .duration-badge { position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.8); color: white; padding: 2px 6px; border-radius: 4px; font-size: 12px; font-weight: 600; letter-spacing: 0.5px; }

    .tma-grid-title { margin: 0 0 5px 0; font-size: 15px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;}
    .watch-card:hover .tma-grid-title { color: var(--teal-text); }
    .watch-card-thumb img, .short-card-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1); }
    .watch-card:hover .watch-card-thumb img, .watch-card:hover .short-card-thumb img { transform: scale(1.06); }
    .watch-card:hover .watch-card-thumb, .watch-card:hover .short-card-thumb { box-shadow: 0 6px 24px rgba(0,0,0,0.10), 0 2px 8px rgba(0,0,0,0.05); }
    .watch-card-play { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) scale(0.8); width: 52px; height: 52px; border-radius: 50%; background: rgba(0,0,0,0.55); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.05rem; padding-left: 3px; opacity: 0; transition: opacity 0.25s ease, transform 0.25s ease; pointer-events: none; }
    .watch-card:hover .watch-card-play { opacity: 1; transform: translate(-50%, -50%) scale(1); }
    @media (prefers-reduced-motion: reduce) { .watch-card-thumb img, .short-card-thumb img { transition: none; } .watch-card:hover .watch-card-thumb img, .watch-card:hover .short-card-thumb img { transform: none; } }
    /* Loading-skeleton: shimmer bag thumbnailen indtil billedet er loadet, hvorefter JS tilføjer .is-loaded */
    .watch-card-thumb, .short-card-thumb { background-color: #e6e8eb; background-image: linear-gradient(100deg, rgba(255,255,255,0) 20%, rgba(255,255,255,0.7) 50%, rgba(255,255,255,0) 80%); background-size: 200% 100%; background-repeat: no-repeat; animation: tfwShimmer 1.5s ease-in-out infinite; }
    body.dark-mode .watch-card-thumb, body.dark-mode .short-card-thumb { background-color: #26242c; background-image: linear-gradient(100deg, rgba(255,255,255,0) 20%, rgba(255,255,255,0.09) 50%, rgba(255,255,255,0) 80%); }
    .watch-card-thumb.is-loaded, .short-card-thumb.is-loaded { animation: none; background-image: none; background-color: #000; }
    @keyframes tfwShimmer { 0% { background-position: 150% 0; } 100% { background-position: -150% 0; } }
    @media (prefers-reduced-motion: reduce) { .watch-card-thumb, .short-card-thumb { animation: none; } }
    .tma-grid-meta { font-size: 13px; color: #6b7280; margin: 0; }
    body.dark-mode .tma-grid-meta { color: #9ca3af; }

    /* Udpluk på kortene: gør listen til en artikelliste frem for en videoliste. */
    .card-excerpt {
      margin: 4px 0 6px 0; font-size: 13.5px; line-height: 1.5; color: #4b5563;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    body.dark-mode .card-excerpt { color: #a1a1aa; }

    /* Kildeangivelse på kortene — krediterer den oprindelige kanal i stedet for
       at sætte "Tech Feed Watch" under en video vi ikke har lavet. */
    .card-source { display: inline-flex; align-items: center; gap: 5px; font-weight: 600; }
    .card-source svg { width: 14px; height: 14px; color: #ff0000; flex-shrink: 0; }

    /* --- Redaktionel topsektion --- */
    .lead-section { display: grid; grid-template-columns: 1.35fr 1fr; gap: 26px; margin-bottom: 42px; align-items: start; }
    .lead-secondary { display: flex; flex-direction: column; gap: 20px; }

    .lead-card { text-decoration: none; color: inherit; display: block; }
    .lead-card-thumb { aspect-ratio: 16/9; border-radius: 14px; overflow: hidden; position: relative; background: #000; margin-bottom: 14px; }
    .lead-card-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s cubic-bezier(0.22,1,0.36,1); }
    .lead-card:hover .lead-card-thumb img { transform: scale(1.04); }
    .lead-eyebrow { display: inline-flex; align-items: center; gap: 7px; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 9px; color: var(--tag-accent, #0891b2); }
    .lead-eyebrow::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
    .lead-title { margin: 0 0 9px 0; font-size: 1.75rem; line-height: 1.22; font-weight: 800; letter-spacing: -0.02em; }
    .lead-card:hover .lead-title { color: var(--teal-text); }
    .lead-excerpt { margin: 0 0 11px 0; font-size: 1rem; line-height: 1.6; color: #4b5563; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    body.dark-mode .lead-excerpt { color: #a1a1aa; }
    .lead-meta { font-size: 0.83rem; color: #6b7280; display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }
    body.dark-mode .lead-meta { color: #9ca3af; }

    /* De to mindre historier ved siden af: vandret layout, tekst vægtet højere end billede */
    .lead-mini { display: grid; grid-template-columns: 132px 1fr; gap: 14px; text-decoration: none; color: inherit; align-items: start; }
    .lead-mini-thumb { aspect-ratio: 16/9; border-radius: 10px; overflow: hidden; background: #000; }
    .lead-mini-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .lead-mini-title { margin: 0 0 5px 0; font-size: 1rem; line-height: 1.35; font-weight: 700; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .lead-mini:hover .lead-mini-title { color: var(--teal-text); }
    .lead-mini-meta { font-size: 0.78rem; color: #6b7280; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    body.dark-mode .lead-mini-meta { color: #9ca3af; }

    /* Sektionsoverskrifter, så siden læses som en avis frem for et endeløst grid */
    .section-heading {
      display: flex; align-items: baseline; gap: 12px;
      margin: 0 0 18px 0; padding-bottom: 10px;
      border-bottom: 2px solid var(--border-color);
    }
    .section-heading h2 { margin: 0; font-size: 1.15rem; font-weight: 800; letter-spacing: -0.01em; }
    .section-heading .section-note { font-size: 0.83rem; color: #6b7280; font-weight: 500; }
    body.dark-mode .section-heading .section-note { color: #9ca3af; }

    /* Værktøjsstribe. Visuelt tydeligt adskilt fra artikelgriddet, så det ikke
       læses som endnu en række artikler. */
    .home-tools {
      margin: 44px 0; padding: 26px;
      background: var(--hover-bg);
      border: 1px solid var(--border-color);
      border-radius: 16px;
    }
    .home-tools-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; }
    .home-tools-head h2 { margin: 0 0 4px 0; font-size: 1.15rem; font-weight: 800; letter-spacing: -0.01em; }
    .home-tools-head p { margin: 0; font-size: 0.88rem; color: #6b7280; }
    body.dark-mode .home-tools-head p { color: #9ca3af; }
    .home-tools-all { font-size: 0.88rem; font-weight: 700; color: var(--teal-text); text-decoration: none; white-space: nowrap; display: inline-block; padding: 4px 2px; }
    .home-tools-all:hover { text-decoration: underline; }

    /* Faste 3 kolonner: med auto-fit blev det 5 + 1, og det sidste værktøj stod
       alene på sin egen række. To pæne rækker af tre i stedet. */
    .home-tools-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
    .home-tool {
      display: flex; align-items: center; gap: 10px;
      min-height: 44px; padding: 12px 14px;
      background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 10px;
      text-decoration: none; color: inherit;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .home-tool:hover { border-color: var(--teal-text); transform: translateY(-2px); }
    .home-tool-icon { font-size: 1.25rem; line-height: 1; flex-shrink: 0; }
    .home-tool-name { font-size: 0.9rem; font-weight: 600; line-height: 1.3; }

    @media (max-width: 600px) {
      .home-tools { padding: 20px 16px; margin: 32px 0; }
      .home-tools-grid { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 900px) {
      .lead-section { grid-template-columns: 1fr; gap: 30px; }
      .lead-title { font-size: 1.45rem; }
    }
    @media (max-width: 520px) {
      .lead-mini { grid-template-columns: 110px 1fr; gap: 12px; }
      .lead-title { font-size: 1.3rem; }
      .lead-excerpt { -webkit-line-clamp: 2; font-size: 0.95rem; }
    }

    .no-results { grid-column: 1 / -1; text-align: center; padding: 60px 20px; color: #6b7280; font-size: 1rem; }
    body.dark-mode .no-results { color: #9ca3af; }

    /* Shorts Shelf */
    .shorts-shelf { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 15px; margin-bottom: 40px; }
    .short-card-thumb { aspect-ratio: 9/16; background-size: cover; background-position: center; border-radius: 12px; position: relative; overflow: hidden; }

    /* Paginering */
    .pagination { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 20px 0 40px 0; flex-wrap: wrap; }
    .pagination-btn, .pagination-num { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; height: 44px; padding: 0 16px; border-radius: 20px; background: var(--hover-bg); color: var(--text-color); text-decoration: none; font-size: 0.9rem; font-weight: 600; transition: background 0.2s; border: none; box-sizing: border-box; cursor: pointer; }
    .pagination-num { min-width: 44px; padding: 0; }
    .pagination-btn:hover, .pagination-num:hover { background: #e5e7eb; }
    body.dark-mode .pagination-btn:hover, body.dark-mode .pagination-num:hover { background: #334155; }
    .pagination-num.active { background: #111; color: #fff; }
    body.dark-mode .pagination-num.active { background: #f1f5f9; color: #111; }
    .pagination-disabled { opacity: 0.4; pointer-events: none; }

    @media (max-width: 768px) {
      .frontpage-wrapper { padding: 15px; }
      .video-grid { grid-template-columns: 1fr; gap: 20px; }
      .shorts-shelf { grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .watch-card-thumb { border-radius: 8px; }

      /* Edge-to-edge tags på mobil, ligesom på videosiden. Centreret: med
         venstrestilling klumpede rækkerne sig mod venstre kant og efterlod
         skæv luft til højre (målt 26/8 på mobil-skærmbillede) — centreret
         matcher de også "Show fewer"-knappen, der altid har stået i midten. */
      .tag-bar-container {
        margin-left: -15px;
        margin-right: -15px;
        width: calc(100% + 30px);
        padding: 10px 15px;
        justify-content: center;
      }

      /* Sticky-baren dækkede footerens tre første links ved bundscroll på
         mobil (målt 26/8): når siden ikke kan scrolle længere, ligger alt i
         barens højde permanent skjult bag den. På en telefon æder den
         sammenklappede bar desuden ~en tredjedel af skærmen. Statisk på
         mobil: baren scroller med, og hele footeren kan nås. Desktop
         beholder sticky — dér er der plads nok. */
      .tag-bar-outer { position: static; }

      .pagination { gap: 6px; }
      .pagination-btn, .pagination-num { min-width: 44px; height: 44px; padding: 0 8px; font-size: 0.85rem; }
    }
  </style>

  <section class="home-hero">
    <div class="home-hero-card">
      <h1 class="home-hero-title">Skip the video. Keep the insight.</h1>
      <p class="home-hero-sub">The best videos in AI, tech, fintech, and crypto — the substance, in a few minutes. Updated daily.</p>

      {/* Kildeangivelsen er sitets stærkeste tillidssignal og det, næsten ingen
          anden aggregator gør. Den står diskret, ikke som et salgsargument. */}
      <p class="home-hero-note">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        Every article credits the original creator and links to the source.
      </p>

      <div class="home-hero-links">
        <a href="/guides" class="home-hero-link">
          <svg class="hero-link-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5z"/></svg>
