---
import fs from 'node:fs';
import { TAG_COLORS, tagSlug } from '../lib/tags';
import channelData from '../data/channel-averages.json';
import MainLayout from '../layouts/MainLayout.astro';
import SourceLine from '../components/SourceLine.astro';
import { TOOLS, featuredTools } from '../lib/tools';
import { asQuestion } from '../lib/question.mjs';

const PAGE_SIZE = 24;

// Værktøjerne er det eneste på sitet vi selv har bygget, og de lå gemt bag ét
// menupunkt. Seks udvalgte vises på forsiden — én fra hver kategori plus lidt
// ekstra vægt til dem med bredest brug.
const homeTools = featuredTools();
const toolCount = TOOLS.length;

const allVideos = Object.values(import.meta.glob('../content/videos/*.md', { eager: true }));

const regularVideos = allVideos
  .filter((v: any) => !v.frontmatter.isShort)
  .sort((a: any, b: any) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());

// Finder automatisk de 20 mest populære tags
const tagCounts = allVideos.reduce((acc: any, video: any) => {
  const t = video.frontmatter.tags || video.frontmatter.tag || [];
  const tagsArray = Array.isArray(t) ? t : [t];
  tagsArray.filter(Boolean).forEach((tag: string) => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {}) as Record<string, number>;
const topTags = Object.keys(tagCounts)
  .sort((a, b) => tagCounts[b] - tagCounts[a])
  .slice(0, 20);


// Pæn dato-formatering: "2026-07-23" -> "Jul 23, 2026"
const formatDate = (d: string) => {
  const parsed = new Date(d);
  return isNaN(parsed.getTime()) ? d : parsed.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
};

// Side 1: kun de første 24 normale videoer. Resten pagineres via /page/2, /page/3 osv.
const pageOneVideos = regularVideos.slice(0, PAGE_SIZE);
const totalPages = Math.max(1, Math.ceil(regularVideos.length / PAGE_SIZE));

// Redaktionel topsektion: dagens hovedhistorie + to sekundære. Tekst vægtes over
// thumbnail, så forsiden læses som en publikation frem for en videoliste.
const leadMain = pageOneVideos[0] || null;
// Fire sekundære, så højre kolonne er nogenlunde lige så høj som hovedhistorien
// og ikke efterlader et stort tomt felt ved siden af.
const leadSide = pageOneVideos.slice(1, 5);

// Kort hjælper til kortenes udpluk — summary er ofte 400+ tegn.
// Afsluttende tegnsætning fjernes før ellipsen, ellers ender man med "sector...."
const excerpt = (text: string, max = 145) => {
  const s = (text || '').trim();
  if (s.length <= max) return s;
  return s.slice(0, max).replace(/\s+\S*$/, '').replace(/[.,;:!?—-]+$/, '').trim() + '…';
};

// Primært tag bruges som "eyebrow" over hovedhistorien
const firstTag = (v: any): string | null => {
  const t = v?.frontmatter?.tags || v?.frontmatter?.tag || [];
  const arr = Array.isArray(t) ? t : [t];
  return arr.filter(Boolean)[0] || null;
};

// "Questions people are asking": de nyeste artiklers søgespørgsmål som genveje.
// Spørgsmålet er sitets løfte på forsiden, så det vises med sine egne ord.
const questions = regularVideos
  .filter((v: any) => v.frontmatter.targetQuestion)
  .slice(0, 8)
  .map((v: any) => ({ slug: v.file.split('/').pop().replace('.md', ''), text: asQuestion(v.frontmatter.targetQuestion), color: TAG_COLORS[firstTag(v) as string] || '#2563eb' }));

// --- Udkast 18/10: forsiden får rytme ---
// Før var alt under topsektionen samme hvide kortliste hele vejen ned. Nu skifter
// sektionerne form: farvet felt -> faneboks -> ét stort kort -> nummereret top 5 ->
// karrusel pr. emne -> talstribe -> værktøjer -> gitter. Hver artikel vises højst ét
// sted i de store sektioner (Set'et "brugt"), så siden ikke gentager sig selv.
const slugOf = (v: any): string => v.file.split('/').pop().replace('.md', '');
const kortBillede = (v: any) => `/kort/${slugOf(v)}.webp`;
// AI-billede = samme regel som src/lib/aibillede.mjs (harAiBillede). Artikler, der endnu ikke er
// omskrevet, har kun det gamle abstrakte emnekort - de holdes ude af de billedtunge sektioner
// (trending, stort kort, karruseller), men står stadig i gitteret, så side 1 er komplet.
const harAi = (v: any) => fs.existsSync(`public/billeder/${slugOf(v)}.webp`);
const brugt = new Set<string>([leadMain, ...leadSide].filter(Boolean).map(slugOf));

// Popularitet som på /popular: kildevideoens visninger delt med kanalens gennemsnit.
// En lille kanal med en stærk video kan derfor slå en stor kanal. Under 5.000
// visninger afgør tilfældigheder, så de er udeladt (samme grænse som /popular).
const averages: Record<string, number> = (channelData as any).averageViewsPerVideo;
const medPopularitet = regularVideos
  .map((v: any) => {
    const views = Number(v.frontmatter.viewCount);
    const avg = averages[v.frontmatter.channelId];
    return { v, ratio: Number.isFinite(views) && avg > 0 && views >= 5000 ? views / avg : null };
  })
  .filter((x: any) => x.ratio !== null)
  .sort((a: any, b: any) => b.ratio - a.ratio);

// Top 5 "this month": de 5 mest populære fra de sidste 30 dage (målt ved build).
// Er der færre end 5, udvides til 90 dage, så sektionen aldrig står halvtom.
const nu = Date.now();
const indenfor = (v: any, dage: number) => nu - new Date(v.frontmatter.date).valueOf() <= dage * 864e5;
let top5Dage = 30;
let top5 = medPopularitet.filter((x: any) => indenfor(x.v, 30) && harAi(x.v) && !brugt.has(slugOf(x.v))).slice(0, 5);
if (top5.length < 5) { top5Dage = 90; top5 = medPopularitet.filter((x: any) => indenfor(x.v, 90) && harAi(x.v) && !brugt.has(slugOf(x.v))).slice(0, 5); }
top5.forEach((x: any) => brugt.add(slugOf(x.v)));

// Ét stort kort: den nyeste artikel, der ikke allerede står ovenfor.
const stortKort = pageOneVideos.find((v: any) => !brugt.has(slugOf(v)) && harAi(v)) || pageOneVideos.find((v: any) => !brugt.has(slugOf(v))) || null;
if (stortKort) brugt.add(slugOf(stortKort));

// Faneboksen: Popular (alle tider) / Questions / Latest. Kompakte tekstlister,
// så de må gerne overlappe gitteret længere nede.
const fanePopular = medPopularitet.filter((x: any) => !brugt.has(slugOf(x.v))).slice(0, 6);
const faneLatest = pageOneVideos.filter((v: any) => !brugt.has(slugOf(v))).slice(0, 6);

// Karruseller: de største emner, der har mindst 4 artikler med AI-billede tilbage (højst 8 pr. emne,
// nyeste først, højst 3 emner). Emner uden nok nye billeder springes over i stedet for at vise emnekort.
const karruselEmner: any[] = [];
for (const tag of topTags) {
  if (karruselEmner.length >= 3) break;
  const items = regularVideos.filter((v: any) => {
    const t = v.frontmatter.tags || v.frontmatter.tag || [];
    return (Array.isArray(t) ? t : [t]).includes(tag) && harAi(v) && !brugt.has(slugOf(v));
  }).slice(0, 8);
  if (items.length < 4) continue;
  items.forEach((v: any) => brugt.add(slugOf(v)));
  karruselEmner.push({ tag, total: tagCounts[tag], color: TAG_COLORS[tag] || '#2563eb', items });
}

// Gitteret til sidst: resten af side 1, så alt fra side 1 stadig står på forsiden
// (/page/2 starter ved artikel 25 og regner med det).
const vRest = pageOneVideos.filter((v: any) => !brugt.has(slugOf(v)));

// Talstriben: alt målt ved build, intet skrevet i hånden.
const antalArtikler = allVideos.length;
const antalSkabere = new Set(allVideos.map((v: any) => v.frontmatter.channelTitle).filter(Boolean)).size;
const nyeUge = regularVideos.filter((v: any) => indenfor(v, 7)).length;
const antalGuides = Object.keys(import.meta.glob('../content/guides/*.md')).length;
const antalOrd = Object.keys(import.meta.glob('../content/glossary/*.md')).length;
---

<MainLayout title="AI, Tech, Fintech & Crypto News, Explained" description="Straight answers on AI, tech, fintech and crypto. Every article answers a question people actually search for, in plain language. Updated daily.">

  <style is:global>
    /* --- CSS specifik for forsiden --- */

    /* Tag Bar */
    /* Yderste beholder er den klistrende. Knappen SKAL ligge her og ikke inde i
       den beskårne række — første forsøg lagde den inde i rækken, hvor den selv
       havnede på tredje linje og blev skjult af netop den beskæring den skulle
       ophæve. */
    .tag-bar-outer {
      position: sticky;
      top: -1px;
      background: var(--bg-color);
      z-index: 25;
      border-bottom: 1px solid var(--border-color);
      margin-bottom: 25px;
    }
    .tag-bar-container {
      padding: 12px 20px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      min-height: 55px;
      box-sizing: border-box;
      /* Sammenklappet viser den to rækker. Med 12 emner løb den vandrette
         udgave ud over kanten, og et tag man skal skulle efter, findes ikke.
         --tag-rows sættes af JS til den reelle højde af to rækker, så det
         virker uanset skriftstørrelse og bredde. */
      max-height: var(--tag-rows, 96px);
      overflow: hidden;
      transition: max-height 0.25s ease;
    }
    .tag-bar-container.expanded { max-height: 600px; }

    /* Når bjælken sidder fast i toppen (scrollet forbi sin plads), klapper den
       til ÉN vandret række, der kan rulles sidelæns. To rækker åd ~150 px af
       skærmen hele vejen ned. Klassen sættes af JS via en usynlig vagtpost. */
    .tag-bar-outer { transition: box-shadow 0.2s ease; }
    /* Den ydre beholder beholder sin fulde højde (sat af JS som min-height), så
       indholdet under den ikke hopper, når rækken bliver lavere. Den bliver
       gennemsigtig og lader klik gå igennem; kun den lille række har baggrund. */
    .tag-bar-outer.is-stuck { background: transparent; border-bottom-color: transparent; pointer-events: none; }
    .tag-bar-outer.is-stuck .tag-bar-container {
      pointer-events: auto; background: var(--bg-color); border-bottom: 1px solid var(--border-color);
      box-shadow: 0 6px 18px rgba(0,0,0,0.06);
      flex-wrap: nowrap; overflow-x: auto; overflow-y: hidden; max-height: none !important;
      min-height: 0; padding: 8px 20px; gap: 8px; scrollbar-width: none; scroll-behavior: smooth;
    }
    body.dark-mode .tag-bar-outer.is-stuck .tag-bar-container { box-shadow: 0 6px 18px rgba(0,0,0,0.35); }
    .tag-bar-outer.is-stuck .tag-bar-container::-webkit-scrollbar { display: none; }
    .tag-bar-outer.is-stuck .filter-tag { flex: none; min-height: 36px; padding: 4px 13px; font-size: 0.8rem; }
    .tag-bar-outer.is-stuck .tag-more { display: none; }
    .tag-bar-sentinel { height: 1px; margin-top: -1px; }

    /* Knappen står på sin EGEN linje under rækken. Første forsøg placerede den
       absolut i højre hjørne og reserverede plads med padding — den plads holdt
       ikke på alle bredder, og knappen lagde sig oven på det sidste emne. En
       egen linje koster 30 px og kan ikke overlappe noget. */
    .tag-more {
      display: block; margin: 0 auto 10px auto;
      background: var(--bg-color); border: 1px dashed var(--border-color); color: #6b7280;
      padding: 6px 16px; border-radius: 20px; font-size: 0.82rem; font-weight: 600;
      cursor: pointer; line-height: 1.5; white-space: nowrap;
    }
    .tag-more:hover { border-color: var(--teal-text); color: var(--teal-text); }
    .tag-more[hidden] { display: none; }
    body.dark-mode .tag-more { color: #9ca3af; }

    /* Pille-design der matcher videosiden (border-radius: 20px) */
    .filter-tag {
      background: var(--hover-bg); color: var(--text-color); border: 1px solid transparent;
      padding: 7px 16px; border-radius: 20px; font-size: 0.85rem; font-weight: 600;
      cursor: pointer; transition: background 0.2s; line-height: 1.5; display: inline-flex; align-items: center; min-height: 44px; box-sizing: border-box;
    }
    .filter-tag:hover { background: #e5e7eb; }
    .filter-tag.active { background: #111; color: #fff; }
    body.dark-mode .filter-tag:hover { background: #334155; }
    body.dark-mode .filter-tag.active { background: #f1f5f9; color: #111; }

    /* Emne-farvesystem: diskret accent-prik pr. tag, fyldt farve når chippen er aktiv */
    .filter-tag-accent { border-color: var(--tag-accent); }
    .filter-tag-accent::before { content: ''; display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--tag-accent); margin-right: 7px; vertical-align: middle; }
    .filter-tag-accent.active { background: var(--tag-accent); color: #fff; border-color: var(--tag-accent); }
    /* Hover i emnets egen farve i stedet for gråt: man ser, hvad man er ved at vælge. */
    .filter-tag { transition: background 0.2s, transform 0.15s, box-shadow 0.2s; }
    .filter-tag-accent:not(.active):hover { background: color-mix(in srgb, var(--tag-accent) 14%, var(--hover-bg)); transform: translateY(-1px); box-shadow: 0 3px 10px color-mix(in srgb, var(--tag-accent) 28%, transparent); }
    body.dark-mode .filter-tag-accent:not(.active):hover { background: color-mix(in srgb, var(--tag-accent) 26%, var(--hover-bg)); }
    @media (prefers-reduced-motion: reduce) { .filter-tag-accent:not(.active):hover { transform: none; } }

    /* Spørgsmålsliste: to kolonner, hver linje en genvej. Prikken bærer emnets farve. */
    .home-questions { margin: 6px 0 36px; }
    .home-questions-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 22px; }
    .home-question { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 12px; text-decoration: none; color: var(--text-color); border: 1px solid transparent; transition: background 0.2s, border-color 0.2s, transform 0.15s; }
    .home-question:hover { background: var(--hover-bg); border-color: var(--border-color); transform: translateX(3px); }
    .home-question-mark { flex: none; width: 28px; height: 28px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.9rem; color: #fff; background: var(--tag-accent); }
    .home-question-text { font-weight: 600; font-size: 0.95rem; line-height: 1.35; }
    .home-question-arrow { margin-left: auto; color: #9ca3af; transition: transform 0.15s, color 0.2s; }
    .home-question:hover .home-question-arrow { transform: translateX(3px); color: var(--teal-text); }
    @media (max-width: 768px) { .home-questions-list { grid-template-columns: 1fr; } }
    @media (prefers-reduced-motion: reduce) { .home-question:hover, .home-question:hover .home-question-arrow { transform: none; } }

    .home-hero { max-width: 1600px; margin: 22px auto 6px auto; padding: 0 20px; box-sizing: border-box; width: 100%; }
    .home-hero-card { position: relative; overflow: hidden; border-radius: 18px; border: 1px solid var(--border-color); background: linear-gradient(135deg, rgba(37, 99, 235,0.10), rgba(37, 99, 235,0.02) 62%); padding: 38px 34px; }
    .home-hero-card::after { content: ''; position: absolute; top: -45%; right: -8%; width: 360px; height: 360px; background: radial-gradient(circle, rgba(37, 99, 235,0.16), transparent 70%); pointer-events: none; }
    .home-hero-title { margin: 0 0 10px 0; font-size: 2.1rem; font-weight: 800; letter-spacing: -0.03em; }
    .home-hero-sub { margin: 0 0 20px 0; font-size: 1.05rem; line-height: 1.6; color: #4b5563; max-width: 640px; position: relative; }
    body.dark-mode .home-hero-sub { color: #b8b3bd; }
    /* Tillidslinjen: mindre end underteksten, men stadig over 4,5:1 i kontrast.
       Fluebenet er dekorativt og bliver derfor skjult for skærmlæsere. */
    .home-hero-note {
      display: flex; align-items: flex-start; gap: 8px;
      margin: -8px 0 20px 0; position: relative;
      font-size: 0.88rem; line-height: 1.5; color: #4b5563; max-width: 640px;
    }
    body.dark-mode .home-hero-note { color: #a1a1aa; }
    .home-hero-note svg {
      width: 16px; height: 16px; flex-shrink: 0; margin-top: 2px;
      stroke: var(--teal-text); fill: none;
      stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round;
    }

    .home-hero-links { display: flex; flex-wrap: wrap; gap: 10px; position: relative; }
    .home-hero-link { display: inline-flex; align-items: center; gap: 7px; background: var(--card-bg); border: 1px solid var(--border-color); color: var(--text-color); text-decoration: none; padding: 9px 16px; border-radius: 999px; font-weight: 600; font-size: 0.9rem; transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease; }
    .home-hero-link:hover { transform: translateY(-2px); border-color: var(--teal-text); box-shadow: 0 6px 24px rgba(0,0,0,0.06), 0 2px 8px rgba(0,0,0,0.04); }
    .hero-link-icon { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; opacity: 0.7; }
    .home-hero-link:hover .hero-link-icon { opacity: 1; color: var(--teal-text); }
    @media (max-width: 768px) { .home-hero { margin: 15px auto 4px; padding: 0 15px; } .home-hero-card { padding: 26px 20px; border-radius: 14px; } .home-hero-title { font-size: 1.6rem; } .home-hero-sub { font-size: 0.98rem; } }

    .frontpage-wrapper { padding: 0 20px 20px 20px; max-width: 1600px; margin: 0 auto; flex: 1; width: 100%; box-sizing: border-box; }

    /* Video Grid */
    .video-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-bottom: 40px; }
    .watch-card { text-decoration: none; color: inherit; display: block; transition: transform 0.2s; }
    .watch-card:hover { transform: translateY(-3px); }
    .watch-card-thumb { aspect-ratio: 16/9; background-color: #000; background-size: cover; background-position: center; border-radius: 12px; position: relative; margin-bottom: 10px; overflow: hidden; }
    .duration-badge { position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.8); color: white; padding: 2px 6px; border-radius: 4px; font-size: 12px; font-weight: 600; letter-spacing: 0.5px; }

    .tma-grid-title { margin: 0 0 5px 0; font-size: 15px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;}
    .watch-card:hover .tma-grid-title { color: var(--teal-text); }
    .watch-card-thumb img, .short-card-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1); }
    .watch-card:hover .watch-card-thumb img, .watch-card:hover .short-card-thumb img { transform: scale(1.06); }
    .watch-card:hover .watch-card-thumb, .watch-card:hover .short-card-thumb { box-shadow: 0 6px 24px rgba(0,0,0,0.10), 0 2px 8px rgba(0,0,0,0.05); }
    @media (prefers-reduced-motion: reduce) { .watch-card-thumb img, .short-card-thumb img { transition: none; } .watch-card:hover .watch-card-thumb img, .watch-card:hover .short-card-thumb img { transform: none; } }
    /* Loading-skeleton: shimmer bag thumbnailen indtil billedet er loadet, hvorefter JS tilføjer .is-loaded.
       24/10: flyttet fra background-position til transform på en ::after — background-position males af
       CPU'en (PageSpeed: "34 ikke-sammensatte animationer" = hakken på telefon/TV); transform kører på
       grafikkortet. :has(img): kun thumbs med et billede skimrer, så en thumb uden aldrig skimrer for evigt.
       ::after ligger BAG billedet (z-index -1) og fjernes helt ved .is-loaded. Samme udseende som før. */
    .watch-card-thumb:has(img), .short-card-thumb:has(img) { background-color: #e6e8eb; }
    .watch-card-thumb:has(img)::after, .short-card-thumb:has(img)::after { content: ""; position: absolute; inset: 0; z-index: -1; background-image: linear-gradient(100deg, rgba(255,255,255,0) 20%, rgba(255,255,255,0.7) 50%, rgba(255,255,255,0) 80%); transform: translateX(-100%); animation: tfwShimmer 1.5s ease-in-out infinite; }
    body.dark-mode .watch-card-thumb:has(img), body.dark-mode .short-card-thumb:has(img) { background-color: #18223d; }
    body.dark-mode .watch-card-thumb:has(img)::after, body.dark-mode .short-card-thumb:has(img)::after { background-image: linear-gradient(100deg, rgba(255,255,255,0) 20%, rgba(255,255,255,0.09) 50%, rgba(255,255,255,0) 80%); }
    .watch-card-thumb.is-loaded, .short-card-thumb.is-loaded { background-color: #000; }
    .watch-card-thumb.is-loaded::after, .short-card-thumb.is-loaded::after { content: none; animation: none; }
    @keyframes tfwShimmer { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }
    @media (prefers-reduced-motion: reduce) { .watch-card-thumb::after, .short-card-thumb::after { content: none; animation: none; } }
    .tma-grid-meta { font-size: 13px; color: #6b7280; margin: 0; }
    body.dark-mode .tma-grid-meta { color: #9ca3af; }

    /* Udpluk på kortene: gør listen til en artikelliste frem for en videoliste. */
    .card-excerpt {
      margin: 4px 0 6px 0; font-size: 13.5px; line-height: 1.5; color: #4b5563;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    body.dark-mode .card-excerpt { color: #a1a1aa; }

    /* Kildeangivelse på kortene — krediterer den oprindelige kanal i stedet for
       at sætte "TechFeedWatch" under en video vi ikke har lavet. */
    .card-source { display: inline-flex; align-items: center; gap: 5px; font-weight: 600; }
    .card-source svg { width: 14px; height: 14px; color: #ff0000; flex-shrink: 0; }

    /* --- Redaktionel topsektion --- */
    .lead-section { display: grid; grid-template-columns: 1.35fr 1fr; gap: 26px; margin-bottom: 42px; align-items: start; }
    .lead-secondary { display: flex; flex-direction: column; gap: 20px; }

    .lead-card { text-decoration: none; color: inherit; display: block; }
    .lead-card-thumb { aspect-ratio: 16/9; border-radius: 14px; overflow: hidden; position: relative; background: #000; margin-bottom: 14px; }
    .lead-card-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s cubic-bezier(0.22,1,0.36,1); }
    .lead-card:hover .lead-card-thumb img { transform: scale(1.04); }
    .lead-eyebrow { display: inline-flex; align-items: center; gap: 7px; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 9px; color: var(--tag-accent, #2563eb); }
    .lead-eyebrow::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
    .lead-mini-eyebrow { font-size: 0.66rem; margin-bottom: 4px; gap: 6px; }
    .lead-mini-eyebrow::before { width: 6px; height: 6px; }
    .lead-title { margin: 0 0 9px 0; font-size: 1.75rem; line-height: 1.22; font-weight: 800; letter-spacing: -0.02em; }
    .lead-card:hover .lead-title { color: var(--teal-text); }
    .lead-excerpt { margin: 0 0 11px 0; font-size: 1rem; line-height: 1.6; color: #4b5563; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    body.dark-mode .lead-excerpt { color: #a1a1aa; }
    .lead-meta { font-size: 0.83rem; color: #6b7280; display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }
    body.dark-mode .lead-meta { color: #9ca3af; }

    /* De to mindre historier ved siden af: vandret layout, tekst vægtet højere end billede */
    .lead-mini { display: grid; grid-template-columns: 132px 1fr; gap: 14px; text-decoration: none; color: inherit; align-items: start; }
    .lead-mini-thumb { aspect-ratio: 16/9; border-radius: 10px; overflow: hidden; background: #000; }
    .lead-mini-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .lead-mini-title { margin: 0 0 5px 0; font-size: 1rem; line-height: 1.35; font-weight: 700; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .lead-mini:hover .lead-mini-title { color: var(--teal-text); }
    .lead-mini-meta { font-size: 0.78rem; color: #6b7280; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    body.dark-mode .lead-mini-meta { color: #9ca3af; }

    /* Sektionsoverskrifter, så siden læses som en avis frem for et endeløst grid */
    .section-heading {
      display: flex; align-items: baseline; gap: 12px;
      margin: 0 0 18px 0; padding-bottom: 10px;
      border-bottom: 2px solid var(--border-color);
    }
    .section-heading h2 { margin: 0; font-size: 1.15rem; font-weight: 800; letter-spacing: -0.01em; }
    .section-heading .section-note { font-size: 0.83rem; color: #6b7280; font-weight: 500; }
    body.dark-mode .section-heading .section-note { color: #9ca3af; }

    /* Værktøjsstribe. Visuelt tydeligt adskilt fra artikelgriddet, så det ikke
       læses som endnu en række artikler. */
    .home-tools {
      margin: 44px 0; padding: 26px;
      background: var(--hover-bg);
      border: 1px solid var(--border-color);
      border-radius: 16px;
    }
    .home-tools-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; }
    .home-tools-head h2 { margin: 0 0 4px 0; font-size: 1.15rem; font-weight: 800; letter-spacing: -0.01em; }
    .home-tools-head p { margin: 0; font-size: 0.88rem; color: #4b5563; } /* 19/10: #6b7280 gav 4,41:1 på den tonede baggrund (kravet er 4,5:1) */
    body.dark-mode .home-tools-head p { color: #9ca3af; }
    .home-tools-all { font-size: 0.88rem; font-weight: 700; color: var(--teal-text); text-decoration: none; white-space: nowrap; display: inline-block; padding: 4px 2px; }
    .home-tools-all:hover { text-decoration: underline; }

    /* Faste 3 kolonner: med auto-fit blev det 5 + 1, og det sidste værktøj stod
       alene på sin egen række. To pæne rækker af tre i stedet. */
    .home-tools-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
    .home-tool {
      display: flex; align-items: center; gap: 10px;
      min-height: 44px; padding: 12px 14px;
      background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 10px;
      text-decoration: none; color: inherit;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .home-tool:hover { border-color: var(--teal-text); transform: translateY(-2px); }
    .home-tool-icon { font-size: 1.25rem; line-height: 1; flex-shrink: 0; }
    .home-tool-name { font-size: 0.9rem; font-weight: 600; line-height: 1.3; }

    @media (max-width: 600px) {
      .home-tools { padding: 20px 16px; margin: 32px 0; }
      .home-tools-grid { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 900px) {
      .lead-section { grid-template-columns: 1fr; gap: 30px; }
      .lead-title { font-size: 1.45rem; }
    }
    @media (max-width: 520px) {
      .lead-mini { grid-template-columns: 110px 1fr; gap: 12px; }
      .lead-title { font-size: 1.3rem; }
      .lead-excerpt { -webkit-line-clamp: 2; font-size: 0.95rem; }
    }

    .no-results { grid-column: 1 / -1; text-align: center; padding: 60px 20px; color: #6b7280; font-size: 1rem; }
    body.dark-mode .no-results { color: #9ca3af; }

    /* Shorts Shelf */
    .shorts-shelf { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 15px; margin-bottom: 40px; }
    .short-card-thumb { aspect-ratio: 9/16; background-size: cover; background-position: center; border-radius: 12px; position: relative; overflow: hidden; }

    /* Paginering */
    .pagination { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 20px 0 40px 0; flex-wrap: wrap; }
    .pagination-btn, .pagination-num { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; height: 44px; padding: 0 16px; border-radius: 20px; background: var(--hover-bg); color: var(--text-color); text-decoration: none; font-size: 0.9rem; font-weight: 600; transition: background 0.2s; border: none; box-sizing: border-box; cursor: pointer; }
    .pagination-num { min-width: 44px; padding: 0; }
    .pagination-btn:hover, .pagination-num:hover { background: #e5e7eb; }
    body.dark-mode .pagination-btn:hover, body.dark-mode .pagination-num:hover { background: #334155; }
    .pagination-num.active { background: #111; color: #fff; }
    body.dark-mode .pagination-num.active { background: #f1f5f9; color: #111; }
    .pagination-disabled { opacity: 0.4; pointer-events: none; }

    @media (max-width: 768px) {
      .frontpage-wrapper { padding: 15px; }
      .video-grid { grid-template-columns: 1fr; gap: 20px; }
      .shorts-shelf { grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .watch-card-thumb { border-radius: 8px; }

      /* Edge-to-edge tags på mobil, ligesom på videosiden. Centreret: med
         venstrestilling klumpede rækkerne sig mod venstre kant og efterlod
         skæv luft til højre (målt 26/8 på mobil-skærmbillede) — centreret
         matcher de også "Show fewer"-knappen, der altid har stået i midten. */
      .tag-bar-container {
        /* Før: margin -15px og bredde 100% + 30px, beregnet til en forælder med 15px luft.
           Forælderen (.tag-bar-outer) har 0 luft, så bjælken stak 15px ud på hver side
           (målt 7/10: 420px bred på en 390px skærm). Indholdet står samme sted som før. */
        margin-left: 0;
        margin-right: 0;
        width: 100%;
        padding: 10px 15px;
        justify-content: center;
      }

      /* Sticky-baren dækkede footerens tre første links ved bundscroll på
         mobil (målt 26/8): når siden ikke kan scrolle længere, ligger alt i
         barens højde permanent skjult bag den. På en telefon æder den
         sammenklappede bar desuden ~en tredjedel af skærmen. Statisk på
         mobil: baren scroller med, og hele footeren kan nås. Desktop
         beholder sticky — dér er der plads nok. */
      .tag-bar-outer { position: static; }

      .pagination { gap: 6px; }
      .pagination-btn, .pagination-num { min-width: 44px; height: 44px; padding: 0 8px; font-size: 0.85rem; }
    }

    /* ===================== Udkast 18/10: ny forside ===================== */
    /* Sitets egne farver fra logoet: blå #2563eb og violet #6d28d9. Emnefarver bruges
       kun som prik/streg - aldrig som tekst eller bag hvid tekst (farvereglen). */
    .home-intro { max-width: 1600px; margin: 18px auto 2px auto; padding: 0 20px; box-sizing: border-box; width: 100%; }
    .home-intro-title { margin: 0; font-size: 1.35rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.25; }

    /* Større, fede sektionsoverskrifter med en blå-violet streg foran */
    .section-heading { border-bottom: 0; padding-bottom: 0; flex-wrap: wrap; row-gap: 4px; margin-bottom: 18px; }
    .section-heading h2 { position: relative; padding-left: 15px; font-size: 1.6rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.2; }
    .section-heading h2::before { content: ''; position: absolute; left: 0; top: 0.12em; bottom: 0.12em; width: 5px; border-radius: 3px; background: linear-gradient(#2563eb, #6d28d9); }
    .carousel-head h2::before { background: var(--tag-accent, #2563eb); }

    /* --- 1) Det farvede felt --- */
    .home-band { --band-a: #2563eb; --band-b: #6d28d9; display: grid; grid-template-columns: 1.45fr 1fr; gap: 28px; padding: 26px; margin: 0 0 40px; border-radius: 20px; background: linear-gradient(135deg, var(--band-a), var(--band-b)); background-color: var(--band-a); /* 19/10: den lyseste ende som almindelig baggrundsfarve, så kontrastmålingen (audit-a11y) måler mod det værste sted - den kan ikke læse forløb */ color: #fff; box-shadow: 0 18px 40px -20px rgba(76, 29, 149, 0.6); }
    body.dark-mode .home-band { --band-a: #1d4ed8; --band-b: #5b21b6; box-shadow: none; }
    .home-band .band-lead { color: #fff; }
    .home-band .lead-card-thumb { margin-bottom: 14px; }
    /* Bundluften (7 % af bredden) holder titlen over vandmærket "TechFeedWatch.com" nederst til højre i billedet */
    .band-lead-text { position: absolute; left: 0; right: 0; bottom: 0; padding: 70px 22px max(22px, 7%); background: linear-gradient(to top, rgba(2, 6, 23, 0.3) 0%, rgba(2, 6, 23, 0.88) 22%, rgba(2, 6, 23, 0.6) 62%, rgba(2, 6, 23, 0) 100%); } /* svagere nederst, så vandmærket ikke dæmpes */
    .home-band .band-lead-title { color: #fff; margin: 9px 0 0; font-size: 1.9rem; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .home-band .band-lead:hover .band-lead-title { color: #fff; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
    /* 19/10: helt hvid. Halvgennemsigtig hvid (0,86-0,92) gav kun ca. 4,0-4,3:1 mod den blå ende (#2563eb) - kravet er 4,5:1 */
    .home-band .band-excerpt, body.dark-mode .home-band .band-excerpt { color: #fff; }
    .home-band .band-meta, body.dark-mode .home-band .band-meta, .home-band .band-item-meta { color: #fff; }
    .home-band .card-source svg { color: #fff; }
    .band-pill { display: inline-flex; align-items: center; gap: 6px; background: rgba(255, 255, 255, 0.95); color: #111827; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; line-height: 1.3; }
    .band-pill::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--tag-accent, #2563eb); flex: none; }
    .band-pill-sm { font-size: 0.6rem; padding: 3px 8px; }
    .band-side-heading { margin: 0 0 6px; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: #fff; display: flex; align-items: center; gap: 12px; }
    .band-side-heading::after { content: ''; flex: 1; height: 1px; background: rgba(255, 255, 255, 0.3); }
    .band-list { list-style: none; margin: 0; padding: 0; }
    .band-list li + li { border-top: 1px solid rgba(255, 255, 255, 0.2); }
    .band-item { display: grid; grid-template-columns: 116px 1fr; gap: 14px; padding: 12px 0; color: #fff; text-decoration: none; align-items: start; }
    .band-item-thumb { aspect-ratio: 16 / 9; border-radius: 10px; overflow: hidden; }
    .band-item-title { margin: 6px 0 4px; font-size: 1rem; line-height: 1.35; font-weight: 700; color: #fff; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .band-item:hover .band-item-title { text-decoration: underline; text-underline-offset: 3px; }
    .band-item-meta { font-size: 0.76rem; margin: 0; }
    .home-band a:focus-visible { outline: 3px solid #fff; outline-offset: 3px; border-radius: 12px; }

    /* --- 2) Faneboksen --- */
    .home-tabs { margin: 0 0 46px; border: 1px solid var(--border-color); border-radius: 16px; background: var(--card-bg); overflow: hidden; }
    .tabs-bar { display: flex; overflow-x: auto; scrollbar-width: none; border-bottom: 1px solid var(--border-color); background: var(--hover-bg); }
    .tabs-bar::-webkit-scrollbar { display: none; }
    .tab-btn { flex: none; appearance: none; background: none; border: 0; padding: 14px 18px; min-height: 48px; font: inherit; font-weight: 700; font-size: 0.95rem; color: #4b5563; cursor: pointer; position: relative; white-space: nowrap; }
    body.dark-mode .tab-btn { color: #a1a1aa; }
    .tab-btn:hover { color: var(--text-color); }
    .tab-btn[aria-selected="true"] { color: var(--text-color); background: var(--card-bg); }
    .tab-btn[aria-selected="true"]::after { content: ''; position: absolute; left: 14px; right: 14px; bottom: -1px; height: 3px; border-radius: 3px 3px 0 0; background: linear-gradient(90deg, #2563eb, #6d28d9); }
    .tab-btn:focus-visible, .tab-panel:focus-visible { outline: 2px solid var(--teal-text); outline-offset: -3px; }
    .tab-panel { padding: 4px 20px 14px; }
    .tab-panel[hidden] { display: none; }
    .tab-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 30px; }
    .tab-list li { border-bottom: 1px solid var(--border-color); }
    .tab-row { display: flex; align-items: center; gap: 14px; padding: 12px 2px; min-height: 44px; color: var(--text-color); text-decoration: none; }
    .tab-row:hover .tab-row-title { color: var(--teal-text); }
    .tab-num { flex: none; width: 30px; font-size: 1.6rem; font-weight: 900; line-height: 1; text-align: center; background: linear-gradient(135deg, #2563eb, #6d28d9); -webkit-background-clip: text; background-clip: text; color: transparent; }
    body.dark-mode .tab-num { background-image: linear-gradient(135deg, #60a5fa, #a78bfa); }
    .tab-row-text { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .tab-row-title { font-weight: 650; font-size: 0.97rem; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .tab-row-meta { font-size: 0.78rem; color: #6b7280; }
    body.dark-mode .tab-row-meta { color: #9ca3af; }
    .tab-q { flex: none; width: 26px; height: 26px; border-radius: 50%; border: 2px solid var(--tag-accent, #2563eb); display: inline-flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.82rem; color: var(--text-color); }
    .tab-more { display: inline-block; margin-top: 12px; padding: 6px 2px; font-weight: 700; font-size: 0.9rem; color: var(--teal-text); text-decoration: none; }
    .tab-more:hover { text-decoration: underline; }

    /* --- 3) Ét stort kort --- */
    .home-feature { margin-bottom: 46px; }
    .topic-pill { display: inline-flex; align-items: center; gap: 6px; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-color); background: var(--hover-bg); border: 1px solid var(--border-color); padding: 3px 9px; border-radius: 999px; line-height: 1.3; }
    .topic-pill::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--tag-accent, #2563eb); flex: none; }
    .feature-card { display: grid; grid-template-columns: 1.15fr 1fr; gap: 30px; align-items: center; text-decoration: none; color: inherit; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 18px; padding: 14px; transition: box-shadow 0.2s ease, transform 0.2s ease; }
    .feature-card:hover { box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08); transform: translateY(-2px); }
    .feature-thumb { aspect-ratio: 16 / 9; border-radius: 12px; overflow: hidden; }
    .feature-body { padding: 6px 16px 6px 0; }
    .feature-title { margin: 12px 0 10px; font-size: 1.75rem; line-height: 1.2; font-weight: 800; letter-spacing: -0.02em; }
    .feature-card:hover .feature-title { color: var(--teal-text); }
    .feature-excerpt { margin: 0 0 12px; font-size: 1rem; line-height: 1.6; color: #4b5563; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
    body.dark-mode .feature-excerpt { color: #a1a1aa; }

    /* --- 4) Top 5 med store tal --- */
    .home-top5 { margin-bottom: 46px; }
    .top5-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 20px; }
    .top5-row { display: flex; flex-direction: column; text-decoration: none; color: inherit; }
    .top5-num { font-size: 4.4rem; font-weight: 900; line-height: 0.9; letter-spacing: -0.04em; margin-bottom: 8px; background: linear-gradient(135deg, #2563eb, #6d28d9); -webkit-background-clip: text; background-clip: text; color: transparent; }
    body.dark-mode .top5-num { background-image: linear-gradient(135deg, #60a5fa, #a78bfa); }
    .top5-thumb { aspect-ratio: 16 / 9; border-radius: 10px; overflow: hidden; margin-bottom: 10px; }
    .top5-title { margin: 7px 0 5px; font-size: 0.98rem; line-height: 1.35; font-weight: 700; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .top5-row:hover .top5-title { color: var(--teal-text); }
    .top5-row .tma-grid-meta { font-size: 12.5px; }
    @media (max-width: 1100px) { .top5-list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

    /* --- 5) Karruseller pr. emne --- */
    .home-carousel { margin-bottom: 46px; }
    .carousel-all { margin-left: auto; padding: 6px 2px; font-size: 0.9rem; font-weight: 700; color: var(--teal-text); text-decoration: none; white-space: nowrap; }
    .carousel-all:hover { text-decoration: underline; }
    .carousel-track { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 3 * 20px) / 4); gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; padding-bottom: 10px; scrollbar-width: thin; }
    .carousel-track:focus-visible { outline: 2px solid var(--teal-text); outline-offset: 4px; border-radius: 8px; }
    .carousel-card { scroll-snap-align: start; }
    /* Kort i karrusellerne skjules aldrig til "toning frem ved rul": i Jacobs Chrome blev 2 kort
       stående usynlige efter et hurtigt sidelæns swipe (18/10). Synlige altid = ingen risiko. */
    .carousel-track .watch-card.tfw-reveal { opacity: 1 !important; animation: none !important; }

    /* --- 6) Talstribe --- */
    .home-stats { margin: 0 0 46px; padding: 26px 26px 22px; border-radius: 18px; border: 1px solid var(--border-color); background: linear-gradient(135deg, rgba(37, 99, 235, 0.09), rgba(109, 40, 217, 0.09)); }
    .stats-list { list-style: none; margin: 0 0 20px; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
    .stats-list li { display: flex; flex-direction: column; gap: 4px; }
    .stats-list strong { font-size: 2.4rem; font-weight: 900; letter-spacing: -0.03em; line-height: 1; background: linear-gradient(135deg, #2563eb, #6d28d9); -webkit-background-clip: text; background-clip: text; color: transparent; }
    body.dark-mode .stats-list strong { background-image: linear-gradient(135deg, #60a5fa, #a78bfa); }
    .stats-list span { font-size: 0.9rem; font-weight: 600; color: #4b5563; }
    body.dark-mode .stats-list span { color: #b8b3bd; }
    .stats-links { display: flex; flex-wrap: wrap; gap: 10px; }

    @media (max-width: 900px) {
      .home-band { grid-template-columns: 1fr; gap: 18px; }
      .feature-card { grid-template-columns: 1fr; gap: 12px; }
      .feature-body { padding: 0 6px 6px; }
    }
    @media (max-width: 768px) {
      .home-intro { margin: 12px auto 0; padding: 0 15px; }
      /* Skrifthøjden følger skærmbredden, så h1 holder sig på én linje fra 320 px og op */
      .home-intro-title { font-size: clamp(0.9rem, 4.3vw, 1.05rem); }
      .section-heading h2 { font-size: 1.32rem; }
      .section-heading .section-note { flex-basis: 100%; }

      /* Emneknapperne: ÉN række man swiper i (før to rækker + "+N more" = ca. 160 px).
         Toningen i højre kant viser, at der er flere; den fjernes ved enden (JS). */
      .tag-bar-outer { margin-bottom: 14px; }
      .tag-bar-container {
        flex-wrap: nowrap; overflow-x: auto; overflow-y: hidden; max-height: none !important;
        justify-content: flex-start; padding: 8px 15px; gap: 8px; scrollbar-width: none;
        -webkit-mask-image: linear-gradient(to right, #000 82%, transparent);
        mask-image: linear-gradient(to right, #000 82%, transparent);
      }
      .tag-bar-container.ved-enden { -webkit-mask-image: none; mask-image: none; }
      .tag-bar-container::-webkit-scrollbar { display: none; }
      .tag-bar-container .filter-tag { flex: none; min-height: 40px; padding: 6px 14px; }
      .tag-more { display: none !important; }

      /* Feltet går helt ud til kanterne på telefonen, som hos store nyhedssites */
      .home-band { margin: 0 -15px 32px; border-radius: 0; padding: 14px 15px 16px; }
      .home-band .band-lead-title { font-size: 1.32rem; }
      .band-lead-text { padding: 50px 14px max(18px, 7%); }
      .home-band .lead-card-thumb { border-radius: 12px; margin-bottom: 10px; }
