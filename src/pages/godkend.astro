---
// Godkend-siden (19/11-2026, Jacob: "ingen artikel må gå live, før jeg har godkendt den"). Erstatter 16/11-udgaven
// (OK/Fejl EFTER udgivelse). Robotten skriver kun krypterede kladder (src/lib/kladder.mjs); her læser Jacob dem i fuld
// længde - titel, beskrivelse, resumé, FAQ, faktaboks og brødtekst - og trykker Godkend, Omskriv (med note) eller
// Afvis. Kladderne og beslutningerne hentes fra /api/godkend (functions/api/godkend.js), som dekrypterer dem, og
// kun med Jacobs Access-login. Selve siden indeholder intet om kladderne - den er tom uden login.
// noindex + ude af sitemappet + X-Robots-Tag (public/_headers). is:global: kortene laves af JavaScript.
---
<!DOCTYPE html>
<html lang="da">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Godkend artikler · TechFeedWatch</title>
<style is:global>
  :root { color-scheme: light dark; --fg:#1d2433; --bg:#f4f6f9; --kort:#fff; --linje:#d5dae3; --dim:#5b6475; --ok:#1e8449; --okbg:#e8f6ee; --fejl:#c0392b; --fejlbg:#fdecea; --accent:#2f5bd3; --gul:#fff3b0; --gulkant:#e0b400; }
  @media (prefers-color-scheme: dark) { :root { --fg:#e6e9f0; --bg:#14171d; --kort:#1c2029; --linje:#3a4150; --dim:#9aa3b5; --ok:#4cc27a; --okbg:#15301f; --fejl:#ff7b6b; --fejlbg:#3a1a17; --accent:#7ea2ff; --gul:#4a3f0a; --gulkant:#c9a400; } }
  body { margin:0; background:var(--bg); color:var(--fg); font:16px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif; }
  main { max-width:820px; margin:0 auto; padding:24px 16px 48px; }
  h1 { font-size:26px; margin:0 0 6px; }
  .intro { color:var(--dim); margin:0 0 4px; }
  .intro b { color:var(--fg); }
  #taeller { font-weight:600; margin:16px 0 14px; }
  .kort { background:var(--kort); border:1px solid var(--linje); border-left:6px solid var(--accent); border-radius:10px; padding:16px; margin:0 0 16px; }
  .kort.godkend { border-color:var(--ok); background:var(--okbg); }
  .kort.afvis { border-color:var(--fejl); background:var(--fejlbg); }
  .kort.omskriv { border-left-color:var(--gulkant); }
  .maerke { display:inline-block; font-size:13px; font-weight:700; padding:2px 10px; border-radius:999px; background:var(--bg); border:1px solid var(--linje); margin:0 6px 6px 0; }
  .maerke.gammel { border-color:var(--fejl); color:var(--fejl); }
  h2 { font-size:21px; line-height:1.3; margin:4px 0 6px; }
  .meta { color:var(--dim); font-size:14px; margin:0 0 10px; }
  img.billede { width:100%; height:auto; aspect-ratio:16/9; object-fit:cover; border-radius:8px; margin:4px 0 4px; display:block; }
  .felter { display:grid; grid-template-columns:auto 1fr; gap:4px 12px; font-size:15px; margin:0 0 12px; }
  .felter dt { color:var(--dim); font-weight:600; } .felter dd { margin:0; }
  .note { background:var(--bg); border-radius:8px; padding:10px 12px; margin:0 0 12px; font-size:15px; }
  details { border-top:1px solid var(--linje); padding-top:8px; margin:0 0 12px; }
  summary { cursor:pointer; font-weight:700; color:var(--accent); padding:6px 0; }
  .artikel { font-size:16px; } .artikel img { max-width:100%; height:auto; } .artikel table { border-collapse:collapse; display:block; overflow-x:auto; }
  .artikel td, .artikel th { border:1px solid var(--linje); padding:4px 8px; }
  .artikel .aendret { background:var(--gul); outline:3px solid var(--gul); border-left:4px solid var(--gulkant); padding-left:6px; }
  /* Kontrollanten (20/11-2026): rapporten og de rettede sætninger (blå - gul er Jacobs note) */
  .kontrol { background:var(--bg); border-left:4px solid var(--accent); border-radius:8px; padding:10px 12px; margin:0 0 12px; font-size:15px; }
  .kontrol .rettelse { border-top:1px solid var(--linje); padding:8px 0; }
  .kontrol del { display:block; color:var(--dim); } .kontrol .efter { font-weight:600; }
  .artikel .kontrolleret { border-left:4px solid var(--accent); padding-left:6px; }
  .knapper { display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin-top:8px; }
  button { font:inherit; padding:8px 18px; border-radius:8px; border:1px solid var(--linje); background:var(--kort); color:var(--fg); cursor:pointer; min-height:44px; }
  button.godkend { border-color:var(--ok); background:var(--ok); color:#fff; font-weight:700; }
  button.omskriv { border-color:var(--gulkant); font-weight:700; }
  button.afvis { border-color:var(--fejl); color:var(--fejl); font-weight:700; }
  button.afvis.sikker { background:var(--fejl); color:#fff; }
  button:disabled { opacity:.5; cursor:wait; }
  textarea { font:inherit; width:100%; min-height:90px; padding:8px 10px; border-radius:8px; border:1px solid var(--linje); background:var(--kort); color:var(--fg); box-sizing:border-box; margin-top:8px; }
  .svar { font-weight:700; font-size:18px; }
  .svar small { font-weight:400; font-size:14px; color:var(--dim); display:block; }
  button.fortryd { background:none; border:none; padding:0; min-height:0; color:var(--dim); text-decoration:underline; font-size:14px; font-weight:400; }
  .fejlbesked { color:var(--fejl); font-weight:600; }
  .tom { color:var(--dim); }
</style>
</head>
<body>
<main>
  <h1>Godkend artikler</h1>
  <p class="intro">Intet kommer på sitet, før du har trykket. Læs kladden, og vælg:</p>
  <p class="intro"><b>Godkend</b> – den går live inden for en time.<br><b>Omskriv</b> – skriv hvad der skal ændres (også din egen erfaring). Robotten retter den, og den kommer tilbage her.<br><b>Afvis</b> – den gemmes væk og kommer ikke på sitet.</p>
  <p class="intro">Noten bliver en del af artiklen, hvis den indeholder din erfaring – skriv ikke noget privat i den.</p>
  <p id="taeller">Henter kladderne …</p>
  <div id="liste"></div>
  <noscript><p class="fejlbesked">Siden kræver JavaScript.</p></noscript>
</main>
<script is:inline>
  // Alt herunder kører i Jacobs browser. Kladder og beslutninger: GET /api/godkend. Beslutning: POST /api/godkend.
  const liste = document.getElementById('liste');
  const taeller = document.getElementById('taeller');
  const MDR = ['jan.', 'feb.', 'mar.', 'apr.', 'maj', 'jun.', 'jul.', 'aug.', 'sep.', 'okt.', 'nov.', 'dec.'];
  const datoTekst = (iso) => { const d = new Date(iso); return `${d.getDate()}. ${MDR[d.getMonth()]}`; };
  const tidTekst = (iso) => { const d = new Date(iso); return `${datoTekst(iso)} kl. ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`; };
  const TYPE = { ny: 'Ny artikel', omskrevet: 'Omskrivning af en artikel, der er live', faktatjek: 'Faktatjek-rettelse af en artikel, der er live' };
  const HANDLING = { godkend: 'Godkendt – går live inden for en time', afvis: 'Afvist – gemmes væk inden for en time', omskriv: 'Sendt til omskrivning – kommer tilbage her inden for en time' };
  const FORAELDET_DAGE = 30;
  let kladder = []; let beslutninger = {};
  const fortrudt = new Set();
  const lav = (tag, klasse, tekst) => { const e = document.createElement(tag); if (klasse) e.className = klasse; if (tekst != null) e.textContent = tekst; return e; };
  // En beslutning gælder kun den version, Jacob så
  const beslutningFor = (k) => { const b = beslutninger[k.id]; return b && b.version === k.version && !fortrudt.has(k.id) ? b : null; };

  function opdaterTop() {
    const aabne = kladder.filter((k) => !beslutningFor(k)).length;
    taeller.textContent = kladder.length ? `${kladder.length} kladder · ${aabne} venter på dig` : '';
  }

  async function gem(k, handling, note, kort) {
    kort.querySelectorAll('button, textarea').forEach((b) => { b.disabled = true; });
    kort.querySelector('.fejlbesked')?.remove();
    try {
      const r = await fetch('/api/godkend', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ id: k.id, version: k.version, handling, note }) });
      const j = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(j.fejl || `HTTP ${r.status}`);
      if (handling === 'fortryd') delete beslutninger[k.id]; else beslutninger[k.id] = j;
      fortrudt.delete(k.id);
      opdaterTop(); tegn();
    } catch (e) {
      kort.querySelectorAll('button, textarea').forEach((b) => { b.disabled = false; });
      // Udløbet login (efter en uge) giver "Failed to fetch", fordi Access sender videre til login-siden.
      kort.append(lav('p', 'fejlbesked', `Kunne ikke gemme (${e.message}). Genindlæs siden – måske skal du logge ind igen.`));
    }
  }

  // Markér de afsnit, robotten ændrede efter Jacobs note (gult)
  // Kontrollanten (20/11-2026): en linje med hvad der er tjekket, og rettelserne foldet ud nedenunder
  const TYPE_DK = { WRONG_SOURCE: 'forkert kilde', NOT_IN_SOURCE: 'står ikke i kilden', PARTLY: 'kun delvis i kilden', MISCONCEPTION: 'faktuel fejl', CONTRADICTION: 'selvmodsigelse', OVERCLAIM: 'overdrevet', UNNAMED: 'kilden ikke navngivet', UNSUPPORTED: 'uden belæg', META: 'meta-beskrivelse' };
  function kontrolBoks(kt) {
    const b = lav('div', 'kontrol');
    const r = kt.rettelser || [];
    const dele = [];
    if (kt.kildeTjekket !== undefined) dele.push(`${kt.kildeTjekket} kildesætninger holdt op mod kildernes egen tekst (${kt.kildeOk || 0} stod der${kt.kildeIkkeLaest ? `, ${kt.kildeIkkeLaest} kunne ikke læses` : ''})`);
    if (kt.ekspertFund !== undefined) dele.push(`ekspertlæsning: ${kt.ekspertFund} fund`);
    dele.push(r.length ? `${r.length} rettet (${r.filter((x) => !x.efter).length} fjernet)` : 'intet at rette');
    if (kt.usd) dele.push(`pris $${kt.usd}`);
    b.append(lav('div', '', `Kontrollant: ${dele.join(' · ')}.`));
    if (kt.regler?.jegAfsnit > 1) b.append(lav('div', 'meta', `${kt.regler.jegAfsnit} afsnit i din stemme (jeg/vi).`));
    if (kt.kunneIkke?.length) b.append(lav('div', 'fejlbesked', `Kontrollen kunne ikke køre helt: ${kt.kunneIkke.join(', ')}.`));
    // Fund, kontrollanten ikke selv måtte eller kunne rette (20/11-2026) - teksten er urørt, Jacob afgør det
    if (kt.ikkeRettet?.length) {
      const d2 = lav('details'); d2.append(lav('summary', '', `Fundet, men ikke rettet - tjek selv (${kt.ikkeRettet.length})`));
      for (const x of kt.ikkeRettet) { const li = lav('div', 'rettelse'); li.append(lav('div', 'meta', `${TYPE_DK[x.type] || x.type}: ${x.grund || ''}`)); li.append(lav('div', '', x.saetning)); d2.append(li); }
      b.append(d2);
    }
    if (r.length) {
      const d = lav('details'); d.append(lav('summary', '', `Se rettelserne (${r.length}) - markeret med blåt i artiklen`));
      for (const x of r) {
        const li = lav('div', 'rettelse');
        li.append(lav('div', 'meta', `${TYPE_DK[x.type] || x.type}: ${x.grund || ''}`));
        li.append(lav('del', '', x.foer));
        li.append(lav('div', x.efter ? 'efter' : 'meta', x.efter || '(fjernet)'));
        d.append(li);
      }
      b.append(d);
    }
    return b;
  }
  function markerKontrol(div, kt) {
    const efter = (kt?.rettelser || []).map((x) => x.efter).filter(Boolean).map((t) => t.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1').replace(/\s+/g, ' ').trim().slice(0, 40));
    if (!efter.length) return;
    for (const el of div.querySelectorAll('p, li, td')) { const t = el.textContent.replace(/\s+/g, ' '); if (efter.some((e) => e && t.includes(e))) el.classList.add('kontrolleret'); }
  }
  function markerAendret(div, aendret) {
    if (!aendret || !aendret.length) return;
    const ren = (t) => t.replace(/\s+/g, ' ').trim();
    for (const el of div.querySelectorAll('p, li, h2, h3, h4, td, blockquote')) {
      const t = ren(el.textContent);
      if (aendret.some((a) => a && t.startsWith(ren(a).slice(0, 40)))) el.classList.add('aendret');
    }
  }
</script>
<script is:inline>
  function kortFor(k) {
    const b = beslutningFor(k);
    const kort = lav('article', 'kort' + (b ? ' ' + b.handling : ''));
    if (!k.visning) { kort.append(lav('p', 'fejlbesked', k.fejl || 'Kladden kunne ikke læses.')); return kort; }
    const v = k.visning;
    const top = lav('div');
    top.append(lav('span', 'maerke', TYPE[k.type] || k.type));
    if (k.version > 1) top.append(lav('span', 'maerke', `Version ${k.version}`));
    if ((Date.now() - Date.parse(k.oprettet)) / 864e5 > FORAELDET_DAGE) top.append(lav('span', 'maerke gammel', 'Forældet (over 30 dage)'));
    kort.append(top, lav('h2', '', v.title));
    // Billedet øverst i artiklen: det nye, der holdes tilbage med kladden - ellers det, artiklen allerede har
    const billedSrc = k.billede || (k.type !== 'ny' ? `/billeder/${k.slug}.webp` : null);
    if (billedSrc) { const img = lav('img', 'billede'); img.src = billedSrc; img.alt = ''; img.loading = 'lazy'; img.onerror = () => img.remove(); kort.append(img); kort.append(lav('p', 'meta', k.billede ? 'Nyt billede – kommer først på sitet, når du godkender.' : 'Artiklens nuværende billede (uændret).')); }
    else kort.append(lav('p', 'meta', 'Intet billede – artiklen får sitets emnekort.'));
    const meta = lav('p', 'meta', `Skrevet ${tidTekst(k.skrevet)} · ${v.ord} ord`);
    if (k.type !== 'ny') { const a = lav('a', '', 'se den nuværende udgave'); a.href = `/video/${k.slug}/`; a.target = '_blank'; a.rel = 'noopener'; meta.append(' · ', a); }
    kort.append(meta);

    const dl = lav('dl', 'felter');
    for (const [navn, tekst] of [['Søgning', v.targetQuestion], ['Beskrivelse', v.meta], ['Resumé', v.summary], ['Adresse', `/video/${k.slug}/`]]) if (tekst) dl.append(lav('dt', '', navn), lav('dd', '', tekst));
    kort.append(dl);

    if (k.version > 1 && (k.note || k.aendringer)) {
      const n = lav('div', 'note');
      if (k.note) n.append(lav('div', '', `Din note: "${k.note}"`));
      if (k.aendringer) n.append(lav('div', '', `Robotten: ${k.aendringer}`));
      if (k.aendret?.length) n.append(lav('div', 'meta', `${k.aendret.length} afsnit ændret – markeret med gult nedenfor.`));
      kort.append(n);
    }
    if (k.fejl) kort.append(lav('p', 'fejlbesked', `Omskrivningen lykkedes ikke: ${k.fejl}. Prøv en anden note, eller godkend/afvis som den er.`));
    // 20/11-2026: kontrollantens rapport (src/lib/kontrollant.mjs) - hvad der er tjekket, og hver rettelse med før/efter
    if (k.kontrol) kort.append(kontrolBoks(k.kontrol));

    const d = lav('details'); if (k.version > 1) d.open = true;
    d.append(lav('summary', '', `Læs hele artiklen (${v.ord} ord)`));
    const art = lav('div', 'artikel'); art.innerHTML = v.html; markerAendret(art, k.aendret);
    markerKontrol(art, k.kontrol);
    d.append(art);
    if (v.keyFacts?.length) { d.append(lav('h3', '', 'Faktaboks')); const ul = lav('ul'); for (const f of v.keyFacts) ul.append(lav('li', '', `${f.text} (${f.source})`)); d.append(ul); }
    if (v.faqs?.length) { d.append(lav('h3', '', 'FAQ')); for (const q of v.faqs) { d.append(lav('p', '', '')); d.lastChild.append(lav('b', '', q.question), document.createElement('br'), q.answer); } }
    kort.append(d);

    if (b) {
      const s = lav('div', 'svar', HANDLING[b.handling]);
      s.append(lav('small', '', `${tidTekst(b.tid)}${b.note ? ` · note: "${b.note}"` : ''}`));
      const f = lav('button', 'fortryd', 'Fortryd'); f.onclick = () => gem(k, 'fortryd', '', kort);
      s.append(f);
      kort.append(s);
      return kort;
    }
    const knapper = lav('div', 'knapper');
    const godkend = lav('button', 'godkend', '✓ Godkend'); godkend.onclick = () => gem(k, 'godkend', '', kort);
    const omskriv = lav('button', 'omskriv', '✎ Omskriv');
    const afvis = lav('button', 'afvis', '✗ Afvis');
    let sikker = false;
    afvis.onclick = () => { if (!sikker) { sikker = true; afvis.textContent = 'Tryk igen for at afvise'; afvis.classList.add('sikker'); return; } gem(k, 'afvis', '', kort); };
    knapper.append(godkend, omskriv, afvis);
    kort.append(knapper);
    omskriv.onclick = () => {
      if (kort.querySelector('textarea')) return;
      const t = lav('textarea'); t.placeholder = 'Hvad skal laves om? Fx "tallet for 2025 er forkert, det er 12 %" eller "skriv at jeg selv har brugt det i to år"'; t.maxLength = 2000;
      const send = lav('button', 'omskriv', 'Send til omskrivning');
      send.onclick = () => { if (t.value.trim().length < 5) { t.focus(); return; } gem(k, 'omskriv', t.value.trim(), kort); };
      kort.append(t, lav('div', 'knapper')); kort.lastChild.append(send); t.focus();
    };
    return kort;
  }

  function tegn() {
    liste.textContent = '';
    if (!kladder.length) { liste.append(lav('p', 'tom', 'Ingen kladder venter. Robotten lægger nye her, når den har skrevet.')); return; }
    for (const k of kladder) liste.append(kortFor(k));
  }

  fetch('/api/godkend')
    .then(async (r) => { const j = await r.json().catch(() => ({})); if (!r.ok) throw new Error(j.fejl || `HTTP ${r.status}`); return j; })
    .then((j) => { kladder = j.kladder || []; beslutninger = j.beslutninger || {}; opdaterTop(); tegn(); })
    .catch((e) => { taeller.textContent = ''; taeller.append(lav('span', 'fejlbesked', `Kunne ikke hente kladderne (${e.message}). Er du logget ind?`)); });
</script>
</body>
</html>
