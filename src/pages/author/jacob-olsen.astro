---
import MainLayout from '../../layouts/MainLayout.astro';

const title = "Jacob Olsen";
const description = "Jacob Olsen is the founder of Tech Feed Watch, a site that answers the questions people search for about AI, technology, fintech, and crypto, with independent creators' videos as source material.";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Jacob Olsen",
  "url": "https://techfeedwatch.com/author/jacob-olsen",
  "image": "https://techfeedwatch.com/jacob-olsen.png",
  "jobTitle": "Founder",
  "worksFor": { "@type": "Organization", "name": "Tech Feed Watch", "url": "https://techfeedwatch.com/" },
  "description": "Jacob Olsen is the founder of Tech Feed Watch, a site that answers the questions people search for about AI, tech, fintech, and crypto, with independent creators' videos as source material.",
  "knowsAbout": ["Artificial Intelligence", "Technology", "Fintech", "Cryptocurrency", "SEO", "Automation"],
  "email": "mailto:info@techfeedwatch.com"
};
---

<MainLayout title={title} description={description} schema={personSchema}>
  <style is:global>
    .author-page { max-width: 800px; margin: 0 auto; padding: 40px 20px; flex: 1; width: 100%; box-sizing: border-box; }
    .author-hero { display: flex; gap: 22px; align-items: center; margin-bottom: 30px; }
    .author-hero img { width: 110px; height: 110px; border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 3px solid var(--border-color); }
    .author-hero h1 { margin: 0 0 4px 0; font-size: 2rem; }
    .author-hero .role { color: var(--teal-text); font-weight: 700; font-size: 1rem; margin: 0 0 8px 0; }
    .author-hero .expertise { color: #6b7280; font-size: 0.92rem; margin: 0; }
    body.dark-mode .author-hero .expertise { color: #9ca3af; }

    .author-body { line-height: 1.7; font-size: 1.05rem; }
    .author-body h2 { font-size: 1.4rem; margin: 32px 0 12px 0; padding-bottom: 8px; border-bottom: 1px solid var(--border-color); }
    .author-body p { margin: 0 0 16px 0; color: #374151; }
    body.dark-mode .author-body p { color: #d1d5db; }
    .author-body a { color: var(--teal-text); text-decoration: none; }
    .author-body a:hover { text-decoration: underline; }

    @media (max-width: 640px) {
      .author-page { padding: 25px 15px; }
      .author-hero { flex-direction: column; text-align: center; }
      .author-hero h1 { font-size: 1.7rem; }
    }
  </style>

  <div class="author-page">
    <div class="author-hero">
      <img src="/jacob-olsen.png" alt="Jacob Olsen" width="110" height="110" />
      <div>
        <h1>Jacob Olsen</h1>
        <p class="role">Founder, Tech Feed Watch</p>
        <p class="expertise">Writes about AI, technology, fintech, and crypto.</p>
      </div>
    </div>

    <div class="author-body">
      <p>Jacob Olsen is the founder of <a href="/about">Tech Feed Watch</a>, a project built on a simple belief: people deserve a straight answer to the question they actually asked — and a lot of the best material on technology is locked inside long videos that most people never have time to watch.</p>

      <h2>What I cover</h2>
      <p>My focus is artificial intelligence, technology, fintech, and crypto. The site follows independent creators and outlets across YouTube — from builders and researchers to major newsrooms — and each article answers a question people search for, using one of those videos as its research material.</p>

      <h2>How I work</h2>
      <p>Every article starts from two things: a question people search for on Google, and a video from an independent creator on that subject. A system I built picks both, and a language model writes the article, using the video's transcript as its research material. It publishes automatically — I do not read every article before it goes live. What is mine is the machinery and the rules it follows: which subjects, which sources, what gets rejected, and what this site is allowed to claim. The aim is never to replace the original creator — they are credited on every article.</p>
      <p>I care about getting things right. If you ever spot an error, I want to hear about it and fix it.</p>

      <h2>Get in touch</h2>
      <p>You can reach me at <a href="/contact">the contact page</a> or directly at <strong>info@techfeedwatch.com</strong> — for feedback, corrections, or a video worth covering.</p>
    </div>
  </div>
</MainLayout>
