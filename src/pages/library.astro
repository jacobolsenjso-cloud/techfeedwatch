---
import SourceLine from '../components/SourceLine.astro';
import MainLayout from '../layouts/MainLayout.astro'; 
import { tagSlug as slugify } from '../lib/tags';

const allVideos = Object.values(import.meta.glob('../content/videos/*.md', { eager: true }));

// Emne-farvesystem (samme palette som resten af sitet)
const TAG_COLORS: Record<string, string> = {
  "AI & Tech": "#06b6d4", "SEO": "#6366f1", "Automation": "#14b8a6",
  "Coding": "#2563eb", "Business & Money": "#059669", "AI Video": "#d926c8",
  "Productivity": "#8b5cf6", "Fintech": "#1e3a8a", "Crypto": "#f59e0b",
  "Cybersecurity": "#dc2626", "Quantum Computing": "#7c3aed", "Hardware & Chips": "#ea580c", "AR & VR": "#db2777"
};

// Antal nyeste videoer der vises pr. emne på hub-siden
const PREVIEW_COUNT = 8;

// Finder alle unikke tags automatisk
const uniqueTags = [...new Set(allVideos.flatMap((v: any) => {
  const t = v.frontmatter.tags || v.frontmatter.tag || [];
  return Array.isArray(t) ? t : [t];
}))].filter(Boolean);

// Byg en liste af emne-sektioner sorteret efter antal videoer (størst først)
const tagSections = uniqueTags.map((tag: string) => {
  const categoryVideos = allVideos
    .filter((v: any) => {
      const vTags = v.frontmatter.tags || v.frontmatter.tag || [];
      const tagsArray = Array.isArray(vTags) ? vTags : [vTags];
      return tagsArray.includes(tag);
    })
    .sort((a: any, b: any) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
  return { tag, videos: categoryVideos, count: categoryVideos.length };
})
  .filter((s) => s.count > 0)
  .sort((a, b) => b.count - a.count);

// Byg måneds-arkiv (kun artikler, ikke shorts) sorteret nyeste først
const monthMap = new Map<string, { label: string; count: number }>();
allVideos
  .filter((v: any) => !v.frontmatter.isShort)
  .forEach((v: any) => {
    const d = new Date(v.frontmatter.date);
    if (isNaN(d.getTime())) return;
    const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
    const label = d.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
    const existing = monthMap.get(key);
    if (existing) existing.count += 1;
    else monthMap.set(key, { label, count: 1 });
  });
const months = [...monthMap.entries()]
  .map(([key, val]) => ({ key, ...val }))
  .sort((a, b) => (a.key < b.key ? 1 : -1));

const formatDate = (d: string) => {
  const parsed = new Date(d);
  return isNaN(parsed.getTime()) ? d : parsed.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
};
---

<MainLayout title="Library" description="Browse the full Tech Feed Watch library by topic or by month. Curated tech, AI, fintech and crypto videos turned into readable articles.">
  
  <style is:global>
    .library-wrapper { 
      padding: 30px 20px; 
      max-width: 1600px; 
      margin: 0 auto; 
      flex: 1; 
      width: 100%; 
      box-sizing: border-box; 
    }

    .header-title { 
      font-size: 2.2rem; 
      margin-top: 0;
      margin-bottom: 10px; 
      display: flex; 
      align-items: center; 
      gap: 12px; 
    }
    .library-intro { font-size: 1.05rem; color: #6b7280; margin: 0 0 35px 0; max-width: 900px; }
    body.dark-mode .library-intro { color: #9ca3af; }
    
    .tag-section { margin-bottom: 48px; }
    .tag-section-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 2px solid var(--tag-accent, var(--border-color)); flex-wrap: wrap; }
    .tag-title { font-size: 1.5rem; margin: 0; display: flex; align-items: center; gap: 10px; }
    .tag-dot { width: 14px; height: 14px; border-radius: 50%; background: var(--tag-accent, #6b7280); flex-shrink: 0; }
    .tag-count { font-size: 0.95rem; font-weight: 500; color: #6b7280; }
    body.dark-mode .tag-count { color: #9ca3af; }
    /* FAST #0e7490, ikke var(--teal-text). Variablen er lyseblå i mørk tilstand
       — den duer som tekstfarve, men ikke som baggrund under hvid tekst.
       Første forsøg gav 2,14:1 i mørk tilstand. En baggrund der bærer hvid
       tekst skal være mørk i begge tilstande. */
    .see-all-btn { min-height: 44px; box-sizing: border-box; text-decoration: none; font-size: 0.9rem; font-weight: 600; color: #fff; background: #0e7490; border-left: 4px solid var(--tag-accent, #6b7280); padding: 8px 16px; border-radius: 20px; white-space: nowrap; transition: opacity 0.2s, transform 0.2s; }
    .see-all-btn:hover { opacity: 0.88; transform: translateX(2px); }

    /* Video Grid */
    .video-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
    .watch-card { text-decoration: none; color: inherit; display: block; transition: transform 0.2s; }
    .watch-card:hover { transform: translateY(-3px); }
    
    .watch-card-thumb { aspect-ratio: 16/9; border-radius: 12px; margin-bottom: 10px; position: relative; overflow: hidden; }
    .watch-card-thumb img { width: 100%; height: 100%; object-fit: cover; position: absolute; top: 0; left: 0; border: none; }
    .duration-badge { position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.8); color: white; padding: 2px 6px; border-radius: 4px; font-size: 12px; font-weight: 600; letter-spacing: 0.5px; z-index: 2; }

    .tma-grid-title { margin: 0 0 5px 0; font-size: 15px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;}
    .watch-card:hover .tma-grid-title { color: var(--teal-text); }
    .tma-grid-meta { font-size: 13px; color: #6b7280; margin: 0; }
    body.dark-mode .tma-grid-meta { color: #9ca3af; }

    /* Måneds-arkiv */
    .archive-section { margin-top: 20px; padding-top: 40px; border-top: 1px solid var(--border-color); }
    .archive-heading { font-size: 1.6rem; margin: 0 0 6px 0; }
    .archive-sub { font-size: 0.95rem; color: #6b7280; margin: 0 0 22px 0; }
    body.dark-mode .archive-sub { color: #9ca3af; }
    .month-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; }
    .month-card { display: flex; align-items: center; justify-content: space-between; gap: 10px; text-decoration: none; color: inherit; background: var(--hover-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 16px 18px; transition: border-color 0.2s, transform 0.2s; }
    .month-card:hover { border-color: var(--teal-text); transform: translateY(-2px); }
    .month-label { font-weight: 600; font-size: 1rem; }
    .month-badge { font-size: 0.8rem; font-weight: 600; color: var(--teal-text); background: rgba(8,145,178,0.12); padding: 3px 10px; border-radius: 20px; }
    body.dark-mode .month-badge { color: #22d3ee; background: rgba(34,211,238,0.12); }

    @media (max-width: 768px) { 
      .library-wrapper { padding: 15px; }
      .header-title { font-size: 1.8rem; }
      .video-grid { grid-template-columns: 1fr; gap: 20px; }
      .watch-card-thumb { border-radius: 8px; }
      .month-grid { grid-template-columns: 1fr 1fr; }
    }
  </style>

  <div class="library-wrapper">
    <h1 class="header-title">📚 Video Library</h1>
    <p class="library-intro">Browse everything by topic below — each section shows the newest videos, and you can open the full archive for any topic. Prefer to browse by date? Jump to the month archive at the bottom.</p>
    
    {tagSections.map(({ tag, videos, count }) => {
      const accent = TAG_COLORS[tag] || "#6b7280";
      const preview = videos.slice(0, PREVIEW_COUNT);
      return (
        <div class="tag-section" style={`--tag-accent: ${accent}`}>
          <div class="tag-section-head">
            <h2 class="tag-title"><span class="tag-dot"></span>{tag} <span class="tag-count">({count})</span></h2>
            <a href={`/tag/${slugify(tag)}`} class="see-all-btn">See all {tag} →</a>
          </div>
          <div class="video-grid">
            {preview.map((video: any) => (
              <a href={`/video/${video.file.split('/').pop().replace('.md', '')}`} class="watch-card">
                <div class="watch-card-thumb">
                  <img src={`https://img.youtube.com/vi/${video.frontmatter.youtubeId}/mqdefault.jpg`} alt={video.frontmatter.title} loading="lazy" />
                  <span class="watch-card-play" aria-hidden="true">▶</span>
                </div>
                <div>
                  <h2 class="tma-grid-title">{video.frontmatter.title}</h2>
                  <SourceLine channel={video.frontmatter.channelTitle} date={video.frontmatter.date} minutesRead={video.frontmatter.minutesRead} />
                </div>
              </a>
            ))}
          </div>
        </div>
      );
    })}

    <div class="archive-section" id="browse-by-month">
      <h2 class="archive-heading">🗓️ Browse by month</h2>
      <p class="archive-sub">Every article, grouped by the month it was published.</p>
      <div class="month-grid">
        {months.map((m) => (
          <a href={`/archive/${m.key}`} class="month-card">
            <span class="month-label">{m.label}</span>
            <span class="month-badge">{m.count}</span>
          </a>
        ))}
      </div>
    </div>

  </div>
</MainLayout>
