---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Watch Later"
  description="Your saved Tech Feed Watch articles, kept in this browser so you can come back to them whenever you have time."
  noindex={true}
>

  <style is:global>
    .watch-later-wrapper {
      padding: 30px 20px; max-width: 1400px; margin: 0 auto;
      flex: 1; width: 100%; box-sizing: border-box;
    }

    .wl-head { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
    .wl-head h1 { font-size: 2.2rem; margin: 0; letter-spacing: -0.02em; }
    .wl-icon { width: 30px; height: 30px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; color: var(--teal-text); flex-shrink: 0; }
    .wl-count { font-size: 0.9rem; color: #6b7280; margin: 0 0 30px 0; }
    body.dark-mode .wl-count { color: #9ca3af; }

    #saved-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }

    /* Kortet er ikke længere ét stort link: fjern-knappen skal kunne klikkes
       uden at man samtidig åbner artiklen. Derfor et wrapper-element. */
    .wl-card { position: relative; }
    .wl-link { text-decoration: none; color: inherit; display: block; transition: transform 0.2s ease; }
    .wl-card:hover .wl-link { transform: translateY(-3px); }

    .watch-card-thumb {
      aspect-ratio: 16/9; border-radius: 12px; margin-bottom: 10px;
      position: relative; overflow: hidden; background: #e6e8eb;
    }
    body.dark-mode .watch-card-thumb { background: #26242c; }
    .watch-card-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .wl-card:hover .watch-card-thumb { box-shadow: 0 6px 24px rgba(0,0,0,0.10), 0 2px 8px rgba(0,0,0,0.05); }

    .duration-badge {
      position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.8);
      color: #fff; padding: 2px 6px; border-radius: 4px; font-size: 12px;
      font-weight: 600; letter-spacing: 0.5px;
    }

    .tma-grid-title {
      margin: 0 0 5px 0; font-size: 15px; line-height: 1.4; font-weight: 600;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .wl-card:hover .tma-grid-title { color: var(--teal-text); }
    .tma-grid-meta { font-size: 13px; color: #6b7280; margin: 0; }
    body.dark-mode .tma-grid-meta { color: #9ca3af; }

    /* Fjern-knap: altid synlig på touch, hvor der ikke findes hover */
    .wl-remove {
      position: absolute; top: 8px; right: 8px;
      width: 32px; height: 32px; border-radius: 50%;
      background: rgba(0,0,0,0.65); color: #fff; border: none;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; opacity: 0; transition: opacity 0.2s ease, background 0.2s ease;
      z-index: 2; padding: 0;
    }
    .wl-card:hover .wl-remove, .wl-remove:focus-visible { opacity: 1; }
    .wl-remove:hover { background: #b91c1c; }
    .wl-remove svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2.2; stroke-linecap: round; }
    @media (hover: none) { .wl-remove { opacity: 1; } }

    .empty-msg { font-size: 1.05rem; color: #6b7280; margin-top: 10px; line-height: 1.6; }
    body.dark-mode .empty-msg { color: #9ca3af; }
    .empty-msg a { color: var(--teal-text); font-weight: 600; }

    /* Kort besked når noget er fjernet, så handlingen bekræftes */
    .wl-toast {
      position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%);
      background: var(--card-bg); border: 1px solid var(--border-color);
      box-shadow: 0 6px 24px rgba(0,0,0,0.12);
      border-radius: 999px; padding: 10px 18px; font-size: 0.88rem; font-weight: 600;
      display: flex; align-items: center; gap: 14px; z-index: 1000;
    }
    .wl-toast button {
      font: inherit; font-weight: 700; color: var(--teal-text);
      background: none; border: none; cursor: pointer; padding: 0;
    }

    @media (max-width: 768px) {
      .watch-later-wrapper { padding: 15px; }
      .wl-head h1 { font-size: 1.8rem; }
      #saved-grid { grid-template-columns: 1fr; gap: 20px; }
      .watch-card-thumb { border-radius: 8px; }
    }
  </style>

  <div class="watch-later-wrapper">
    <div class="wl-head">
      <svg class="wl-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
      <h1>Watch Later</h1>
    </div>
    <p id="savedCount" class="wl-count"></p>

    <p id="emptyMsg" class="empty-msg" style="display: none;">
      Nothing saved yet. Use the <strong>Save</strong> button on any article and it will appear here.
      <br /><a href="/library">Browse the library →</a>
    </p>

    <div id="saved-grid"></div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const grid = document.getElementById('saved-grid');
      const emptyMsg = document.getElementById('emptyMsg');
      const countEl = document.getElementById('savedCount');

      let idToSlug = {};
      let validSlugs = null;
      let bySlug = {};          // slug -> { channelTitle, date, duration }
      let lastRemoved = null;   // så en fjernelse kan fortrydes

      const read = () => { try { return JSON.parse(localStorage.getItem('watchLater') || '[]'); } catch (e) { return []; } };
      const write = (v) => localStorage.setItem('watchLater', JSON.stringify(v));

      const esc = (s) => String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');

      const fmtDate = (d) => {
        const p = new Date(d);
        return isNaN(p.getTime()) ? '' : p.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
      };

      // Retter gamle ID-baserede links til titel-slugs, og fjerner artikler der ikke findes mere
      const heal = (videos) => {
        if (!validSlugs) return { healed: videos, changed: false };
        let changed = false;
        const healed = [];
        videos.forEach((video) => {
          let ytId = video.youtubeId || null;
          if (!ytId && video.slug && /^[a-zA-Z0-9_-]{11}$/.test(video.slug) && idToSlug[video.slug]) ytId = video.slug;
          let newSlug = video.slug;
          if (ytId && idToSlug[ytId]) newSlug = idToSlug[ytId];
          if (!validSlugs.has(newSlug)) { changed = true; return; }
          if (newSlug !== video.slug) changed = true;
          healed.push(newSlug === video.slug ? video : Object.assign({}, video, { slug: newSlug }));
        });
        return { healed, changed };
      };

      const cardHtml = (video) => {
        const meta = bySlug[video.slug] || {};
        const src = meta.channelTitle
          ? '<span class="card-source">' +
            '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/></svg>' +
            esc(meta.channelTitle) + '</span><span aria-hidden="true"> · </span>'
          : '';
        const date = meta.date ? fmtDate(meta.date) : '';
        const dur = meta.duration ? '<div class="duration-badge">' + esc(meta.duration) + '</div>' : '';
        const img = (video.img || '').replace('mqdefault', 'hqdefault');

        return '' +
          '<div class="wl-card" data-slug="' + esc(video.slug) + '">' +
            '<button type="button" class="wl-remove" aria-label="Remove ' + esc(video.title) + ' from Watch Later" title="Remove">' +
              '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>' +
            '</button>' +
            '<a href="/video/' + esc(video.slug) + '" class="wl-link">' +
              '<div class="watch-card-thumb">' +
                '<img src="' + esc(img) + '" alt="" loading="lazy" />' + dur +
              '</div>' +
              '<h2 class="tma-grid-title">' + esc(video.title) + '</h2>' +
              '<p class="tma-grid-meta">' + src + '<span>' + esc(date) + '</span></p>' +
            '</a>' +
          '</div>';
      };

      // Nyeste øverst. Artikler gemt efter denne ændring har savedAt og sorteres
      // på det. Ældre poster har intet tidsstempel — de blev lagt bagest i
      // arrayet efterhånden som de blev gemt, så deres omvendte rækkefølge er
      // den rigtige, og de placeres efter alt med tidsstempel.
      const newestFirst = (list) => list
        .map((v, i) => ({ v, t: v.savedAt || 0, i }))
        .sort((a, b) => (b.t - a.t) || (b.i - a.i))
        .map((x) => x.v);

      const render = () => {
        const { healed, changed } = heal(read());
        if (changed) write(healed);

        countEl.textContent = healed.length
          ? healed.length + (healed.length === 1 ? ' saved article' : ' saved articles')
          : '';

        if (healed.length === 0) {
          grid.innerHTML = '';
          emptyMsg.style.display = 'block';
          return;
        }
        emptyMsg.style.display = 'none';
        grid.innerHTML = newestFirst(healed).map(cardHtml).join('');
      };

      const toast = (text, onUndo) => {
        document.querySelectorAll('.wl-toast').forEach((t) => t.remove());
        const el = document.createElement('div');
        el.className = 'wl-toast';
        el.innerHTML = '<span></span><button type="button">Undo</button>';
        el.querySelector('span').textContent = text;
        el.querySelector('button').addEventListener('click', () => { onUndo(); el.remove(); });
        document.body.appendChild(el);
        setTimeout(() => el.remove(), 6000);
      };

      // Fjern-knappen ligger inde i kortet, så vi lytter på gitteret
      grid.addEventListener('click', (e) => {
        const btn = e.target.closest('.wl-remove');
        if (!btn) return;
        e.preventDefault();
        const card = btn.closest('.wl-card');
        const slug = card && card.getAttribute('data-slug');
        if (!slug) return;

        const list = read();
        const index = list.findIndex((v) => v.slug === slug);
        if (index === -1) return;
        lastRemoved = { item: list[index], index };
        list.splice(index, 1);
        write(list);
        render();

        toast('Removed from Watch Later', () => {
          const cur = read();
          cur.splice(Math.min(lastRemoved.index, cur.length), 0, lastRemoved.item);
          write(cur);
          render();
        });
      });

      fetch('/videos.json')
        .then((res) => res.json())
        .then((all) => {
          all.forEach((v) => {
            if (v.youtubeId) idToSlug[v.youtubeId] = v.slug;
            bySlug[v.slug] = { channelTitle: v.channelTitle, date: v.date, duration: v.duration };
          });
          validSlugs = new Set(all.map((v) => v.slug));
          render();
        })
        .catch(render);
    });
  </script>
</MainLayout>
