---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Watch Later">
  
  <style is:global>
    .watch-later-wrapper { 
      padding: 30px 20px; 
      max-width: 1400px; 
      margin: 0 auto; 
      flex: 1; 
      width: 100%; 
      box-sizing: border-box; 
    }

    .header-title { 
      font-size: 2.2rem; 
      margin-top: 0;
      margin-bottom: 40px; 
      display: flex; 
      align-items: center; 
      gap: 12px; 
    }

    /* Video Grid (Matchende med resten af sitet) */
    #saved-grid { 
      display: grid; 
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); 
      gap: 20px; 
    }
    
    .watch-card { text-decoration: none; color: inherit; display: block; transition: transform 0.2s; }
    .watch-card:hover { transform: translateY(-3px); }
    
    .watch-card-thumb { aspect-ratio: 16/9; border-radius: 12px; margin-bottom: 10px; position: relative; overflow: hidden; }
    
    .tma-grid-title { margin: 0 0 5px 0; font-size: 15px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;}
    .watch-card:hover .tma-grid-title { color: #7c3aed; }
    
    .empty-msg { font-size: 1.1rem; color: #6b7280; margin-top: 20px; }
    body.dark-mode .empty-msg { color: #9ca3af; }

    @media (max-width: 768px) { 
      .watch-later-wrapper { padding: 15px; }
      .header-title { font-size: 1.8rem; }
      #saved-grid { grid-template-columns: 1fr; gap: 20px; }
      .watch-card-thumb { border-radius: 8px; }
    }
  </style>

  <div class="watch-later-wrapper">
    <h1 class="header-title">⏱️ Watch Later</h1>
    <p id="emptyMsg" class="empty-msg" style="display: none;">You haven't saved any videos yet.</p>
    <div id="saved-grid"></div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const grid = document.getElementById('saved-grid');
      const emptyMsg = document.getElementById('emptyMsg');

      // Selvhelbredende: opslag fra youtubeId -> nuværende titel-slug, hentet fra videos.json
      let idToSlug = {};
      let validSlugs = null;

      // Retter gamle ID-baserede links til nye titel-slugs, og fjerner videoer der ikke længere findes
      const healVideos = (videos) => {
        if (!validSlugs) return { healed: videos, changed: false };
        let changed = false;
        const healed = [];
        videos.forEach(video => {
          let youtubeId = video.youtubeId || null;
          if (!youtubeId && video.slug && /^[a-zA-Z0-9_-]{11}$/.test(video.slug) && idToSlug[video.slug]) {
            youtubeId = video.slug;
          }
          let newSlug = video.slug;
          if (youtubeId && idToSlug[youtubeId]) {
            newSlug = idToSlug[youtubeId];
          }
          if (!validSlugs.has(newSlug)) {
            changed = true;
            return;
          }
          if (newSlug !== video.slug) changed = true;
          healed.push(newSlug === video.slug ? video : { ...video, slug: newSlug });
        });
        return { healed, changed };
      };

      const render = () => {
        const watchLater = JSON.parse(localStorage.getItem('watchLater') || '[]');
        const { healed, changed } = healVideos(watchLater);
        if (changed) localStorage.setItem('watchLater', JSON.stringify(healed));

        if (healed.length === 0) {
          if (grid) grid.innerHTML = '';
          if (emptyMsg) emptyMsg.style.display = 'block';
          return;
        }

        if (emptyMsg) emptyMsg.style.display = 'none';
        if (grid) {
          grid.innerHTML = healed.map(video => `
            <a href="/video/${video.slug}" class="watch-card">
              <div class="watch-card-thumb">
                <img src="${video.img.replace('mqdefault', 'hqdefault')}" alt="${(video.title || '').replace(/"/g, '&quot;')}" loading="lazy" />
                <span class="watch-card-play" aria-hidden="true">▶</span>
              </div>
              <h3 class="tma-grid-title">${video.title}</h3>
            </a>
          `).join('');
        }
      };

      fetch('/videos.json')
        .then(res => res.json())
        .then(allVideos => {
          allVideos.forEach(v => {
            if (v.youtubeId) idToSlug[v.youtubeId] = v.slug;
          });
          validSlugs = new Set(allVideos.map(v => v.slug));
          render();
        })
        .catch(() => {
          render();
        });
    });
  </script>
</MainLayout>