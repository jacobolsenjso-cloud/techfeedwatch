---
import MainLayout from '../../layouts/MainLayout.astro';

const title = "Random File Generator — Make a Dummy File of Any Size";
const description = "Generate a test file of an exact size, filled with random bytes or zeros. For testing upload limits, storage and error handling. Made in your browser.";
---

<MainLayout title={title} description={description}>
  <style is:global>
    .fr-wrapper { max-width: 820px; margin: 0 auto; padding: 40px 20px; flex: 1; width: 100%; box-sizing: border-box; }
    .fr-header h1 { margin: 0 0 8px 0; font-size: 2rem; }
    .fr-header p { color: #6b7280; margin: 0 0 26px 0; font-size: 1.05rem; line-height: 1.6; }
    body.dark-mode .fr-header p { color: #9ca3af; }

    .fr-panel { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px; }
    .fr-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 16px; }
    .fr-label { font-size: 0.9rem; font-weight: 600; min-width: 96px; }
    .fr-input { padding: 9px 12px; border-radius: 7px; border: 1px solid var(--border-color); background: var(--hover-bg); color: var(--text-color); font-size: 0.92rem; }
    .fr-input:focus { outline: none; border-color: #0891b2; }
    .fr-num { width: 110px; }
    .fr-name { flex: 1; min-width: 180px; }
    .fr-presets { display: flex; gap: 7px; flex-wrap: wrap; }
    .fr-preset { padding: 6px 12px; border-radius: 20px; border: 1px solid var(--border-color); background: var(--card-bg); color: var(--text-color); font-size: 0.83rem; cursor: pointer; }
    .fr-preset:hover { border-color: #0891b2; color: #0891b2; font-weight: 600; }
    .fr-radios { display: flex; gap: 16px; flex-wrap: wrap; }
    .fr-radio { display: flex; align-items: center; gap: 7px; font-size: 0.9rem; cursor: pointer; }

    .fr-btn { padding: 11px 20px; border-radius: 8px; border: 1px solid #0891b2; background: #0891b2; color: #fff; font-weight: 600; font-size: 0.93rem; cursor: pointer; }
    .fr-btn:hover { background: #0e7490; }
    .fr-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .fr-status { font-size: 0.87rem; color: #6b7280; margin: 12px 0 0 0; line-height: 1.6; }
    body.dark-mode .fr-status { color: #9ca3af; }

    .fr-info { margin-top: 46px; padding-top: 30px; border-top: 1px solid var(--border-color); }
    .fr-info h2 { font-size: 1.2rem; margin: 26px 0 10px 0; }
    .fr-info h2:first-child { margin-top: 0; }
    .fr-info p { font-size: 0.95rem; line-height: 1.65; color: #4b5563; margin: 0 0 14px 0; }
    body.dark-mode .fr-info p { color: #9ca3af; }
    .fr-info code { background: var(--hover-bg); padding: 2px 6px; border-radius: 4px; font-size: 0.88em; }
    .fr-info a { color: #0e7490; font-weight: 600; }
    body.dark-mode .fr-info a { color: #38bdf8; }

    @media (max-width: 640px) {
      .fr-wrapper { padding: 20px 15px; }
      .fr-header h1 { font-size: 1.5rem; }
      .fr-label { min-width: 0; flex-basis: 100%; }
    }
  </style>

  <div class="fr-wrapper">
    <div class="fr-header">
      <h1>🎲 Random file generator</h1>
      <p>Make a dummy file of an exact size for testing an upload limit, filling a disk, or checking how something behaves with a file it cannot read.</p>
    </div>

    <div class="fr-panel">
      <div class="fr-row">
        <span class="fr-label">Size</span>
        <input type="number" id="frSize" class="fr-input fr-num" min="1" value="10" />
        <select id="frUnit" class="fr-input">
          <option value="B">B</option>
          <option value="KB">KB</option>
          <option value="MB" selected>MB</option>
          <option value="GB">GB</option>
        </select>
        <div class="fr-presets" id="frPresets">
          <button type="button" class="fr-preset" data-mb="1">1 MB</button>
          <button type="button" class="fr-preset" data-mb="25">25 MB</button>
          <button type="button" class="fr-preset" data-mb="100">100 MB</button>
          <button type="button" class="fr-preset" data-mb="1024">1 GB</button>
        </div>
      </div>

      <div class="fr-row">
        <span class="fr-label">Filename</span>
        <input type="text" id="frName" class="fr-input fr-name" value="test-file.bin" />
      </div>

      <div class="fr-row">
        <span class="fr-label">Contents</span>
        <div class="fr-radios">
          <label class="fr-radio"><input type="radio" name="frFill" value="random" checked /> Random bytes</label>
          <label class="fr-radio"><input type="radio" name="frFill" value="zero" /> All zeros (much faster)</label>
        </div>
      </div>

      <button type="button" id="frGo" class="fr-btn">Generate and download</button>
      <p class="fr-status" id="frStatus"></p>
    </div>

    <div class="fr-info">
      <h2>Random bytes or zeros — the difference matters</h2>
      <p>A file of zeros compresses to almost nothing. If you are testing an upload limit and something in the chain compresses the file on the way — a proxy, a CDN, a backup system — a 100 MB file of zeros can arrive as a few kilobytes and your test proves nothing. Random bytes do not compress, so the size you asked for is the size that travels.</p>
      <p>Zeros are the right choice when you only need to occupy space on a disk, and they are generated far faster because nothing has to be computed.</p>

      <h2>What people use this for</h2>
      <p>Finding out where an upload form actually breaks, which is often not where the documentation says. Checking that a backup job handles a file larger than its buffer. Filling a volume to see how an application behaves when the disk is full. Confirming that an antivirus or a scanner does not choke on a file type it cannot parse.</p>
      <p>The last one is worth a note. Testing how your own software handles a file it cannot read is a good reason to generate one. Producing a broken file to pass off as real work is not something this site helps with, which is why there is a generator here and no "corrupt an existing file" tool.</p>

      <h2>The file extension is only a label</h2>
      <p>Naming the file <code>.jpg</code> or <code>.pdf</code> does not make it one — the contents are random either way. That is often exactly what you want, because it tests whether a system checks the file itself or trusts the name. Many check only the name.</p>

      <h2>Size limits</h2>
      <p>The file is built in your browser's memory before it is saved, so the practical ceiling is what your machine can spare — usually a couple of gigabytes before things slow down. Above that, your operating system is the better tool: <code>fsutil file createnew test.bin 5000000000</code> on Windows, or <code>mkfile 5g test.bin</code> on macOS.</p>
      <p>If you need a real file broken into pieces rather than a fake one, see <a href="/tools/split-file">split a file</a>.</p>
    </div>
  </div>

  <script>
    import { formatBytes, toBytes, saveBlob } from '../../lib/file-utils';

    document.addEventListener('DOMContentLoaded', () => {
      const sizeInput = document.getElementById('frSize') as HTMLInputElement;
      const unitInput = document.getElementById('frUnit') as HTMLSelectElement;
      const nameInput = document.getElementById('frName') as HTMLInputElement;
      const goBtn = document.getElementById('frGo') as HTMLButtonElement;
      const status = document.getElementById('frStatus')!;

      document.getElementById('frPresets')!.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.fr-preset') as HTMLElement | null;
        if (!btn) return;
        const mb = parseInt(btn.dataset.mb!, 10);
        if (mb >= 1024) { sizeInput.value = String(mb / 1024); unitInput.value = 'GB'; }
        else { sizeInput.value = String(mb); unitInput.value = 'MB'; }
      });

      goBtn.addEventListener('click', async () => {
        const bytes = toBytes(sizeInput.value, unitInput.value as 'B' | 'KB' | 'MB' | 'GB');
        if (bytes <= 0) { status.textContent = 'Enter a size larger than zero.'; return; }

        const fill = (document.querySelector('input[name="frFill"]:checked') as HTMLInputElement).value;
        goBtn.disabled = true;
        status.textContent = `Building ${formatBytes(bytes)}…`;

        try {
          const chunks: Uint8Array[] = [];
          // 1 MB ad gangen. crypto.getRandomValues afviser buffere over 65536
          // bytes, så den fyldes i småbidder inde i hver blok.
          const CHUNK = 1024 * 1024;
          const MAX_RANDOM = 65536;

          for (let done = 0; done < bytes; done += CHUNK) {
            const size = Math.min(CHUNK, bytes - done);
            const buf = new Uint8Array(size);
            if (fill === 'random') {
              for (let o = 0; o < size; o += MAX_RANDOM) {
                crypto.getRandomValues(buf.subarray(o, Math.min(o + MAX_RANDOM, size)));
              }
            }
            chunks.push(buf);
            // Giver browseren luft, så fanen ikke fryser på store filer
            if (done % (CHUNK * 32) === 0) {
              status.textContent = `Building… ${formatBytes(done)} of ${formatBytes(bytes)}`;
              await new Promise((r) => setTimeout(r, 0));
            }
          }

          const blob = new Blob(chunks, { type: 'application/octet-stream' });
          saveBlob(blob, nameInput.value.trim() || 'test-file.bin');
          status.textContent = `Done — ${formatBytes(blob.size)} saved as ${nameInput.value.trim() || 'test-file.bin'}.`;
        } catch (err) {
          status.textContent = 'Your browser ran out of memory for a file that size. Try something smaller, or use fsutil (Windows) or mkfile (macOS).';
        } finally {
          goBtn.disabled = false;
        }
      });
    });
  </script>
</MainLayout>
