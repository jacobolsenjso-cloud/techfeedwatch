---
import MainLayout from '../../layouts/MainLayout.astro';
import SeoToolStyles from '../../components/SeoToolStyles.astro';

const title = "Search Console Quick Wins Finder";
const description = "Upload your Google Search Console export and find the searches ranking 4-20, with the extra clicks each could bring at your own top-3 click rate. Free.";
---

<MainLayout title={title} description={description}>
  <SeoToolStyles />
  <div class="st-wrapper">
    <div class="st-header">
      <h1>⚡ Search Console Quick Wins</h1>
      <p>Upload the export from Google Search Console and see which searches are close to the top - and how many extra clicks moving each one up would be worth. The estimate uses your own site's click rate, not an industry average. Your file never leaves your browser.</p>
    </div>

    <div class="st-card">
      <h3>1. Export from Search Console</h3>
      <p class="st-muted" style="margin:0 0 10px">Performance → Search results → pick a date range (3 months works well) → Export → Download CSV. Upload the ZIP as it is, or just Queries.csv. Danish and English exports both work.</p>
      <div class="st-actions" style="margin:0"><input type="file" id="qwFile" accept=".zip,.csv" class="st-file" /><button type="button" class="st-btn" id="qwSample">Try with sample data</button></div>
    </div>

    <div class="st-grid3">
      <div class="st-field"><label for="qwMin">Position from</label><input id="qwMin" type="number" class="st-input" value="4" min="1" step="1" /></div>
      <div class="st-field"><label for="qwMax">Position to</label><input id="qwMax" type="number" class="st-input" value="20" min="1" step="1" /></div>
      <div class="st-field"><label for="qwImp">Min. impressions</label><input id="qwImp" type="number" class="st-input" value="20" min="0" step="1" /></div>
    </div>
    <div class="st-field" style="max-width:280px"><label for="qwCtr">Target click rate (%) - leave empty to use your own</label><input id="qwCtr" type="number" class="st-input" placeholder="auto" min="0" max="100" step="0.1" /></div>

    <div id="qwOut"></div>

    <div class="st-info-section">
      <h2>Why positions 4 to 20</h2>
      <p>Most clicks go to the first three results. A page that already ranks fourth to tenth has proven to Google that it is relevant; moving it up a few places is usually far easier than ranking a new page from nothing. Positions 11-20 are page two - fewer people see them, but a page that sits there for a valuable search is often one solid update away from page one.</p>
      <h2>How the extra clicks are estimated</h2>
      <p>For every search in the range, the tool takes its impressions and asks: if this got the same click rate as your top-3 searches, how many more clicks would that be? Your top-3 click rate is measured from your own file (searches in positions 1-3 with at least 20 impressions, if there are at least five). If your site has too few, it falls back to 15% - an assumption you can and should replace with your own figure.</p>
      <h2>The second list: top 3 but hardly clicked</h2>
      <p>Searches where you already rank in the top three but get less than half your usual click rate are the quickest wins of all. The ranking is there; the title or description is not convincing people. Rewrite the title so it answers the search directly, and check that a featured snippet or AI answer is not taking the click.</p>
      <h2>Limits</h2>
      <p>Search Console's position is an average across all the times you appeared, and the export only includes searches Google is willing to show (very rare ones are hidden for privacy). Treat the extra-click figures as a way to rank where to start, not a promise.</p>
    </div>
  </div>

  <script>
    import { laesFil, parseCsv, tolkGsc } from '../../lib/gsc-csv.mjs';
    import { quickWins } from '../../lib/gsc-analyse.mjs';
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' } as Record<string, string>)[c]);
    const tal = (n: number) => Math.round(n).toLocaleString('en-US');
    let data: any[] = [];

    const tabel = (rows: any[], titel: string) => `<h3 style="margin:22px 0 8px">${titel}</h3><div class="st-table-wrap"><table class="st-table"><thead><tr><th>Search</th><th class="st-num">Position</th><th class="st-num">Impressions</th><th class="st-num">Clicks</th><th class="st-num">CTR</th><th class="st-num">+ clicks</th></tr></thead><tbody>${
      rows.slice(0, 100).map((d) => `<tr><td>${esc(d.noegle)}</td><td class="st-num">${d.placering.toFixed(1)}</td><td class="st-num">${tal(d.visninger)}</td><td class="st-num">${tal(d.klik)}</td><td class="st-num">${(d.ctr * 100).toFixed(1)}%</td><td class="st-num"><b>+${tal(d.ekstra)}</b></td></tr>`).join('')
    }</tbody></table></div>${rows.length > 100 ? `<p class="st-hint">Showing the top 100 of ${rows.length}. Download the CSV for all.</p>` : ''}`;

    const run = () => {
      if (!data.length) return;
      const ctrInput = ($('qwCtr') as HTMLInputElement).value;
      const r = quickWins(data, {
        minPos: Number(($('qwMin') as HTMLInputElement).value) || 4, maxPos: Number(($('qwMax') as HTMLInputElement).value) || 20,
        minVisninger: Number(($('qwImp') as HTMLInputElement).value) || 0, maalCtr: ctrInput ? Number(ctrInput) / 100 : null,
      });
      const kilde = r.kilde === 'own' ? `your own top-3 click rate (from ${r.antalTop3} searches)` : r.kilde === 'manual' ? 'the target you entered' : 'an assumed 15% - your file has fewer than 5 top-3 searches';
      let html = `<div class="st-stats"><div class="st-stat"><b>${tal(data.length)}</b><span>searches in file</span></div><div class="st-stat"><b>${r.kandidater.length}</b><span>quick-win candidates</span></div><div class="st-stat"><b>+${tal(r.totalEkstra)}</b><span>possible extra clicks</span></div><div class="st-stat"><b>${(r.maal * 100).toFixed(1)}%</b><span>target click rate</span></div></div>`;
      html += `<div class="st-msg st-ok">Extra clicks are estimated with ${kilde}, over the same period as your export.</div>`;
      html += r.kandidater.length ? tabel(r.kandidater, 'Close to the top - start with these') : '<div class="st-msg st-warn">No searches match the filters. Lower the minimum impressions or widen the positions.</div>';
      if (r.lavCtr.length) html += tabel(r.lavCtr, 'Already top 3, but few clicks - rewrite the title');
      html += `<div class="st-actions" style="margin-top:14px"><button type="button" class="st-btn st-btn-primary" id="qwCsv">Download results as CSV</button></div>`;
      $('qwOut').innerHTML = html;
      ($('qwCsv') as HTMLButtonElement).onclick = () => {
        const linjer = [['search', 'position', 'impressions', 'clicks', 'ctr', 'extra_clicks', 'list'], ...r.kandidater.map((d: any) => [d.noegle, d.placering, d.visninger, d.klik, d.ctr, d.ekstra, 'close to top']), ...r.lavCtr.map((d: any) => [d.noegle, d.placering, d.visninger, d.klik, d.ctr, d.ekstra, 'low ctr in top 3'])];
        const csv = linjer.map((l) => l.map((v) => `"${String(v).replace(/"/g, '""')}"`).join(',')).join('\n');
        const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' })); a.download = 'quick-wins.csv'; a.click();
      };
    };

    ($('qwFile') as HTMLInputElement).addEventListener('change', async (e) => {
      const fil = (e.target as HTMLInputElement).files?.[0]; if (!fil) return;
      try {
        const r = await laesFil(fil, 'queries');
        if (r.fejl) { $('qwOut').innerHTML = `<div class="st-msg st-err">${esc(r.fejl)}</div>`; data = []; return; }
        data = r.data; run();
      } catch (err: any) { $('qwOut').innerHTML = `<div class="st-msg st-err">Could not read the file: ${esc(err.message)}</div>`; }
    });
    $('qwSample').addEventListener('click', () => {
      const csv = `Top queries,Clicks,Impressions,CTR,Position
what is open banking,14,2210,0.63%,6.8
how does a vpn work,9,1480,0.61%,8.9
what is quantum computing,96,512,18.75%,2.1
is chatgpt free,3,1890,0.16%,11.4
what are stablecoins,71,388,18.3%,2.6
how long does it take to learn python,6,940,0.64%,7.3
what is a neobank,58,301,19.27%,1.9
difference between ai and machine learning,4,720,0.56%,9.6
what is zero trust security,49,277,17.69%,2.4
how much does a gaming pc cost,2,1320,0.15%,14.8
what is defi,1,860,0.12%,2.8
what happens when you get hacked,44,240,18.33%,2.7`;
      data = tolkGsc(parseCsv(csv)).data; run();
    });
    ['qwMin', 'qwMax', 'qwImp', 'qwCtr'].forEach((id) => $(id).addEventListener('input', run));
  </script>
</MainLayout>
