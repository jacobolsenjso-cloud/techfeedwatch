---
import MainLayout from '../../layouts/MainLayout.astro';

const title = "JSON Formatter & Validator";
const description = "Format, minify, and validate JSON online. Paste your JSON and instantly get pretty-printed output, a minified version, or a clear error message if it's invalid.";
---

<MainLayout title={title} description={description}>
  <style is:global>
    .jf-wrapper { max-width: 900px; margin: 0 auto; padding: 40px 20px; flex: 1; width: 100%; box-sizing: border-box; }
    .jf-header h1 { margin: 0 0 8px 0; font-size: 2rem; }
    .jf-header p { color: #6b7280; margin: 0 0 30px 0; font-size: 1.05rem; }
    body.dark-mode .jf-header p { color: #9ca3af; }

    .jf-field { margin-bottom: 16px; }
    .jf-field label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 6px; }
    .jf-textarea { width: 100%; min-height: 220px; padding: 12px 14px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--card-bg); color: var(--text-color); font-size: 0.9rem; font-family: 'Courier New', Consolas, monospace; box-sizing: border-box; resize: vertical; line-height: 1.5; }
    .jf-textarea:focus { outline: none; border-color: var(--teal-text); }

    .jf-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; }
    .jf-btn { padding: 12px 20px; border-radius: 8px; border: none; background: #0891b2; color: #fff; font-size: 1rem; font-weight: 600; cursor: pointer; transition: background 0.2s; }
    .jf-btn:hover { background: #0e7490; }
    .jf-btn-secondary { background: var(--hover-bg); color: var(--text-color); border: 1px solid var(--border-color); }
    .jf-btn-secondary:hover { background: #e5e7eb; border-color: #9ca3af; }
    body.dark-mode .jf-btn-secondary:hover { background: #334155; }

    .jf-status { display: none; margin-bottom: 16px; padding: 10px 16px; border-radius: 8px; font-size: 0.9rem; font-weight: 600; }
    .jf-status-valid { background: #f0fdf4; border: 1px solid #bbf7d0; color: #16a34a; }
    body.dark-mode .jf-status-valid { background: #14291d; border-color: #14532d; color: #4ade80; }
    .jf-status-error { background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; }
    body.dark-mode .jf-status-error { background: #3f1d1d; border-color: #7f1d1d; color: #fca5a5; }

    .jf-stats { display: none; flex-wrap: wrap; gap: 16px; margin-bottom: 16px; font-size: 0.85rem; color: #6b7280; }
    body.dark-mode .jf-stats { color: #9ca3af; }
    .jf-stats span strong { color: var(--text-color); }

    .jf-code-wrapper { margin-top: 4px; border: 1px solid var(--border-color); border-radius: 8px; overflow: hidden; display: none; }
    .jf-code-header { display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; background: #1e293b; color: #d1d5db; font-size: 0.85rem; font-weight: 600; }
    .jf-copy-btn { padding: 4px 10px; border-radius: 6px; border: 1px solid #334155; background: #0f172a; color: #d1d5db; cursor: pointer; font-size: 0.8rem; }
    .jf-copy-btn:hover { border-color: var(--teal-text); }
    .jf-code { margin: 0; padding: 14px; overflow-x: auto; background: #0f172a; font-size: 0.85rem; max-height: 420px; }
    .jf-code code { color: #e2e8f0; white-space: pre; }

    .jf-info-section { margin-top: 50px; padding-top: 30px; border-top: 1px solid var(--border-color); }
    .jf-info-section h2 { font-size: 1.3rem; margin: 0 0 10px 0; }
    .jf-info-section p { font-size: 0.95rem; line-height: 1.6; color: #4b5563; margin: 0 0 15px 0; }
    body.dark-mode .jf-info-section p { color: #9ca3af; }

    @media (max-width: 768px) {
      .jf-wrapper { padding: 20px 15px; }
      .jf-btn { flex: 1; text-align: center; }
    }
  </style>

  <div class="jf-wrapper">
    <div class="jf-header">
      <h1>🧾 JSON Formatter & Validator</h1>
      <p>Paste your JSON below to instantly format it, minify it, or validate it. Everything runs locally in your browser - nothing is sent anywhere.</p>
    </div>

    <div class="jf-field">
      <label for="jfInput">JSON input</label>
      <textarea id="jfInput" class="jf-textarea" placeholder='{"example": "Paste your JSON here"}'></textarea>
    </div>

    <div class="jf-actions">
      <button type="button" id="jfFormatBtn" class="jf-btn">Format</button>
      <button type="button" id="jfMinifyBtn" class="jf-btn jf-btn-secondary">Minify</button>
      <button type="button" id="jfClearBtn" class="jf-btn jf-btn-secondary">Clear</button>
    </div>

    <div class="jf-status" id="jfStatus"></div>

    <div class="jf-stats" id="jfStats">
      <span>Lines: <strong id="jfStatLines">0</strong></span>
      <span>Characters: <strong id="jfStatChars">0</strong></span>
      <span>Keys: <strong id="jfStatKeys">0</strong></span>
    </div>

    <div class="jf-code-wrapper" id="jfCodeWrapper">
      <div class="jf-code-header">
        <span>Output</span>
        <button type="button" id="jfCopyBtn" class="jf-copy-btn">Copy</button>
      </div>
      <pre class="jf-code"><code id="jfCodeOutput"></code></pre>
    </div>

    <div class="jf-info-section">
      <h2>What is this tool for?</h2>
      <p>Paste any JSON payload - from an API response, a config file, or logs - and instantly pretty-print it with readable 2-space indentation, or minify it down to a single compact line. Invalid JSON is caught immediately with a clear error message describing exactly what's wrong, so you can fix malformed data without guessing.</p>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('jfInput') as HTMLTextAreaElement;
      const formatBtn = document.getElementById('jfFormatBtn') as HTMLButtonElement;
      const minifyBtn = document.getElementById('jfMinifyBtn') as HTMLButtonElement;
      const clearBtn = document.getElementById('jfClearBtn') as HTMLButtonElement;

      const statusBox = document.getElementById('jfStatus') as HTMLDivElement;
      const stats = document.getElementById('jfStats') as HTMLDivElement;
      const statLines = document.getElementById('jfStatLines') as HTMLElement;
      const statChars = document.getElementById('jfStatChars') as HTMLElement;
      const statKeys = document.getElementById('jfStatKeys') as HTMLElement;

      const codeWrapper = document.getElementById('jfCodeWrapper') as HTMLDivElement;
      const codeOutput = document.getElementById('jfCodeOutput') as HTMLElement;
      const copyBtn = document.getElementById('jfCopyBtn') as HTMLButtonElement;

      const countKeys = (value: any): number => {
        if (Array.isArray(value)) {
          return value.reduce((sum, item) => sum + countKeys(item), 0);
        }
        if (value !== null && typeof value === 'object') {
          return Object.keys(value).reduce((sum, key) => sum + 1 + countKeys(value[key]), 0);
        }
        return 0;
      };

      const showError = (message: string) => {
        statusBox.textContent = `Invalid JSON: ${message}`;
        statusBox.className = 'jf-status jf-status-error';
        statusBox.style.display = 'block';
        stats.style.display = 'none';
        codeWrapper.style.display = 'none';
      };

      const showValid = (parsed: any, output: string) => {
        statusBox.textContent = '✓ Valid JSON';
        statusBox.className = 'jf-status jf-status-valid';
        statusBox.style.display = 'block';

        statLines.textContent = String(output.split('\n').length);
        statChars.textContent = String(input.value.length);
        statKeys.textContent = String(countKeys(parsed));
        stats.style.display = 'flex';

        codeOutput.textContent = output;
        codeWrapper.style.display = 'block';
      };

      const process = (mode: 'format' | 'minify') => {
        const raw = input.value.trim();

        if (!raw) {
          showError('Please paste some JSON first.');
          return;
        }

        try {
          const parsed = JSON.parse(raw);
          const output = mode === 'format' ? JSON.stringify(parsed, null, 2) : JSON.stringify(parsed);
          showValid(parsed, output);
        } catch (e) {
          showError(e instanceof Error ? e.message : 'Unknown parsing error.');
        }
      };

      formatBtn.addEventListener('click', () => process('format'));
      minifyBtn.addEventListener('click', () => process('minify'));

      clearBtn.addEventListener('click', () => {
        input.value = '';
        statusBox.style.display = 'none';
        stats.style.display = 'none';
        codeWrapper.style.display = 'none';
        codeOutput.textContent = '';
      });

      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(codeOutput.textContent || '');
          const original = copyBtn.textContent;
          copyBtn.textContent = 'Copied!';
          setTimeout(() => { copyBtn.textContent = original; }, 2000);
        } catch (e) {}
      });
    });
  </script>
</MainLayout>
