---
import MainLayout from '../../layouts/MainLayout.astro';
import { TOOLS, TOOL_CATEGORIES, toolsInCategory } from '../../lib/tools';

// Værktøjer og kategorier vedligeholdes ét sted: src/lib/tools.ts.
// Nyt værktøj skrives kun ind dér — så dukker det op her, på kategorisiden
// og i sitemap'et af sig selv.

const title = 'Free Tools';
const description = `${TOOLS.length} free browser-based tools for SEO, content, development, media, and finance. No sign-up, no upload — everything runs on your own device.`;

const sections = TOOL_CATEGORIES.map((category) => ({
  category,
  tools: toolsInCategory(category.id),
}));

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Free Tools',
  description,
  numberOfItems: TOOLS.length,
  itemListElement: TOOLS.map((tool, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: tool.title,
    url: `https://techfeedwatch.com/tools/${tool.slug}`,
  })),
};
---

<MainLayout title={title} description={description} schema={listSchema}>
  <style is:global>
    .tools-wrapper { max-width: 1000px; margin: 0 auto; padding: 40px 20px; flex: 1; width: 100%; box-sizing: border-box; }

    .tools-header { margin-bottom: 28px; }
    .tools-header h1 { margin: 0 0 10px 0; font-size: 2rem; }
    .tools-header p { color: #6b7280; font-size: 1.05rem; margin: 0; max-width: 68ch; line-height: 1.6; }
    body.dark-mode .tools-header p { color: #9ca3af; }

    .tools-jump { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 44px; }
    .tools-jump a { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; color: inherit; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 999px; padding: 9px 16px; font-size: 0.92rem; font-weight: 600; min-height: 44px; box-sizing: border-box; transition: border-color 0.2s ease, background 0.2s ease; }
    .tools-jump a:hover { border-color: var(--teal-text); background: var(--hover-bg); }
    .tools-jump-count { color: #6b7280; font-weight: 500; }
    body.dark-mode .tools-jump-count { color: #9ca3af; }

    .tools-section { margin-bottom: 52px; scroll-margin-top: 80px; }
    .tools-section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 16px; }
    .tools-section-head h2 { font-size: 1.4rem; margin: 0; }
    .tools-section-all { font-size: 0.92rem; font-weight: 600; color: var(--teal-text); text-decoration: none; white-space: nowrap; display: inline-flex; align-items: center; min-height: 44px; padding: 4px 2px; }
    .tools-section-all:hover { text-decoration: underline; }

    .tools-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }
    .tool-card { display: block; text-decoration: none; color: inherit; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease; }
    .tool-card:hover { transform: translateY(-3px); box-shadow: 0 6px 24px rgba(0,0,0,0.06), 0 2px 8px rgba(0,0,0,0.04); border-color: var(--teal-text); }
    .tool-card-icon { font-size: 2rem; margin-bottom: 12px; display: block; }
    .tool-card-title { font-size: 1.15rem; font-weight: 700; margin: 0 0 8px 0; }
    .tool-card-desc { font-size: 0.95rem; color: #6b7280; margin: 0; line-height: 1.5; }
    body.dark-mode .tool-card-desc { color: #9ca3af; }

    @media (max-width: 768px) {
      .tools-wrapper { padding: 20px 15px; }
      .tools-grid { grid-template-columns: 1fr; }
      .tools-header h1 { font-size: 1.6rem; }
      .tools-jump { margin-bottom: 32px; }
    }
  </style>

  <div class="tools-wrapper">
    <div class="tools-header">
      <h1>🛠️ {TOOLS.length} Free Tools</h1>
      <p>Small, focused tools for SEO, writing, code, media, and money. Everything runs in your browser — nothing is uploaded, and there is no sign-up.</p>
    </div>

    <nav class="tools-jump" aria-label="Tool categories">
      {sections.map(({ category, tools }) => (
        <a href={`/tools/${category.slug}`}>
          <span aria-hidden="true">{category.icon}</span>
          <span>{category.name}</span>
          <span class="tools-jump-count">{tools.length}</span>
        </a>
      ))}
    </nav>

    {sections.map(({ category, tools }) => (
      <section class="tools-section" id={category.slug}>
        <div class="tools-section-head">
          <h2>{category.icon} {category.name}</h2>
          <a class="tools-section-all" href={`/tools/${category.slug}`}>All {tools.length} {category.name} tools →</a>
        </div>
        <div class="tools-grid">
          {tools.map((tool) => (
            <a href={`/tools/${tool.slug}`} class="tool-card">
              <span class="tool-card-icon">{tool.icon}</span>
              <h3 class="tool-card-title">{tool.title}</h3>
              <p class="tool-card-desc">{tool.description}</p>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</MainLayout>
