---
import MainLayout from '../../layouts/MainLayout.astro';

const title = "Password Generator & Strength Checker";
const description = "Generate cryptographically secure random passwords and check the strength of an existing password. Everything runs locally in your browser.";
---

<MainLayout title={title} description={description}>
  <style is:global>
    .pwg-wrapper { max-width: 800px; margin: 0 auto; padding: 40px 20px; flex: 1; width: 100%; box-sizing: border-box; }
    .pwg-header h1 { margin: 0 0 8px 0; font-size: 2rem; }
    .pwg-header p { color: #6b7280; margin: 0 0 30px 0; font-size: 1.05rem; }
    body.dark-mode .pwg-header p { color: #9ca3af; }

    .pwg-section { margin-bottom: 45px; }
    .pwg-section h2 { font-size: 1.25rem; margin: 0 0 18px 0; }

    .pwg-field { margin-bottom: 18px; }
    .pwg-field label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 6px; }

    .pwg-slider-row { display: flex; align-items: center; gap: 14px; }
    .pwg-slider-row input[type="range"] { flex: 1; accent-color: var(--teal-text); }
    .pwg-slider-value { font-weight: 700; font-size: 1rem; min-width: 34px; text-align: right; }

    .pwg-checkboxes { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; }
    .pwg-checkbox-label { display: flex; align-items: center; gap: 8px; font-size: 0.9rem; font-weight: 500; cursor: pointer; }
    .pwg-checkbox-label input { accent-color: var(--teal-text); width: 16px; height: 16px; cursor: pointer; }

    .pwg-btn { padding: 12px 20px; border-radius: 8px; border: none; background: #0891b2; color: #fff; font-size: 1rem; font-weight: 600; cursor: pointer; transition: background 0.2s; }
    .pwg-btn:hover { background: #0e7490; }

    .pwg-status { display: none; margin-top: 14px; padding: 10px 16px; border-radius: 8px; font-size: 0.9rem; font-weight: 600; background: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; }
    body.dark-mode .pwg-status { background: #3f1d1d; border-color: #7f1d1d; color: #fca5a5; }

    .pwg-output-row { display: none; margin-top: 18px; align-items: center; gap: 10px; }
    .pwg-output { flex: 1; padding: 12px 14px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--card-bg); color: var(--text-color); font-size: 1.05rem; font-family: 'Courier New', Consolas, monospace; word-break: break-all; }
    .pwg-copy-btn { padding: 12px 16px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--hover-bg); color: var(--text-color); cursor: pointer; font-size: 0.9rem; font-weight: 600; white-space: nowrap; }
    .pwg-copy-btn:hover { border-color: var(--teal-text); }

    .pwg-meter-wrap { display: none; margin-top: 16px; }
    .pwg-meter { display: flex; gap: 4px; margin-bottom: 8px; }
    .pwg-meter-segment { height: 6px; flex: 1; border-radius: 3px; background: var(--border-color); transition: background 0.2s; }
    .pwg-meter-segment.on-weak { background: #0891b2; }
    .pwg-meter-segment.on-medium { background: #f59e0b; }
    .pwg-meter-segment.on-strong { background: #16a34a; }
    .pwg-strength-label { font-weight: 700; font-size: 0.9rem; }
    .pwg-strength-label.weak { color: var(--teal-text); }
    .pwg-strength-label.medium { color: #f59e0b; }
    .pwg-strength-label.strong { color: #16a34a; }

    .pwg-checker-input { width: 100%; padding: 12px 14px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--card-bg); color: var(--text-color); font-size: 1.05rem; font-family: 'Courier New', Consolas, monospace; box-sizing: border-box; }
    .pwg-checker-input:focus { outline: none; border-color: var(--teal-text); }

    .pwg-tips { margin: 10px 0 0 0; padding-left: 20px; }
    .pwg-tips li { font-size: 0.88rem; line-height: 1.6; color: #4b5563; }
    body.dark-mode .pwg-tips li { color: #9ca3af; }

    .pwg-note { font-size: 0.85rem; color: #6b7280; margin: 30px 0 0 0; padding-top: 20px; border-top: 1px solid var(--border-color); }
    body.dark-mode .pwg-note { color: #9ca3af; }

    .pwg-guide { margin-top: 50px; padding-top: 30px; border-top: 1px solid var(--border-color); }
    .pwg-guide h2 { font-size: 1.3rem; margin: 26px 0 10px 0; }
    .pwg-guide h2:first-child { margin-top: 0; }
    .pwg-guide p { font-size: 0.95rem; line-height: 1.65; color: #4b5563; margin: 0 0 14px 0; }
    body.dark-mode .pwg-guide p { color: #9ca3af; }
    @media (max-width: 768px) {
      .pwg-wrapper { padding: 20px 15px; }
      .pwg-output-row { flex-direction: column; align-items: stretch; }
    }
  </style>

  <div class="pwg-wrapper">
    <div class="pwg-header">
      <h1>🔐 Password Generator & Strength Checker</h1>
      <p>Generate strong, random passwords or check how strong an existing one is - all processed locally in your browser.</p>
    </div>

    <div class="pwg-section">
      <h2>Generate a password</h2>

      <div class="pwg-field">
        <label for="pwgLength">Length: <span id="pwgLengthValue">16</span> characters</label>
        <div class="pwg-slider-row">
          <input type="range" id="pwgLength" min="8" max="64" value="16" />
        </div>
      </div>

      <div class="pwg-field">
        <label>Character types</label>
        <div class="pwg-checkboxes">
          <label class="pwg-checkbox-label"><input type="checkbox" id="pwgUpper" checked /> Uppercase (A-Z)</label>
          <label class="pwg-checkbox-label"><input type="checkbox" id="pwgLower" checked /> Lowercase (a-z)</label>
          <label class="pwg-checkbox-label"><input type="checkbox" id="pwgNumbers" checked /> Numbers (0-9)</label>
          <label class="pwg-checkbox-label"><input type="checkbox" id="pwgSymbols" checked /> Symbols (!@#$%...)</label>
        </div>
      </div>

      <button type="button" id="pwgGenerateBtn" class="pwg-btn">Generate Password</button>

      <div class="pwg-status" id="pwgStatus"></div>

      <div class="pwg-output-row" id="pwgOutputRow">
        <input type="text" id="pwgOutput" class="pwg-output" readonly />
        <button type="button" id="pwgCopyBtn" class="pwg-copy-btn">Copy</button>
      </div>

      <div class="pwg-meter-wrap" id="pwgMeterWrap">
        <div class="pwg-meter" id="pwgMeter">
          <div class="pwg-meter-segment"></div>
          <div class="pwg-meter-segment"></div>
          <div class="pwg-meter-segment"></div>
        </div>
        <span class="pwg-strength-label" id="pwgStrengthLabel"></span>
      </div>
    </div>

    <div class="pwg-section">
      <h2>Check an existing password</h2>

      <div class="pwg-field">
        <label for="pwgCheckerInput">Password to check</label>
        <input type="text" id="pwgCheckerInput" class="pwg-checker-input" placeholder="Type or paste a password..." autocomplete="off" />
      </div>

      <div class="pwg-meter-wrap" id="pwgCheckerMeterWrap">
        <div class="pwg-meter" id="pwgCheckerMeter">
          <div class="pwg-meter-segment"></div>
          <div class="pwg-meter-segment"></div>
          <div class="pwg-meter-segment"></div>
        </div>
        <span class="pwg-strength-label" id="pwgCheckerStrengthLabel"></span>
        <ul class="pwg-tips" id="pwgCheckerTips"></ul>
      </div>
    </div>

    <div class="pwg-guide">
      <h2>What this tool does</h2>
      <p>It builds a random password from the character types you tick, at the length you choose, using your browser's cryptographic random-number generator - the same source a password manager uses. Nothing is sent anywhere; you can turn your Wi-Fi off and it still works. The checker below scores a password you already have, using only its length and the mix of character types.</p>
      <h2>When to use it</h2>
      <p>Any time you need a password you will store rather than remember: a router, a database, an API key in a config file, a one-off login for a contractor. Sixteen characters with all four types ticked is a good default; go longer for anything that guards other passwords, like a password manager's master key. If you need a password you can type from memory, this is the wrong tool - a passphrase of four or five unrelated words is easier to carry in your head and still very hard to guess.</p>
      <h2>How to read the strength meter</h2>
      <p>The meter looks at two things: length and how many of the four character types appear. That is the whole rule, and it is deliberately simple. What it does not check: whether the password is a dictionary word, appears in a breach list, or is your name with a year on the end. "Password1!" scores medium here because it is ten characters with four types - and it is still a terrible password, because it is on every attacker's list. The meter measures shape, not originality. Treat "strong" as necessary, not sufficient.</p>
      <h2>Limits</h2>
      <p>The symbol set is a fixed list of common punctuation. Some sites reject certain symbols or cap the length; if a generated password is refused, untick symbols or shorten it rather than editing by hand - hand edits make passwords more predictable, not less. The tool does not store or remember what it generates. If you close the tab before copying, it is gone. That is by design.</p>
    </div>

    <p class="pwg-note">🔒 All generation and checking happens locally in your browser. No password is ever sent, stored, or logged.</p>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const CHARSETS = {
        upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
        lower: 'abcdefghijklmnopqrstuvwxyz',
        numbers: '0123456789',
        symbols: '!@#$%^&*()_+-=[]{}|;:,.<>?',
      };

      // Kryptografisk sikker tilfældighed via window.crypto.getRandomValues, med rejection sampling for at undgå modulo-bias
      const getSecureRandomInt = (max: number): number => {
        const range = 256 - (256 % max);
        let byte: number;
        do {
          byte = window.crypto.getRandomValues(new Uint8Array(1))[0];
        } while (byte >= range);
        return byte % max;
      };

      const analyzeStrength = (password: string) => {
        const length = password.length;
        const hasUpper = /[A-Z]/.test(password);
        const hasLower = /[a-z]/.test(password);
        const hasNumber = /[0-9]/.test(password);
        const hasSymbol = /[^A-Za-z0-9]/.test(password);
        const typesCount = [hasUpper, hasLower, hasNumber, hasSymbol].filter(Boolean).length;

        let score = 0;
        if (length >= 8) score++;
        if (length >= 12) score++;
        if (length >= 16) score++;
        score += typesCount;

        let level: 'weak' | 'medium' | 'strong' = 'weak';
        if (score >= 6) level = 'strong';
        else if (score >= 4) level = 'medium';

        return { length, hasUpper, hasLower, hasNumber, hasSymbol, typesCount, level };
      };

      const renderMeter = (meterEl: HTMLElement, labelEl: HTMLElement, level: 'weak' | 'medium' | 'strong') => {
        const segments = meterEl.querySelectorAll('.pwg-meter-segment');
        const filledCount = level === 'strong' ? 3 : level === 'medium' ? 2 : 1;
        segments.forEach((seg, i) => {
          seg.className = 'pwg-meter-segment' + (i < filledCount ? ` on-${level}` : '');
        });
        labelEl.textContent = level === 'strong' ? 'Strong' : level === 'medium' ? 'Medium' : 'Weak';
        labelEl.className = 'pwg-strength-label ' + level;
      };

      // --- Generator ---
      const lengthSlider = document.getElementById('pwgLength') as HTMLInputElement;
      const lengthValue = document.getElementById('pwgLengthValue') as HTMLElement;
      const upperCheckbox = document.getElementById('pwgUpper') as HTMLInputElement;
      const lowerCheckbox = document.getElementById('pwgLower') as HTMLInputElement;
      const numbersCheckbox = document.getElementById('pwgNumbers') as HTMLInputElement;
      const symbolsCheckbox = document.getElementById('pwgSymbols') as HTMLInputElement;
      const generateBtn = document.getElementById('pwgGenerateBtn') as HTMLButtonElement;
      const status = document.getElementById('pwgStatus') as HTMLDivElement;
      const outputRow = document.getElementById('pwgOutputRow') as HTMLDivElement;
      const output = document.getElementById('pwgOutput') as HTMLInputElement;
      const copyBtn = document.getElementById('pwgCopyBtn') as HTMLButtonElement;
      const meterWrap = document.getElementById('pwgMeterWrap') as HTMLDivElement;
      const meter = document.getElementById('pwgMeter') as HTMLElement;
      const strengthLabel = document.getElementById('pwgStrengthLabel') as HTMLElement;

      lengthSlider.addEventListener('input', () => {
        lengthValue.textContent = lengthSlider.value;
      });

      generateBtn.addEventListener('click', () => {
        let charset = '';
        if (upperCheckbox.checked) charset += CHARSETS.upper;
        if (lowerCheckbox.checked) charset += CHARSETS.lower;
        if (numbersCheckbox.checked) charset += CHARSETS.numbers;
        if (symbolsCheckbox.checked) charset += CHARSETS.symbols;

        if (!charset) {
          status.textContent = 'Please select at least one character type.';
          status.style.display = 'block';
          outputRow.style.display = 'none';
          meterWrap.style.display = 'none';
          return;
        }

        status.style.display = 'none';

        const length = parseInt(lengthSlider.value, 10);
        let password = '';
        for (let i = 0; i < length; i++) {
          password += charset[getSecureRandomInt(charset.length)];
        }

        output.value = password;
        outputRow.style.display = 'flex';

        const { level } = analyzeStrength(password);
        renderMeter(meter, strengthLabel, level);
        meterWrap.style.display = 'block';
      });

      copyBtn.addEventListener('click', async () => {
        if (!output.value) return;
        try {
          await navigator.clipboard.writeText(output.value);
          const original = copyBtn.textContent;
          copyBtn.textContent = 'Copied!';
          setTimeout(() => { copyBtn.textContent = original; }, 2000);
        } catch (e) {}
      });

      // --- Strength checker ---
      const checkerInput = document.getElementById('pwgCheckerInput') as HTMLInputElement;
      const checkerMeterWrap = document.getElementById('pwgCheckerMeterWrap') as HTMLDivElement;
      const checkerMeter = document.getElementById('pwgCheckerMeter') as HTMLElement;
      const checkerStrengthLabel = document.getElementById('pwgCheckerStrengthLabel') as HTMLElement;
      const checkerTips = document.getElementById('pwgCheckerTips') as HTMLElement;

      checkerInput.addEventListener('input', () => {
        const value = checkerInput.value;

        if (!value) {
          checkerMeterWrap.style.display = 'none';
          return;
        }

        const { length, hasUpper, hasLower, hasNumber, hasSymbol, typesCount, level } = analyzeStrength(value);
        renderMeter(checkerMeter, checkerStrengthLabel, level);
        checkerMeterWrap.style.display = 'block';

        const tips: string[] = [];
        if (length < 12) tips.push('Increase length to at least 12 characters.');
        if (!hasUpper) tips.push('Add uppercase letters (A-Z).');
        if (!hasLower) tips.push('Add lowercase letters (a-z).');
        if (!hasNumber) tips.push('Add numbers (0-9).');
        if (!hasSymbol) tips.push('Add special characters (e.g. !@#$%).');
        if (typesCount >= 3 && length >= 12 && tips.length === 0) {
          tips.push('Great! This password looks strong.');
        }

        checkerTips.innerHTML = tips.map(tip => `<li>${tip}</li>`).join('');
      });
    });
  </script>
</MainLayout>
