---
import MainLayout from '../../layouts/MainLayout.astro';

const title = "robots.txt Generator";
const description = "Create a valid robots.txt file in seconds. Choose a preset or add custom Allow/Disallow rules and sitemaps, then copy the result. Free, browser-based, no login.";
---

<MainLayout title={title} description={description}>
  <style is:global>
    .rb-wrapper { max-width: 820px; margin: 0 auto; padding: 40px 20px; flex: 1; width: 100%; box-sizing: border-box; }
    .rb-header h1 { margin: 0 0 8px 0; font-size: 2rem; }
    .rb-header p { color: #6b7280; margin: 0 0 24px 0; font-size: 1.05rem; }
    body.dark-mode .rb-header p { color: #9ca3af; }

    .rb-field { margin-bottom: 16px; }
    .rb-field label { display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 5px; }
    .rb-input, .rb-area, .rb-select { width: 100%; padding: 11px 13px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--card-bg); color: var(--text-color); font-size: 0.95rem; box-sizing: border-box; }
    .rb-area { min-height: 70px; resize: vertical; font-family: 'Courier New', Consolas, monospace; line-height: 1.5; }
    .rb-input:focus, .rb-area:focus, .rb-select:focus { outline: none; border-color: #0891b2; }
    .rb-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .rb-hint { font-size: 0.78rem; color: #6b7280; margin: 4px 0 0; }
    body.dark-mode .rb-hint { color: #9ca3af; }

    .rb-out-head { display: flex; align-items: center; justify-content: space-between; margin: 26px 0 8px; }
    .rb-out-head h2 { font-size: 1.1rem; margin: 0; }
    .rb-copy { padding: 8px 16px; border-radius: 8px; border: none; background: #0891b2; color: #fff; font-weight: 700; cursor: pointer; }
    .rb-copy:hover { background: #0e7490; }
    .rb-output { width: 100%; min-height: 180px; padding: 15px; border-radius: 10px; border: 1px solid var(--border-color); background: var(--hover-bg); color: var(--text-color); font-family: 'Courier New', Consolas, monospace; font-size: 0.9rem; line-height: 1.5; box-sizing: border-box; white-space: pre; overflow: auto; }

    .rb-info-section { margin-top: 46px; padding-top: 30px; border-top: 1px solid var(--border-color); }
    .rb-info-section h2 { font-size: 1.3rem; margin: 0 0 10px 0; }
    .rb-info-section p { font-size: 0.95rem; line-height: 1.6; color: #4b5563; margin: 0 0 15px 0; }
    body.dark-mode .rb-info-section p { color: #9ca3af; }

    @media (max-width: 640px) { .rb-wrapper { padding: 20px 15px; } .rb-grid { grid-template-columns: 1fr; } }
  </style>

  <div class="rb-wrapper">
    <div class="rb-header">
      <h1>🤖 robots.txt Generator</h1>
      <p>Build a valid robots.txt file to control how search engines crawl your site. Pick a preset or add custom rules, then copy the output to your site root.</p>
    </div>

    <div class="rb-field">
      <label for="rbPreset">Preset</label>
      <select id="rbPreset" class="rb-select">
        <option value="allow">Allow all crawlers (recommended)</option>
        <option value="block">Block all crawlers</option>
        <option value="custom">Custom rules</option>
      </select>
    </div>

    <div class="rb-grid">
      <div class="rb-field">
        <label for="rbUa">User-agent</label>
        <input id="rbUa" class="rb-input" value="*" />
        <p class="rb-hint">Use * for all crawlers, or e.g. Googlebot.</p>
      </div>
      <div class="rb-field">
        <label for="rbDelay">Crawl-delay (optional)</label>
        <input id="rbDelay" class="rb-input" type="number" min="0" placeholder="e.g. 10" />
      </div>
    </div>

    <div class="rb-field">
      <label for="rbDisallow">Disallow paths (one per line)</label>
      <textarea id="rbDisallow" class="rb-area" placeholder="/admin/&#10;/cart/&#10;/*?"></textarea>
    </div>

    <div class="rb-field">
      <label for="rbAllow">Allow paths (optional, one per line)</label>
      <textarea id="rbAllow" class="rb-area" placeholder="/public/"></textarea>
    </div>

    <div class="rb-field">
      <label for="rbSitemap">Sitemap URLs (one per line)</label>
      <textarea id="rbSitemap" class="rb-area">https://techfeedwatch.com/sitemap-index.xml</textarea>
    </div>

    <div class="rb-out-head">
      <h2>Generated robots.txt</h2>
      <button type="button" class="rb-copy" id="rbCopy">Copy</button>
    </div>
    <pre class="rb-output" id="rbOut"></pre>

    <div class="rb-info-section">
      <h2>How to use your robots.txt file</h2>
      <p>The robots.txt file tells search engine crawlers which parts of your site they may or may not request. It must live at the root of your domain (for example, https://example.com/robots.txt) to be found. "Allow all" — an empty Disallow — is the right choice for most content sites, because you generally want every useful page crawled and indexed.</p>
      <p>Remember that Disallow only blocks crawling, not indexing: a blocked URL can still appear in search if other pages link to it. To keep a page out of the index, use a <code>noindex</code> meta tag instead. Always include your sitemap URL here so crawlers can discover your pages efficiently, and test changes in Google Search Console before relying on them.</p>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const preset = document.getElementById('rbPreset') as HTMLSelectElement;
      const ua = document.getElementById('rbUa') as HTMLInputElement;
      const delay = document.getElementById('rbDelay') as HTMLInputElement;
      const dis = document.getElementById('rbDisallow') as HTMLTextAreaElement;
      const allow = document.getElementById('rbAllow') as HTMLTextAreaElement;
      const sitemap = document.getElementById('rbSitemap') as HTMLTextAreaElement;
      const out = document.getElementById('rbOut') as HTMLElement;

      const lines = (s: string) => s.split('\n').map((l) => l.trim()).filter(Boolean);

      const gen = () => {
        const p = preset.value;
        const uaVal = ua.value.trim() || '*';
        const block: string[] = [`User-agent: ${uaVal}`];

        if (p === 'allow') {
          block.push('Disallow:');
        } else if (p === 'block') {
          block.push('Disallow: /');
        } else {
          lines(allow.value).forEach((a) => block.push(`Allow: ${a}`));
          const d = lines(dis.value);
          if (d.length) d.forEach((x) => block.push(`Disallow: ${x}`));
          else block.push('Disallow:');
          if (delay.value.trim()) block.push(`Crawl-delay: ${delay.value.trim()}`);
        }

        let output = block.join('\n');
        const sm = lines(sitemap.value);
        if (sm.length) output += '\n\n' + sm.map((u) => `Sitemap: ${u}`).join('\n');
        out.textContent = output + '\n';
      };

      const custom = () => { const on = preset.value === 'custom'; [dis, allow, delay].forEach((el) => (el as HTMLElement).style.opacity = on ? '1' : '0.5'); };

      [preset, ua, delay, dis, allow, sitemap].forEach((el) => el.addEventListener('input', () => { custom(); gen(); }));
      preset.addEventListener('change', () => { custom(); gen(); });

      document.getElementById('rbCopy')!.addEventListener('click', async (e) => {
        try { await navigator.clipboard.writeText(out.textContent || ''); const b = e.currentTarget as HTMLElement; const o = b.textContent; b.textContent = 'Copied!'; setTimeout(() => { b.textContent = o; }, 1500); } catch (err) {}
      });

      custom(); gen();
    });
  </script>
</MainLayout>
