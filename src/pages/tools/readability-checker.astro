---
import MainLayout from '../../layouts/MainLayout.astro';

const title = "Readability Checker (Flesch Reading Ease)";
const description = "Check how easy your writing is to read with the Flesch Reading Ease score and Flesch–Kincaid grade level. Free tool that runs in your browser.";
---

<MainLayout title={title} description={description}>
  <style is:global>
    .rd-wrapper { max-width: 860px; margin: 0 auto; padding: 40px 20px; flex: 1; width: 100%; box-sizing: border-box; }
    .rd-header h1 { margin: 0 0 8px 0; font-size: 2rem; }
    .rd-header p { color: #6b7280; margin: 0 0 24px 0; font-size: 1.05rem; }
    body.dark-mode .rd-header p { color: #9ca3af; }

    .rd-textarea { width: 100%; min-height: 200px; padding: 14px 16px; border-radius: 10px; border: 1px solid var(--border-color); background: var(--card-bg); color: var(--text-color); font-size: 1rem; line-height: 1.6; box-sizing: border-box; resize: vertical; }
    .rd-textarea:focus { outline: none; border-color: var(--teal-text); }

    .rd-score-card { display: flex; align-items: center; gap: 20px; margin: 22px 0; padding: 20px; border: 1px solid var(--border-color); border-radius: 14px; background: var(--card-bg); }
    .rd-score-num { font-size: 3rem; font-weight: 800; line-height: 1; min-width: 90px; text-align: center; }
    .rd-score-meta { flex: 1; }
    .rd-score-label { font-size: 1.15rem; font-weight: 700; margin: 0 0 4px; }
    .rd-score-sub { font-size: 0.9rem; color: #6b7280; margin: 0; }
    body.dark-mode .rd-score-sub { color: #9ca3af; }

    .rd-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 14px; margin-bottom: 10px; }
    .rd-stat { border: 1px solid var(--border-color); border-radius: 10px; padding: 14px; }
    .rd-stat b { font-size: 1.35rem; display: block; }
    .rd-stat span { font-size: 0.78rem; color: #6b7280; }
    body.dark-mode .rd-stat span { color: #9ca3af; }

    .rd-info-section { margin-top: 46px; padding-top: 30px; border-top: 1px solid var(--border-color); }
    .rd-info-section h2 { font-size: 1.3rem; margin: 0 0 10px 0; }
    .rd-info-section p { font-size: 0.95rem; line-height: 1.6; color: #4b5563; margin: 0 0 15px 0; }
    body.dark-mode .rd-info-section p { color: #9ca3af; }

    @media (max-width: 640px) { .rd-wrapper { padding: 20px 15px; } .rd-score-card { flex-direction: column; text-align: center; } }
  </style>

  <div class="rd-wrapper">
    <div class="rd-header">
      <h1>📖 Readability Checker</h1>
      <p>Paste your text to get the Flesch Reading Ease score, the U.S. grade level needed to read it, and the stats behind them. Everything runs in your browser.</p>
    </div>

    <textarea id="rdText" class="rd-textarea" placeholder="Paste your article or copy here..."></textarea>

    <div class="rd-score-card">
      <div class="rd-score-num" id="rdScore" style="color: var(--teal-text)">–</div>
      <div class="rd-score-meta">
        <p class="rd-score-label" id="rdLabel">Waiting for text…</p>
        <p class="rd-score-sub" id="rdSub">Flesch Reading Ease (0–100). Higher is easier to read.</p>
      </div>
    </div>

    <div class="rd-stats">
      <div class="rd-stat"><b id="rdGrade">–</b><span>Grade level</span></div>
      <div class="rd-stat"><b id="rdWords">0</b><span>Words</span></div>
      <div class="rd-stat"><b id="rdSent">0</b><span>Sentences</span></div>
      <div class="rd-stat"><b id="rdWps">0</b><span>Words / sentence</span></div>
      <div class="rd-stat"><b id="rdSpw">0</b><span>Syllables / word</span></div>
    </div>

    <div class="rd-info-section">
      <h2>What is a good readability score?</h2>
      <p>The Flesch Reading Ease score rates text from 0 to 100 based on average sentence length and the number of syllables per word. Higher is easier: 60–70 is plain English that most adults read comfortably, 30–50 is difficult and academic, and above 80 is very easy. For blog posts and online articles, aiming for roughly 60 or above keeps your writing accessible to a broad audience.</p>
      <p>The Flesch–Kincaid grade level translates the same inputs into a U.S. school grade — a grade of 8 means a typical 13–14-year-old could read it. If your score is low, the fastest fixes are shorter sentences and simpler words. Readability is not a ranking factor by itself, but clearer writing keeps readers on the page longer, which helps SEO indirectly.</p>
      <h2>What the formula can and cannot see</h2>
      <p>The score is arithmetic on two averages: words per sentence and syllables per word. That is all Flesch ever measured, and it means the checker can be gamed and can be wrong in both directions. Chop every sentence in half and the score soars while the text turns robotic; write one elegant long sentence and the score drops while the text reads beautifully. The syllable counter is also an approximation - English spelling defeats any simple rule, so individual words are sometimes counted a syllable off. Over a full article the errors average out; over a single sentence they do not.</p>
      <h2>How to actually use the number</h2>
      <p>Treat it as a smoke detector, not a judge. A score of 25 on a blog post is a real signal that sentences have grown tangled. The difference between 62 and 68 is noise. And the final check the formula cannot perform: read the text aloud. Where you stumble, a reader stumbles - no score needed.</p>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const text = document.getElementById('rdText') as HTMLTextAreaElement;

      const syllables = (word: string): number => {
        word = word.toLowerCase().replace(/[^a-z]/g, '');
        if (!word) return 0;
        if (word.length <= 3) return 1;
        word = word.replace(/(?:[^laeiouy]es|ed|[^laeiouy]e)$/, '').replace(/^y/, '');
        const m = word.match(/[aeiouy]{1,2}/g);
        return m ? m.length : 1;
      };

      const setText = (id: string, v: string) => { (document.getElementById(id) as HTMLElement).textContent = v; };

      const analyze = () => {
        const raw = (text.value || '').trim();
        const words = raw.match(/[A-Za-z]+(?:'[A-Za-z]+)?/g) || [];
        const sentences = (raw.match(/[^.!?]+[.!?]+/g) || (raw ? [raw] : []));
        const wordCount = words.length;
        const sentCount = Math.max(sentences.length, raw ? 1 : 0);

        if (wordCount === 0) {
          setText('rdScore', '–'); setText('rdLabel', 'Waiting for text…');
          setText('rdSub', 'Flesch Reading Ease (0–100). Higher is easier to read.');
          ['rdGrade','rdWps','rdSpw'].forEach((i) => setText(i, '–'));
          setText('rdWords', '0'); setText('rdSent', '0');
          return;
        }

        const syllCount = words.reduce((sum, w) => sum + syllables(w), 0);
        const wps = wordCount / sentCount;
        const spw = syllCount / wordCount;
        const ease = 206.835 - 1.015 * wps - 84.6 * spw;
        const grade = 0.39 * wps + 11.8 * spw - 15.59;

        const clamped = Math.max(0, Math.min(100, ease));
        let label = '', color = '#0891b2';
        if (clamped >= 80) { label = 'Very easy to read'; color = '#059669'; }
        else if (clamped >= 70) { label = 'Fairly easy — great for the web'; color = '#059669'; }
        else if (clamped >= 60) { label = 'Plain English — good'; color = '#0891b2'; }
        else if (clamped >= 50) { label = 'Fairly difficult'; color = '#d97706'; }
        else if (clamped >= 30) { label = 'Difficult / academic'; color = '#dc2626'; }
        else { label = 'Very difficult'; color = '#dc2626'; }

        const scoreEl = document.getElementById('rdScore') as HTMLElement;
        scoreEl.textContent = String(Math.round(clamped));
        scoreEl.style.color = color;
        setText('rdLabel', label);
        setText('rdSub', 'Flesch Reading Ease (0–100). Higher is easier to read.');
        setText('rdGrade', grade <= 0 ? '≤1' : String(Math.round(grade)));
        setText('rdWords', String(wordCount));
        setText('rdSent', String(sentCount));
        setText('rdWps', wps.toFixed(1));
        setText('rdSpw', spw.toFixed(2));
      };

      text.addEventListener('input', analyze);
      analyze();
    });
  </script>
</MainLayout>
