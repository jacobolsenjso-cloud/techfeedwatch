      .cinema-list { display: flex; flex-direction: column; gap: 12px; padding-bottom: 20px; }
      .cinema-card { display: flex; gap: 12px; text-decoration: none; color: inherit; align-items: flex-start; }
      .cinema-card-thumb { width: 160px; flex-shrink: 0; aspect-ratio: 16/9; background-color: #000; background-size: cover; background-position: center; border-radius: 8px; position: relative; overflow: hidden; }
      .cinema-card-duration { position: absolute; bottom: 6px; right: 6px; background: rgba(0,0,0,0.8); color: #fff; padding: 2px 5px; border-radius: 4px; font-size: 11px; font-weight: 600; letter-spacing: 0.5px; }
      .cinema-card-title { font-size: 14px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
      .cinema-ad { margin: 4px 0; }
