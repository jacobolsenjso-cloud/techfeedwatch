              var block = document.createElement('aside');
              block.className = 'inline-recs';
              block.innerHTML = '<div class="inline-recs-label">🔎 You might also like</div><div class="inline-recs-grid">' + cards + '</div>';
              if (target) { article.insertBefore(block, target); } else { article.appendChild(block); }
            }
            if (document.readyState !== 'loading') init();
            else document.addEventListener('DOMContentLoaded', init);
