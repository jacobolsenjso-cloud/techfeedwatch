              var esc = function (s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); };
              var cards = recs.slice(0, 4).map(function (v, i) {
                var extra = i === 3 ? ' inline-recs-card-extra' : '';
