  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {

      // Rens grimme interne markdown-links fra Shorts-teksten
      document.querySelectorAll('.shorts-desktop-text, .shorts-mobile-text').forEach(el => {
        el.innerHTML = el.innerHTML.replace(/\[([^\]]+)\]\(\/video\/[^)]+\)/g, '$1');
        el.innerHTML = el.innerHTML.replace(/\(\/video\/[^)]+\)/g, ''); // Fanger resterende parenteser
      });

      const slug = document.getElementById('saveBtn')?.getAttribute('data-slug');
      if (slug) {
        const btn = document.getElementById('saveBtn');
        const vTitle = btn.getAttribute('data-title');
        const vImg = btn.getAttribute('data-img');
        let history = JSON.parse(localStorage.getItem('videoHistory') || '[]');
        history = history.filter(v => v.slug !== slug);
        history.unshift({ slug, title: vTitle, img: vImg });
        if (history.length > 50) history.pop();
        localStorage.setItem('videoHistory', JSON.stringify(history));
      }

      const nextShortBtn = document.getElementById('nextShortBtn');
      const prevShortBtn = document.getElementById('prevShortBtn');
      if (nextShortBtn && nextShortBtn.dataset.url) nextShortBtn.addEventListener('click', () => window.location.href = nextShortBtn.dataset.url);
      if (prevShortBtn && prevShortBtn.dataset.url) prevShortBtn.addEventListener('click', () => window.location.href = prevShortBtn.dataset.url);

      // Tastatur-navigation i Shorts: pil ned = næste, pil op = forrige, Escape = tilbage til oversigten
      if (nextShortBtn || prevShortBtn) {
        document.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowDown' && nextShortBtn && nextShortBtn.dataset.url) { e.preventDefault(); window.location.href = nextShortBtn.dataset.url; }
          else if (e.key === 'ArrowUp' && prevShortBtn && prevShortBtn.dataset.url) { e.preventDefault(); window.location.href = prevShortBtn.dataset.url; }
          else if (e.key === 'Escape') { window.location.href = '/shorts'; }
        });
      }

      // Mobil Shorts-tekst: vis kun et par linjer, fold hele teksten ud/ind ved tryk på teksten
      const shortsMobileInfo = document.querySelector('.shorts-mobile-info');
      if (shortsMobileInfo) {
        shortsMobileInfo.addEventListener('click', (e) => {
          if (e.target.closest('a')) return; // lad evt. links virke normalt
          shortsMobileInfo.classList.toggle('expanded');
        });
      }

      const saveBtn = document.getElementById('saveBtn');
      const saveText = document.getElementById('saveText');
      if (saveBtn && saveText && slug) {
        const title = saveBtn.getAttribute('data-title');
        const img = saveBtn.getAttribute('data-img');
        let watchLater = JSON.parse(localStorage.getItem('watchLater') || '[]');
        if (watchLater.some((v) => v.slug === slug)) {
          saveBtn.classList.add('btn-active'); saveText.innerHTML = 'Saved';
        }
        saveBtn.addEventListener('click', () => {
          watchLater = JSON.parse(localStorage.getItem('watchLater') || '[]');
          const index = watchLater.findIndex((v) => v.slug === slug);
          if (index === -1) {
            watchLater.push({ slug, title, img });
            saveBtn.classList.add('btn-active'); saveText.innerHTML = 'Saved';
          } else {
            watchLater.splice(index, 1);
            saveBtn.classList.remove('btn-active'); saveText.innerHTML = 'Save';
          }
          localStorage.setItem('watchLater', JSON.stringify(watchLater));
        });
      }

      const likeBtn = document.getElementById('likeBtn');
      const dislikeBtn = document.getElementById('dislikeBtn');
      if (likeBtn && dislikeBtn && slug) {
        // Rent lokal præference (localStorage). Vi viser ikke tal — der findes
        // ingen rigtige stemmetal, og opdigtede tal ville vildlede læseren.
        const updateLikesUI = () => {
          const state = localStorage.getItem(`interaction_${slug}`);
          likeBtn.classList.remove('btn-active');
          dislikeBtn.classList.remove('btn-active');
          if (state === 'liked') { likeBtn.classList.add('btn-active'); }
          else if (state === 'disliked') { dislikeBtn.classList.add('btn-active'); }
        };
        updateLikesUI();
        likeBtn.addEventListener('click', () => {
          const current = localStorage.getItem(`interaction_${slug}`);
          localStorage.setItem(`interaction_${slug}`, current === 'liked' ? 'none' : 'liked');
          updateLikesUI();
        });
        dislikeBtn.addEventListener('click', () => {
          const current = localStorage.getItem(`interaction_${slug}`);
          localStorage.setItem(`interaction_${slug}`, current === 'disliked' ? 'none' : 'disliked');
          updateLikesUI();
        });
      }

      const shareTriggers = document.querySelectorAll('.share-trigger');
      shareTriggers.forEach((btn) => {
        btn.addEventListener('click', async () => {
          if (navigator.share) {
            try { await navigator.share({ title: document.title, url: window.location.href }); }
            catch (err) { }
          } else {
            navigator.clipboard.writeText(window.location.href);
            const label = btn.querySelector('.share-text') || (btn.parentElement && btn.parentElement.querySelector('.share-text'));
            if (label) {
              const originalText = label.innerText;
              label.innerText = 'Copied!';
              setTimeout(() => label.innerText = originalText, 2000);
            }
          }
        });
      });

      // Sticky video: kun normale videoer på mobil, aktiveres når afspilning starter (ikke ved scroll)
      const stickyVideo = document.getElementById('stickyVideo');
      const cinemaCloseBtn = document.getElementById('cinemaCloseBtn');
      const cinemaBrowser = document.getElementById('cinemaBrowser');
      const cinemaChips = document.getElementById('cinemaChips');
      const cinemaList = document.getElementById('cinemaList');

      if (stickyVideo) {
        let ytPlayer = null;

        // Cinema-browser: video-liste under den sticky video (kun mobil, kun i cinema-mode)
        const currentSlug = cinemaBrowser ? cinemaBrowser.dataset.currentSlug : '';
        const currentTags = cinemaBrowser ? cinemaBrowser.dataset.currentTags.split(',').filter(Boolean) : [];
        let allVideos = [];
        let videosReady = false;
        let cinemaBrowserInitialized = false;

        const buildAdSlot = () => {
          const wrapper = document.createElement('div');
          wrapper.className = 'adsense-container cinema-ad';
          const label = document.createElement('span');
          label.className = 'ad-label';
          label.textContent = 'Annonce';
          const ins = document.createElement('ins');
          ins.className = 'adsbygoogle';
          ins.style.display = 'block';
          ins.setAttribute('data-ad-client', 'ca-pub-9695260339642032');
          ins.setAttribute('data-ad-slot', 'XXXXX');
          ins.setAttribute('data-ad-format', 'auto');
          ins.setAttribute('data-full-width-responsive', 'true');
          wrapper.appendChild(label);
          wrapper.appendChild(ins);
          setTimeout(() => {
            try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {}
          }, 0);
          return wrapper;
        };

        const renderCards = (list) => {
          if (!cinemaList) return;
          cinemaList.innerHTML = '';
          list.forEach((v, i) => {
            const card = document.createElement('a');
            card.href = `/video/${v.slug}`;
            card.className = 'cinema-card';

            const thumb = document.createElement('div');
            thumb.className = 'cinema-card-thumb';
            thumb.style.backgroundImage = `url('https://img.youtube.com/vi/${v.youtubeId}/hqdefault.jpg')`;

            const duration = document.createElement('span');
            duration.className = 'cinema-card-duration';
            duration.textContent = v.duration || (v.isShort ? 'Short' : '0:00');
            thumb.appendChild(duration);

            const titleEl = document.createElement('span');
            titleEl.className = 'cinema-card-title';
            titleEl.textContent = v.title;

            card.appendChild(thumb);
            card.appendChild(titleEl);
            cinemaList.appendChild(card);

            if ((i + 1) % 4 === 0) {
              cinemaList.appendChild(buildAdSlot());
            }
          });
        };

        const getForYouList = () => {
          const history = JSON.parse(localStorage.getItem('videoHistory') || '[]');
          if (history.length === 0) {
            return allVideos.filter(v => v.tags.some(t => currentTags.includes(t)));
          }
          const historySlugs = new Set(history.map(h => h.slug));
          const tagCounts = {};
          allVideos.forEach(v => {
            if (historySlugs.has(v.slug)) {
              v.tags.forEach(t => { tagCounts[t] = (tagCounts[t] || 0) + 1; });
            }
          });
          const topTags = Object.keys(tagCounts).sort((a, b) => tagCounts[b] - tagCounts[a]);
          if (topTags.length === 0) {
            return allVideos.filter(v => v.tags.some(t => currentTags.includes(t)));
          }
          return allVideos.filter(v => v.tags.some(t => topTags.includes(t)));
        };

        const renderList = (filter, tag) => {
          let list = [];
          if (filter === 'all') {
            list = allVideos.slice();
          } else if (filter === 'related') {
            list = allVideos.filter(v => v.tags.some(t => currentTags.includes(t)));
          } else if (filter === 'foryou') {
            list = getForYouList();
          } else if (filter === 'tag') {
            list = allVideos.filter(v => v.tags.includes(tag));
          }
          renderCards(list.filter(v => v.slug !== currentSlug));
        };

        const tryInitCinemaBrowser = () => {
          if (cinemaBrowserInitialized || !videosReady || !document.body.classList.contains('cinema-mode')) return;
          cinemaBrowserInitialized = true;
          renderList('all', null);
        };

        if (cinemaBrowser) {
          fetch('/videos.json')
            .then(res => res.json())
            .then(data => { allVideos = data; videosReady = true; tryInitCinemaBrowser(); })
            .catch(() => { allVideos = []; videosReady = true; tryInitCinemaBrowser(); });

          if (cinemaChips) {
            cinemaChips.addEventListener('click', (e) => {
              const btn = e.target.closest('.cinema-chip');
              if (!btn) return;
              cinemaChips.querySelectorAll('.cinema-chip').forEach(b => b.classList.remove('active'));
              btn.classList.add('active');

              if (btn.dataset.filter === 'article') {
                document.body.classList.add('cinema-reading');
                return;
              }
              document.body.classList.remove('cinema-reading');
              renderList(btn.dataset.filter, btn.dataset.tag);
            });
          }
        }

        const onPlayerStateChange = (event) => {
          if (event.data === YT.PlayerState.PLAYING && window.innerWidth <= 768 && !document.body.classList.contains('shorts-mode')) {
            document.body.classList.add('cinema-mode');
            tryInitCinemaBrowser();
          }
        };

        const createPlayer = () => {
          ytPlayer = new YT.Player('ytIframe', {
            events: { onStateChange: onPlayerStateChange }
          });
        };

        if (window.YT && window.YT.Player) {
          createPlayer();
        } else {
          const existingCallback = window.onYouTubeIframeAPIReady;
          window.onYouTubeIframeAPIReady = () => {
            if (existingCallback) existingCallback();
            createPlayer();
          };
          if (!document.querySelector('script[src="https://www.youtube.com/iframe_api"]')) {
            const apiScript = document.createElement('script');
            apiScript.src = 'https://www.youtube.com/iframe_api';
            document.head.appendChild(apiScript);
          }
        }

        if (cinemaCloseBtn) {
          cinemaCloseBtn.addEventListener('click', () => {
            document.body.classList.remove('cinema-mode', 'cinema-reading');
            if (ytPlayer && typeof ytPlayer.pauseVideo === 'function') {
              ytPlayer.pauseVideo();
            }
          });
        }
      }

      const shortsWrapper = document.getElementById('shortsWrapper');
      if (shortsWrapper) {
        let isNavigating = false;
        const nextUrl = shortsWrapper.dataset.next ? `/video/${shortsWrapper.dataset.next}` : null;
        const prevUrl = shortsWrapper.dataset.prev ? `/video/${shortsWrapper.dataset.prev}` : null;

        shortsWrapper.addEventListener('wheel', (e) => {
          if (isNavigating) return;

          if (e.target.closest('.shorts-desktop-info') || e.target.closest('.shorts-mobile-info')) return;

          if (e.deltaY > 25 && nextUrl) {
            isNavigating = true;
            window.location.href = nextUrl;
          } else if (e.deltaY < -25 && prevUrl) {
            isNavigating = true;
            window.location.href = prevUrl;
          }
        });

        // Mobil: skjul handlings-knapperne efter et par sek. afspilning (fade mod højre), vis igen de sidste 5 sek. eller ved tryk midt på skærmen
        if (window.matchMedia('(max-width: 768px)').matches) {
          const HIDE_DELAY = 3000;
          let hideTimer = null, watchTimer = null, ytShortsPlayer = null, nearEnd = false;
          // Lydløs-autoplay-workarounden gælder KUN iOS (iPhone/iPad). Android beholder lyd fra start.
          const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
          const isNearEnd = () => {
            if (!ytShortsPlayer || typeof ytShortsPlayer.getDuration !== 'function') return false;
            const d = ytShortsPlayer.getDuration();
            return d > 0 && (d - ytShortsPlayer.getCurrentTime()) <= 5;
          };
          const isPlaying = () => ytShortsPlayer && typeof ytShortsPlayer.getPlayerState === 'function' && ytShortsPlayer.getPlayerState() === 1;
          const hideControls = () => document.body.classList.add('shorts-controls-hidden');
          const showControls = () => {
            document.body.classList.remove('shorts-controls-hidden');
            clearTimeout(hideTimer);
            if (isPlaying() && !isNearEnd()) hideTimer = setTimeout(hideControls, HIDE_DELAY);
          };
          shortsWrapper.addEventListener('click', (e) => {
            if (e.target.closest('.shorts-actions-col') || e.target.closest('.shorts-mobile-info') || e.target.closest('.shorts-back-btn')) return;
            if (ytShortsPlayer) {
              if (typeof ytShortsPlayer.isMuted === 'function' && ytShortsPlayer.isMuted()) {
                // iOS: første tryk slår lyden til (uden at pause)
                ytShortsPlayer.unMute();
                if (typeof ytShortsPlayer.setVolume === 'function') ytShortsPlayer.setVolume(100);
                document.body.classList.remove('shorts-muted');
                if (typeof ytShortsPlayer.playVideo === 'function' && !isPlaying()) ytShortsPlayer.playVideo();
              } else if (isPlaying()) {
                // Tryk mens den spiller = pause
                ytShortsPlayer.pauseVideo();
              } else if (typeof ytShortsPlayer.playVideo === 'function') {
                // Tryk mens den er på pause = genoptag
                ytShortsPlayer.playVideo();
              }
            }
            showControls();
          });
          const progressFill = document.querySelector('.shorts-progress-fill');
          const updateProgress = () => {
            if (!ytShortsPlayer || typeof ytShortsPlayer.getDuration !== 'function' || !progressFill) return;
            const d = ytShortsPlayer.getDuration();
            const c = ytShortsPlayer.getCurrentTime();
            progressFill.style.width = (d > 0 ? Math.min(100, (c / d) * 100) : 0) + '%';
          };
          const startWatch = () => {
            clearInterval(watchTimer);
            watchTimer = setInterval(() => {
              updateProgress();
              const end = isNearEnd();
              if (end && !nearEnd) { nearEnd = true; document.body.classList.remove('shorts-controls-hidden'); clearTimeout(hideTimer); }
              else if (!end && nearEnd) { nearEnd = false; showControls(); }
            }, 250);
          };
          const initShortsPlayer = () => {
            ytShortsPlayer = new YT.Player('ytIframe', {
              events: {
                onReady: () => {
                  if (isIOS) {
                    // Kun iOS: start lydløst (Apple blokerer autoplay med lyd), tryk slår lyden til
                    try { ytShortsPlayer.mute(); ytShortsPlayer.playVideo(); } catch (err) {}
                    document.body.classList.add('shorts-muted');
                  }
                  showControls();
                  startWatch();
                },
                onStateChange: (ev) => {
                  document.body.classList.toggle('shorts-playing', ev.data === YT.PlayerState.PLAYING);
                  if (ev.data === YT.PlayerState.PLAYING) { showControls(); startWatch(); }
                }
              }
            });
          };
          if (window.YT && window.YT.Player) initShortsPlayer();
          else {
            const existing = window.onYouTubeIframeAPIReady;
            window.onYouTubeIframeAPIReady = () => { if (existing) existing(); initShortsPlayer(); };
            if (!document.querySelector('script[src="https://www.youtube.com/iframe_api"]')) {
              const s = document.createElement('script'); s.src = 'https://www.youtube.com/iframe_api'; document.head.appendChild(s);
            }
          }
        }

        // Desktop: 'You might also like'-rail der roterer 5 nye artikler ind hver 8. sekund (blød fade)
        if (window.matchMedia('(min-width: 1025px)').matches) {
          const recEl = document.getElementById('shortsRecommends');
          const list = document.getElementById('shortsRecList');
          if (recEl && list) {
            let pool = [];
            try { pool = JSON.parse(recEl.dataset.pool || '[]'); } catch (e) {}
            const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            const PER = 5;
            let idx = 0;
            const render = () => {
              let html = '';
              for (let i = 0; i < Math.min(PER, pool.length); i++) {
                const v = pool[(idx + i) % pool.length];
                html += `<a href="/video/${v.slug}" class="shorts-rec-card"><div class="shorts-rec-thumb"><img src="https://img.youtube.com/vi/${v.youtubeId}/mqdefault.jpg" alt="" loading="lazy"></div><span class="shorts-rec-title">${esc(v.title)}</span></a>`;
              }
              list.innerHTML = html;
            };
            if (pool.length) {
              render();
              if (pool.length > PER) {
                setInterval(() => {
                  list.style.opacity = '0';
                  setTimeout(() => { idx = (idx + PER) % pool.length; render(); list.style.opacity = '1'; }, 900);
                }, 15000);
              }
            }
          }
        }
      }
    });
  </script>
</MainLayout>
