---
import MainLayout from '../layouts/MainLayout.astro';

const allVideos = Object.values(import.meta.glob('../content/videos/*.md', { eager: true })) as any[];

const formatDate = (d: string) => {
  const parsed = new Date(d);
  return isNaN(parsed.getTime()) ? d : parsed.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
};
const formatViews = (n: number) =>
  n >= 1_000_000 ? (n / 1_000_000).toFixed(n >= 10_000_000 ? 0 : 1) + 'M'
  : n >= 1_000 ? (n / 1_000).toFixed(n >= 10_000 ? 0 : 1) + 'K'
  : String(n);

// Rangeret efter kildevideoens visninger på YouTube. Artikler uden tal falder
// ud af listen frem for at blive gættet til nul — et gæt er det vi kom fra.
const ranked = allVideos
  .filter((v) => !v.frontmatter.isShort && Number.isFinite(Number(v.frontmatter.viewCount)))
  .map((v) => ({
    slug: v.file.split('/').pop().replace('.md', ''),
    fm: v.frontmatter,
    views: Number(v.frontmatter.viewCount),
  }))
  .sort((a, b) => b.views - a.views)
  .slice(0, 48);

// Ældste opdateringsdato i udvalget — så datoen på siden ikke lover mere end den holder
const oldestUpdate = ranked
  .map((r) => r.fm.viewsUpdated)
  .filter(Boolean)
  .sort()[0];

const withoutCount = allVideos.filter((v) => !v.frontmatter.isShort && !Number.isFinite(Number(v.frontmatter.viewCount))).length;

const title = "Most-Watched Source Videos — Tech Feed Watch";
const description = "The articles on this site are written from other people's YouTube videos. These are the ones whose source video has been watched most on YouTube.";
---

<MainLayout title={title} description={description}>
  <style is:global>
    .popular-wrapper { padding: 30px 20px; max-width: 1400px; margin: 0 auto; flex: 1; width: 100%; box-sizing: border-box; }
    .popular-header { font-size: 2.2rem; margin: 0 0 8px 0; }
    .popular-sub { color: #6b7280; font-size: 1.05rem; margin: 0 0 10px 0; max-width: 760px; line-height: 1.6; }
    body.dark-mode .popular-sub { color: #9ca3af; }
    .popular-note { color: #6b7280; font-size: 0.88rem; margin: 0 0 30px 0; max-width: 760px; line-height: 1.6; }
    body.dark-mode .popular-note { color: #9ca3af; }

    .popular-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
    .watch-card { text-decoration: none; color: inherit; display: block; transition: transform 0.2s; }
    .watch-card:hover { transform: translateY(-3px); }
    .watch-card-thumb { aspect-ratio: 16/9; border-radius: 12px; margin-bottom: 10px; position: relative; overflow: hidden; }
    .duration-badge { position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.8); color: white; padding: 2px 6px; border-radius: 4px; font-size: 12px; font-weight: 600; letter-spacing: 0.5px; }
    .rank-badge { position: absolute; top: 8px; left: 8px; background: rgba(8, 145, 178,0.95); color: #fff; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 800; box-shadow: 0 2px 8px rgba(0,0,0,0.3); }
    .tma-grid-title { margin: 0 0 5px 0; font-size: 15px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .watch-card:hover .tma-grid-title { color: #0891b2; }
    .tma-grid-meta { font-size: 13px; color: #6b7280; margin: 0; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    body.dark-mode .tma-grid-meta { color: #9ca3af; }
    .pop-views { font-weight: 700; color: #0891b2; }
    .pop-channel { display: block; font-size: 12.5px; color: #6b7280; margin-top: 3px; }
    body.dark-mode .pop-channel { color: #9ca3af; }

    @media (max-width: 768px) {
      .popular-wrapper { padding: 15px; }
      .popular-header { font-size: 1.8rem; }
      .popular-grid { grid-template-columns: 1fr; gap: 20px; }
      .watch-card-thumb { border-radius: 8px; }
    }
  </style>

  <div class="popular-wrapper">
    <h1 class="popular-header">Most-watched source videos</h1>
    <p class="popular-sub">
      Every article here is written from someone else's YouTube video. This page ranks those
      articles by how many times the original video has been watched on YouTube — so the big
      channels sit at the top, and a small channel with a sharp video will not.
    </p>
    <p class="popular-note">
      View counts come from YouTube{oldestUpdate ? `, last refreshed ${formatDate(oldestUpdate)}` : ''}.
      They measure the video, not the article — we do not publish our own traffic figures.
      {withoutCount > 0 && ` ${withoutCount} articles are not listed because we have no view count for their source.`}
    </p>

    <div class="popular-grid">
      {ranked.map((item, i) => (
        <a href={`/video/${item.slug}`} class="watch-card">
          <div class="watch-card-thumb">
            <img src={`https://img.youtube.com/vi/${item.fm.youtubeId}/hqdefault.jpg`} alt={item.fm.title} loading="lazy" />
            <div class="rank-badge">{i + 1}</div>
            <div class="duration-badge">{item.fm.duration || '0:00'}</div>
            <span class="watch-card-play" aria-hidden="true">▶</span>
          </div>
          <div>
            <h2 class="tma-grid-title">{item.fm.title}</h2>
            <p class="tma-grid-meta">
              <span class="pop-views">{formatViews(item.views)} views on YouTube</span>
              <span>• {formatDate(item.fm.date)}</span>
            </p>
            {item.fm.channelTitle && <span class="pop-channel">Source: {item.fm.channelTitle}</span>}
          </div>
        </a>
      ))}
    </div>
  </div>
</MainLayout>
