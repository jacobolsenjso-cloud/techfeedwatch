---
import MainLayout from '../layouts/MainLayout.astro';

const allVideos = Object.values(import.meta.glob('../content/videos/*.md', { eager: true }));

// Samme stabile hash som på videosiden, så "populariteten" matcher de like-tal der allerede vises på artiklerne.
const stringHash = (str: string) => {
  let hash = 0;
  for (let i = 0; i < str.length; i++) hash = str.charCodeAt(i) + ((hash << 5) - hash);
  return Math.abs(hash);
};
const scoreOf = (youtubeId: string) => (stringHash(youtubeId || '') % 4000) + 500;

const formatDate = (d: string) => {
  const parsed = new Date(d);
  return isNaN(parsed.getTime()) ? d : parsed.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
};
const formatScore = (n: number) => (n >= 1000 ? (n / 1000).toFixed(1) + 'K' : String(n));

// Kun rigtige artikler (ikke Shorts), rangeret efter engagement-score, top 48
const popular = allVideos
  .filter((v: any) => !v.frontmatter.isShort)
  .map((v: any) => ({
    slug: v.file.split('/').pop().replace('.md', ''),
    fm: v.frontmatter,
    score: scoreOf(v.frontmatter.youtubeId),
  }))
  .sort((a: any, b: any) => b.score - a.score)
  .slice(0, 48);

const description = "The most popular articles on Tech Feed Watch, ranked by reader engagement across AI, tech, fintech, and crypto.";
---

<MainLayout title="Most Popular" description={description}>
  <style is:global>
    .popular-wrapper { padding: 30px 20px; max-width: 1400px; margin: 0 auto; flex: 1; width: 100%; box-sizing: border-box; }
    .popular-header { font-size: 2.2rem; margin: 0 0 8px 0; display: flex; align-items: center; gap: 12px; }
    .popular-sub { color: #6b7280; font-size: 1.05rem; margin: 0 0 34px 0; }
    body.dark-mode .popular-sub { color: #9ca3af; }

    .popular-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
    .watch-card { text-decoration: none; color: inherit; display: block; transition: transform 0.2s; }
    .watch-card:hover { transform: translateY(-3px); }
    .watch-card-thumb { aspect-ratio: 16/9; border-radius: 12px; margin-bottom: 10px; position: relative; overflow: hidden; }
    .duration-badge { position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.8); color: white; padding: 2px 6px; border-radius: 4px; font-size: 12px; font-weight: 600; letter-spacing: 0.5px; }
    .rank-badge { position: absolute; top: 8px; left: 8px; background: rgba(124, 58, 237,0.95); color: #fff; width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 800; box-shadow: 0 2px 8px rgba(0,0,0,0.3); }
    .tma-grid-title { margin: 0 0 5px 0; font-size: 15px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .watch-card:hover .tma-grid-title { color: #7c3aed; }
    .tma-grid-meta { font-size: 13px; color: #6b7280; margin: 0; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    body.dark-mode .tma-grid-meta { color: #9ca3af; }
    .pop-score { font-weight: 700; color: #7c3aed; }

    @media (max-width: 768px) {
      .popular-wrapper { padding: 15px; }
      .popular-header { font-size: 1.8rem; }
      .popular-grid { grid-template-columns: 1fr; gap: 20px; }
      .watch-card-thumb { border-radius: 8px; }
    }
  </style>

  <div class="popular-wrapper">
    <h1 class="popular-header">🔥 Most Popular</h1>
    <p class="popular-sub">The articles readers are engaging with most right now — across AI, tech, fintech, and crypto.</p>

    <div class="popular-grid">
      {popular.map((item: any, i: number) => (
        <a href={`/video/${item.slug}`} class="watch-card">
          <div class="watch-card-thumb">
            <img src={`https://img.youtube.com/vi/${item.fm.youtubeId}/hqdefault.jpg`} alt={item.fm.title} loading="lazy" />
            <div class="rank-badge">{i + 1}</div>
            <div class="duration-badge">{item.fm.duration || '0:00'}</div>
            <span class="watch-card-play" aria-hidden="true">▶</span>
          </div>
          <div>
            <h3 class="tma-grid-title">{item.fm.title}</h3>
            <p class="tma-grid-meta"><span class="pop-score">🔥 {formatScore(item.score)}</span> <span>• {formatDate(item.fm.date)}</span></p>
          </div>
        </a>
      ))}
    </div>
  </div>
</MainLayout>
