{
  "id": "/",
  "name": "Tech Feed Watch",
  "short_name": "TechFeedWatch",
  "description": "The best AI, tech, fintech, and crypto videos turned into fast, readable analysis.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#f8fafc",
  "theme_color": "#0891b2",
  "categories": ["news", "technology", "business"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Latest articles",
      "short_name": "Latest",
      "url": "/latest",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Browse the library",
      "short_name": "Library",
      "url": "/library",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Free tools",
      "short_name": "Tools",
      "url": "/tools",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
