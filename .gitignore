# build output
dist/

# hentede transskripter (src/lib/transskript.mjs). Må ikke i git — de er
# andres indhold og fylder. I GitHub Actions bæres de af actions/cache.
.cache/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
build.err
preview.err
preview.out

# skærmbilleder fra shot.mjs, inkl. Chromes midlertidige profil
_shots/

# resultatfiler fra audit-scripterne. De skrives ved hver kørsel og læses aldrig
# af noget, så i git giver de kun støj i hver eneste diff.
audit-*.json


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Arbejdsfiler fra bunke-koersler og status-scripts
_*.txt
_*.out
_*.err
_*.json
_*.ps1
# Tilføjet 20/9-2026: engangs-scripts fra arbejdssessioner (test-, tjek- og
# rettescripts). De hører ikke i repoet, men lå og rodede i `git status`.
# Rammer kun filer der BEGYNDER med _ — sitets egne scripts (sort-redirects.mjs,
# og-card.mjs osv.) og de sporede public/_headers og public/_redirects er uberørt.
_*.mjs
_*.py

